{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "../dist-package",
    "rootDir": ".",
    "skipLibCheck": true
  },
  "include": ["*.tsx", "*.d.mts", "generated/*.ts"]
}
