---
// The API of a CSS component: its classes, modifiers and attributes.
interface Props { rows: [string, string][]; head?: [string, string]; }
const { rows, head = ['Class / attribute', 'What it does'] } = Astro.props;
// Long class names may only wrap before a BEM joint (__ or --), a space or a dot, never mid-word.
const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const breakable = (t: string) => esc(t).replace(/(__|--|\s|(?<=\w)\.)/g, '<wbr>$1');
---
<div class="doc-table-wrap">
  <table class="doc-table">
    <thead><tr><th>{head[0]}</th><th>{head[1]}</th></tr></thead>
    <tbody>{rows.map(([k, v]) => <tr><td><code set:html={breakable(k)} /></td><td set:html={v} /></tr>)}</tbody>
  </table>
</div>
