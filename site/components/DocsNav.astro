---
// The docs' main navigation, built on the system's own side nav: an icon rail with one item per section and a panel
// with that section's pages. Sections come from site/nav/*.mjs (one file per group); the layout maps them to the rail.
// Every pane has the same anatomy: its title and page count, then each group under a micro-caps label, then the pages.
// The search sits at the head of the panel and, while a query is typed, searches every section at once.
import { i } from '../lib/icon';

export interface NavItem { title: string; href: string; tag?: string | number; group?: string }
export interface NavGroup { group: string; order: number; items: NavItem[]; keywords?: string }
export interface RailSection { key: string; label: string; icon: string; title: string; groups: NavGroup[] }

interface Props { sections: RailSection[]; active: string; base: string; here: string }
const { sections, active, base, here } = Astro.props;

const hrefOf = (it: NavItem) => `${base}/${it.href}`.replace(/\/$/, '');
// Other names people search for, so "modal" finds Dialog and "dropdown" finds Menu and Select.
const aka: Record<string, string> = {
  dialog: 'modal popup confirm', drawer: 'panel slide-over side panel', sheet: 'bottom sheet action sheet', menu: 'dropdown context menu actions',
  select: 'dropdown picker listbox', combobox: 'autocomplete typeahead multiselect tags', 'segmented-control': 'toggle group tabs switcher',
  switch: 'toggle', checkbox: 'tick', toast: 'snackbar notification', alert: 'notice message warning error', banner: 'announcement notice',
  tooltip: 'hint title', popover: 'popup flyout', badge: 'tag label pill count', chip: 'tag filter pill token', avatar: 'user profile initials',
  'status-dot': 'indicator health', 'empty-state': 'blank zero no data', skeleton: 'placeholder shimmer loading', spinner: 'loading progress busy',
  loader: 'loading ampersand brand spinner', 'guide-cue': 'tour onboarding coachmark walkthrough', 'side-nav': 'sidebar navigation rail menu',
  'top-bar': 'header navbar app bar', tabs: 'tablist', breadcrumbs: 'path trail', stepper: 'steps wizard progress', 'app-shell': 'layout frame scaffold',
  'page-header': 'title heading', card: 'tile panel', accordion: 'collapse expand details disclosure faq', divider: 'separator rule hr',
  table: 'grid list rows', 'data-table': 'grid datagrid sort filter rows', pagination: 'pager pages', stat: 'kpi metric number figure',
  chart: 'graph plot sparkline visualization', progress: 'meter bar steps', 'description-list': 'key value details dl properties',
  code: 'snippet terminal shell pre syntax', 'json-viewer': 'tree object inspector', 'log-viewer': 'logs console stream tail', timeline: 'activity feed history audit',
  'text-input': 'textfield field search password number', textarea: 'multiline comment', 'form-field': 'label help error validation',
  'date-picker': 'calendar date range', 'file-upload': 'dropzone attach upload drag', 'form-layout': 'form sections settings', slider: 'range',
  'command-palette': 'cmdk search spotlight quick open', kbd: 'keyboard shortcut key', link: 'anchor href', 'button-group': 'split toolbar',
  colors: 'colours palette tokens theme', typography: 'fonts type scale headings', icons: 'svg sprite', motion: 'animation easing duration',
};
const pages = (s: RailSection) => s.groups.reduce((n, g) => n + g.items.length, 0);
---
<nav class="dd-side-nav doc-nav" id="doc-nav" aria-label="Documentation">
  <div class="dd-side-nav__rail">
    <a class="dd-side-nav__logo dd-logo-tile" href={`${base}/`} aria-label="dawn &amp; dusk — home">d&amp;</a>
    {sections.map((s) => (
      <button class:list={['dd-side-nav__item', { 'is-active': s.key === active }]} type="button" aria-current={s.key === active ? 'true' : undefined}
        data-dd-nav-section={s.key} data-label={s.label} aria-label={s.label}><Fragment set:html={i(s.icon)} /></button>
    ))}
    <span class="dd-side-nav__spacer"></span>
    <span class="dd-side-nav__sep"></span>
    <button class="dd-side-nav__item dd-side-nav__collapse" type="button" data-dd-nav-toggle aria-controls="doc-nav-panel" aria-expanded="true"
      aria-label="Collapse navigation" data-label="Collapse"><Fragment set:html={i('chevron-left')} /></button>
  </div>
  <div class="dd-side-nav__panel doc-nav-panel" id="doc-nav-panel">
    <div class="doc-find" role="search">
      <div class="dd-input dd-input--sm">
        <span class="dd-input__affix"><Fragment set:html={i('search')} /></span>
        <input class="dd-input__control" id="doc-find" type="search" placeholder="Find a page…" aria-label="Find in the docs" aria-controls="doc-nav-list" autocomplete="off" spellcheck="false" />
        <span class="dd-input__affix doc-find-key" aria-hidden="true"><kbd class="dd-kbd">/</kbd></span>
      </div>
      <p class="doc-find-status" id="doc-find-status" role="status" aria-live="polite"></p>
    </div>
    <div class="doc-nav-list dd-scroll" id="doc-nav-list">
      {sections.map((s) => (
        <div class="dd-side-nav__pane" data-dd-nav-pane={s.key} hidden={s.key !== active}>
          <div class="dd-side-nav__head"><span class="dd-side-nav__title">{s.title}</span><span class="dd-side-nav__count" data-total={pages(s)}>{pages(s)}</span></div>
          {s.groups.map((g) => (
            <div class="doc-nav-group">
              <p class="dd-side-nav__section">{g.group}</p>
              {g.items.map((it) => {
                const href = hrefOf(it);
                const tag = it.tag == null ? null : String(it.tag);
                return (
                  <a class="dd-side-nav__link" href={href} aria-current={href === here ? 'page' : undefined}
                    data-find={`${it.title} ${g.keywords ?? g.group} ${aka[it.href.split('/').pop() ?? ''] ?? ''}`.toLowerCase()}>
                    <span class="dd-side-nav__label">{it.title}</span>
                    {tag && (/^\d+$/.test(tag) ? <span class="dd-side-nav__count">{tag}</span> : <span class="dd-side-nav__badge dd-side-nav__badge--new">{tag}</span>)}
                  </a>
                );
              })}
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>
</nav>
