---
import Docs from '../../layouts/Docs.astro';
import Example from '../../components/Example.astro';
import ClassTable from '../../components/ClassTable.astro';
import Guides from '../../components/Guides.astro';
import { i } from '../../lib/icon';

const basic = `
<article class="dd-card" style="max-width: 360px">
  <div class="dd-card__body">
    <p class="dd-card__eyebrow"><span>Case study</span><span>·</span><span class="dd-mono">dawn-and-dusk</span></p>
    <h3 class="dd-card__title">Two moods, one system</h3>
    <p class="dd-card__text">Tokens, components and an agent skill that switch between dawn and dusk without a single hard-coded colour.</p>
    <div class="dd-card__foot">
      <span class="dd-card__meta">6 min read</span>
      <a class="dd-card__link" href="#">Read ${i('arrow-right')}</a>
    </div>
  </div>
</article>`;

const interactive = `
<div class="dd-card-grid">
  <a class="dd-card dd-card--link" href="#">
    <div class="dd-card__body">
      <p class="dd-card__eyebrow">${i('code')}<span>Open source</span></p>
      <h3 class="dd-card__title">dockey-ui</h3>
      <p class="dd-card__text">A native companion for the local Docker engine — containers, logs and volumes at a glance.</p>
      <div class="dd-card__foot"><span class="dd-card__meta">Swift · macOS</span><span class="dd-card__link">Open ${i('arrow-right')}</span></div>
    </div>
  </a>
  <a class="dd-card dd-card--link is-hover" href="#">
    <div class="dd-card__body">
      <p class="dd-card__eyebrow">${i('bolt')}<span>Hover state</span></p>
      <h3 class="dd-card__title">insomnia</h3>
      <p class="dd-card__text">A sleep journal that reads like a ship’s log. Shown here with its hover state forced on.</p>
      <div class="dd-card__foot"><span class="dd-card__meta">TypeScript · web</span><span class="dd-card__link">Open ${i('arrow-right')}</span></div>
    </div>
  </a>
  <article class="dd-card dd-card--link">
    <div class="dd-card__body">
      <p class="dd-card__eyebrow">${i('sparkle')}<span>Stretched link</span></p>
      <h3 class="dd-card__title"><a class="dd-card__stretch" href="#">ai-focus</a></h3>
      <p class="dd-card__text">Todos, notes and standups that an agent can read and write. The title link covers the whole card.</p>
      <div class="dd-card__foot"><span class="dd-card__meta">Updated 2h ago</span><span class="dd-card__link">Open ${i('arrow-right')}</span></div>
    </div>
  </article>
</div>`;

const media = `
<div class="dd-card-grid" style="max-width: 600px">
  <article class="dd-card dd-card--link">
    <div class="dd-card__media" role="img" aria-label="Tonal cover"></div>
    <div class="dd-card__body">
      <p class="dd-card__eyebrow"><span>Photo essay</span></p>
      <h3 class="dd-card__title"><a class="dd-card__stretch" href="#">Blue hour, Hanoi</a></h3>
      <p class="dd-card__text">Twelve frames between dusk and dark.</p>
      <div class="dd-card__foot"><span class="dd-card__meta">12 photos</span><span class="dd-card__link">View ${i('arrow-right')}</span></div>
    </div>
  </article>
  <article class="dd-card dd-card--link dd-card--inset-media">
    <div class="dd-card__media dd-card__media--warm" role="img" aria-label="Warm cover"></div>
    <div class="dd-card__body">
      <p class="dd-card__eyebrow"><span>Release</span><span class="dd-mono">v0.1</span></p>
      <h3 class="dd-card__title"><a class="dd-card__stretch" href="#">dawn &amp; dusk ships</a></h3>
      <p class="dd-card__text">The first public cut: tokens, forty components and the docs you are reading.</p>
      <div class="dd-card__foot"><span class="dd-card__meta">Oct 30</span><span class="dd-card__link">Changelog ${i('arrow-right')}</span></div>
    </div>
  </article>
</div>`;

const stat = `
<div class="dd-card-grid">
  <article class="dd-card dd-card--stat">
    <div class="dd-card__body">
      <p class="dd-card__eyebrow">${i('server')}<span>Deploys · 30 days</span></p>
      <p class="dd-card__stat dd-num">1,284</p>
      <p class="dd-card__label">across 6 services</p>
      <div class="dd-card__foot"><span class="dd-card__delta is-up">${i('arrow-up')}+12.4%</span><span class="dd-card__meta">vs. September</span></div>
    </div>
  </article>
  <article class="dd-card dd-card--stat">
    <div class="dd-card__body">
      <p class="dd-card__eyebrow">${i('clock')}<span>p95 latency · auth-gateway</span></p>
      <p class="dd-card__stat dd-num">182<small>ms</small></p>
      <p class="dd-card__label">eu-west-1, last hour</p>
      <div class="dd-card__foot"><span class="dd-card__delta is-down">${i('arrow-up')}+38ms</span><span class="dd-card__meta">above budget</span></div>
    </div>
  </article>
  <article class="dd-card dd-card--stat">
    <div class="dd-card__body">
      <p class="dd-card__eyebrow">${i('database')}<span>Cache hit rate · edge-cache</span></p>
      <p class="dd-card__stat dd-num">97.2<small>%</small></p>
      <p class="dd-card__label">4.1M requests today</p>
      <div class="dd-card__foot"><span class="dd-card__delta">${i('minus')}0.0%</span><span class="dd-card__meta">steady</span></div>
    </div>
  </article>
</div>`;

const row = `
<div class="dd-stack" style="max-width: 560px">
  <article class="dd-card dd-card--row dd-card--link">
    <div class="dd-card__media" role="img" aria-label="Tonal cover"></div>
    <div class="dd-card__body">
      <p class="dd-card__eyebrow"><span>Note</span><span>·</span><span>3 min</span></p>
      <h3 class="dd-card__title"><a class="dd-card__stretch" href="#">On quiet software</a></h3>
      <p class="dd-card__text">Why the best tools disappear into the work — and what that means for a design system that wants to be noticed only when it helps.</p>
    </div>
  </article>
  <article class="dd-card dd-card--row dd-card--inset-media">
    <div class="dd-card__media dd-card__media--warm" role="img" aria-label="Warm cover"></div>
    <div class="dd-card__body">
      <p class="dd-card__eyebrow"><span class="dd-mono">leetnode</span></p>
      <h3 class="dd-card__title">Graph drills, daily</h3>
      <p class="dd-card__text">One problem a morning, spaced out by how badly you fumbled it last time.</p>
      <div class="dd-card__foot"><span class="dd-card__meta">142 solved</span><a class="dd-card__link" href="#">Practice ${i('arrow-right')}</a></div>
    </div>
  </article>
</div>`;

const compact = `
<div class="dd-card-grid">
  <a class="dd-card dd-card--compact dd-card--link" href="#">
    <div class="dd-card__body">
      <p class="dd-card__eyebrow">${i('server')}<span class="dd-mono">auth-gateway</span></p>
      <h3 class="dd-card__title">Rotate signing keys</h3>
      <div class="dd-card__foot"><span class="dd-card__meta">Runbook · 4 steps</span></div>
    </div>
  </a>
  <a class="dd-card dd-card--compact dd-card--link" href="#">
    <div class="dd-card__body">
      <p class="dd-card__eyebrow">${i('server')}<span class="dd-mono">billing-worker</span></p>
      <h3 class="dd-card__title">Replay failed invoices</h3>
      <div class="dd-card__foot"><span class="dd-card__meta">Runbook · 6 steps</span></div>
    </div>
  </a>
  <a class="dd-card dd-card--compact dd-card--link" href="#">
    <div class="dd-card__body">
      <p class="dd-card__eyebrow">${i('globe')}<span class="dd-mono">edge-cache</span></p>
      <h3 class="dd-card__title">Purge a region</h3>
      <div class="dd-card__foot"><span class="dd-card__meta">Runbook · 2 steps</span></div>
    </div>
  </a>
</div>`;

const project = (name, kind, text, meta, icon) => `
  <a class="dd-card dd-card--link" href="#">
    <div class="dd-card__body">
      <p class="dd-card__eyebrow">${i(icon)}<span>${kind}</span></p>
      <h3 class="dd-card__title">${name}</h3>
      <p class="dd-card__text">${text}</p>
      <div class="dd-card__foot"><span class="dd-card__meta">${meta}</span><span class="dd-card__link">Open ${i('arrow-right')}</span></div>
    </div>
  </a>`;
const grid = `
<div class="dd-card-grid">${[
  project('dawn-and-dusk', 'Design system', 'Tokens, components and docs for every cxkw.dev surface.', '24 versions', 'layers'),
  project('dockey-ui', 'macOS app', 'The local Docker engine, without the terminal.', 'Swift', 'box'),
  project('insomnia', 'Web app', 'A sleep journal with charts that stay out of the way.', 'TypeScript', 'moon'),
  project('ai-focus', 'Agent tools', 'Todos and notes an agent can read and write over MCP.', 'Python', 'sparkle'),
  project('leetnode', 'Practice', 'Spaced-repetition drills for graph problems.', 'Go', 'graph'),
].join('')}
</div>`;
---
<Docs title="Card" group="Layout" lead="A container for one thing — a project, a service, a stat. Cards lift off the page by tone alone: no border, no shadow. Interactive cards lift a tone toward ink on hover.">
  <Example title="Default" description="Eyebrow, lockup title, a line of text and a footer with meta and a link. On a static card only the link reacts: it underlines and its arrow nudges." code={basic} />

  <h2 id="interactive">Interactive</h2>
  <p>When the whole card goes somewhere, make the card the link: an <code>&lt;a class="dd-card dd-card--link"&gt;</code>, or keep the card an <code>&lt;article&gt;</code> and give its title a <code>.dd-card__stretch</code> link that covers the card. Hover lifts the card toward ink and nudges the arrow; keyboard focus draws the ring. On dusk’s grain page, which reads lighter than the cards, the lift is larger, so a hovered card always stands clear of the page.</p>
  <Example code={interactive} />

  <h2 id="media">With media</h2>
  <p>A tonal cover (or an <code>&lt;img class="dd-card__media"&gt;</code>) sits on top. <code>--inset-media</code> pulls it in with its own rounded corners.</p>
  <Example code={media} />

  <h2 id="stat">Stat</h2>
  <p>A display figure, its label and a delta. Units go in a <code>&lt;small&gt;</code>; deltas say which way is good with <code>is-up</code> / <code>is-down</code>.</p>
  <Example code={stat} />

  <h2 id="horizontal">Horizontal</h2>
  <p>Media beside the body for lists of notes and links. It stacks by itself once the card is narrower than about 300px.</p>
  <Example code={row} />

  <h2 id="compact">Compact</h2>
  <p>Less padding, a smaller title, no body text — for runbooks, shortcuts and dense grids.</p>
  <Example code={compact} />

  <h2 id="grid">Card grid</h2>
  <p><code>.dd-card-grid</code> fills the row with cards at least 220px wide and collapses to one column on phones. Cards in a row share a height.</p>
  <Example code={grid} />

  <h2 id="api">Classes</h2>
  <ClassTable rows={[
    ['.dd-card', 'The container: <code>--dd-surface</code> on the page, <code>--dd-r-box</code> corners, no border or shadow.'],
    ['.dd-card__body', 'Padded column holding the content.'],
    ['.dd-card__eyebrow', 'Small muted line above the title; takes an icon.'],
    ['.dd-card__title', 'Lockup heading (lowercase, 800).'],
    ['.dd-card__text', 'Muted body copy.'],
    ['.dd-card__foot', 'Bottom row, pushed to the end: <code>.dd-card__meta</code> and <code>.dd-card__link</code> (as an <code>&lt;a&gt;</code> it underlines on hover; its arrow nudges with the card or the link).'],
    ['.dd-card__media', 'Cover panel or image. <code>.dd-card__media--warm</code> for the Golden hour gradient.'],
    ['.dd-card--link', 'Interactive card: lifts toward ink on hover and focus (<code>--dd-card-hover</code>).'],
    ['--dd-card-hover', 'The hover tone: 6% toward ink in dawn, 14% on dusk’s grain page. <code>.dd-app-shell</code> (a plain page, no grain) uses 6% in both. Set it yourself if cards sit on another surface.'],
    ['.dd-card__stretch', 'A link whose hit area covers the whole card.'],
    ['.dd-card--inset-media', 'Media inset with its own corners.'],
    ['.dd-card--stat', 'With <code>.dd-card__stat</code>, <code>.dd-card__label</code>, <code>.dd-card__delta</code> (<code>is-up</code> / <code>is-down</code>).'],
    ['.dd-card--row', 'Media beside the body; wraps to stacked when narrow.'],
    ['.dd-card--compact', 'Tighter padding, smaller title, hides body text.'],
    ['.dd-card-grid', 'Responsive auto-fill grid of cards (min 220px).'],
  ]} />

  <h2 id="guidelines">Guidelines</h2>
  <Guides
    do={['Let tone do the lifting: a card on <code>--dd-bg</code>, nothing else.', 'Make the whole card one link when it goes one place; use <code>.dd-card__stretch</code> to keep the title as the accessible name.', 'Put numbers in stat cards in tabular figures and say what “good” looks like with the delta colour.']}
    dont={['Don’t add borders or drop shadows to cards.', 'Don’t nest cards inside cards — use a divider or an inset <code>--dd-surface-2</code> block.', 'Don’t put two competing links in an interactive card.']}
  />
</Docs>
