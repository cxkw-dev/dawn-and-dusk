---
import Docs from '../../layouts/Docs.astro';
import Example from '../../components/Example.astro';
import ClassTable from '../../components/ClassTable.astro';
import Guides from '../../components/Guides.astro';
import { i } from '../../lib/icon';

const userMenu = (open = false) => `
    <details class="dd-top-bar__user" data-dd-autoclose${open ? ' open' : ''}>
      <summary aria-label="Account menu"><span class="dd-top-bar__avatar">cx</span></summary>
      <div class="dd-top-bar__menu">
        <div class="dd-top-bar__menu-head"><b>cxkw</b><span>hello@cxkw.dev</span></div>
        <div class="dd-top-bar__menu-sep"></div>
        <a class="dd-top-bar__menu-item" href="#">${i('user')}Profile</a>
        <a class="dd-top-bar__menu-item" href="#">${i('settings')}Settings<span class="dd-top-bar__kbd">⌘,</span></a>
        <button class="dd-top-bar__menu-item" type="button" data-dd-theme-toggle>${i('moon')}Toggle dusk</button>
        <a class="dd-top-bar__menu-item" href="#">${i('key')}Access tokens</a>
        <div class="dd-top-bar__menu-sep"></div>
        <a class="dd-top-bar__menu-item" href="#">${i('logout')}Sign out</a>
      </div>
    </details>`;

const bar = (o: { open?: boolean } = {}) => `
<header class="dd-top-bar">
  <button class="dd-btn dd-btn--ghost dd-btn--icon dd-top-bar__nav-btn" type="button" aria-label="Open navigation">${i('menu')}</button>
  <a class="dd-top-bar__brand" href="#"><span class="dd-logo">dawn &amp; dusk</span></a>
  <div class="dd-top-bar__context">
    <span class="dd-top-bar__sep"></span>
    <button class="dd-top-bar__switch dd-top-bar__wide" type="button"><span class="dd-top-bar__mark">cx</span><span>cxkw</span></button>
    <span class="dd-faint dd-top-bar__wide">/</span>
    <button class="dd-top-bar__switch" type="button"><span>auth-gateway</span>${i('sort')}</button>
  </div>
  <button class="dd-top-bar__search" type="button" aria-label="Search">${i('search')}<span>Search…</span><kbd class="dd-top-bar__kbd">⌘K</kbd></button>
  <div class="dd-top-bar__actions">
    <a class="dd-btn dd-btn--ghost dd-btn--sm dd-top-bar__wide" href="#"><span>Docs</span></a>
    <button class="dd-btn dd-btn--ghost dd-btn--icon dd-top-bar__icon-btn" type="button" aria-label="Notifications, 3 new">${i('bell')}<span class="dd-top-bar__dot"></span></button>
    <button class="dd-btn dd-btn--primary dd-btn--sm dd-top-bar__wide" type="button">${i('upload')}<span>Deploy</span></button>${userMenu(o.open)}
  </div>
</header>`;

const app = bar();
const menuOpen = `<div style="padding-bottom: 300px">${bar({ open: true })}</div>`;
const narrow = `<div class="tb-phone">${bar()}</div>`;

const site = (id: string) => `
<header class="dd-top-bar">
  <button class="dd-btn dd-btn--ghost dd-btn--icon dd-top-bar__nav-btn" type="button" data-dd-menu="${id}" aria-haspopup="menu" aria-expanded="false" aria-controls="${id}" aria-label="Open menu">${i('menu')}</button>
  <div class="dd-menu" id="${id}" role="menu" aria-label="Sections" hidden>
    <a class="dd-menu__item" role="menuitem" href="#">Components</a>
    <a class="dd-menu__item" role="menuitem" href="#">Patterns</a>
    <a class="dd-menu__item" role="menuitem" href="#">Changelog</a>
  </div>
  <a class="dd-top-bar__brand" href="#"><span class="dd-logo">dawn &amp; dusk</span></a>
  <nav aria-label="Sections">
    <ul class="dd-top-bar__links">
      <li><a class="dd-top-bar__link" href="#" aria-current="page">Components</a></li>
      <li><a class="dd-top-bar__link" href="#">Patterns</a></li>
      <li><a class="dd-top-bar__link" href="#">Changelog</a></li>
    </ul>
  </nav>
  <div class="dd-top-bar__actions">
    <button class="dd-btn dd-btn--ghost dd-btn--icon" type="button" aria-label="Search">${i('search')}</button>
    <a class="dd-btn dd-btn--ghost dd-btn--icon dd-top-bar__wide" href="#" aria-label="GitHub">${i('code')}</a>
    <button class="dd-btn dd-btn--secondary dd-btn--sm dd-top-bar__wide" type="button" data-dd-theme-toggle>${i('moon')}<span>Dusk</span></button>
    <button class="dd-btn dd-btn--ghost dd-btn--icon dd-top-bar__narrow" type="button" data-dd-theme-toggle aria-label="Toggle dusk">${i('moon')}</button>
  </div>
</header>`;
const siteWide = site('tb-site-menu');
const siteNarrow = `<div class="tb-phone tb-phone--short">${site('tb-site-menu-narrow')}</div>`;
---
<Docs title="Top bar" group="Navigation" lead="The app header. Logo and context on the left, then a search trigger, actions and the avatar menu. It sits on the page tone with a hairline underneath, and stays put while the page scrolls.">
  <style is:global>
    /* Docs only: an open dropdown spills out of its example frame instead of being clipped by it. */
    .ex-frame:has(details[data-dd-autoclose][open]) { overflow: visible; }
    .ex-frame:has(details[data-dd-autoclose][open]) > .ex-stage { overflow: visible; border-radius: var(--dd-r-lg) var(--dd-r-lg) 0 0; }
    .ex-frame:has(details[data-dd-autoclose][open]) > .ex-stage > .dd-top-bar:first-child { border-radius: var(--dd-r-lg) var(--dd-r-lg) 0 0; }
    .ex-frame:has(details[data-dd-autoclose][open]) > .ex-bar:has(+ .ex-code[hidden]),
    .ex-frame:has(details[data-dd-autoclose][open]) > .ex-code:not([hidden]) { border-radius: 0 0 var(--dd-r-lg) var(--dd-r-lg); }
    .ex-stage > .dd-top-bar, .ex-stage > div > .dd-top-bar { position: relative; } /* docs only: don't stick inside examples */
    /* A phone-sized frame with room under the bar, so the avatar menu opens inside it instead of being clipped. */
    .tb-phone { max-width: 380px; height: 340px; margin: 24px auto; border-radius: var(--dd-r-lg); contain: layout;
      box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--dd-text) 10%, transparent); }
    .tb-phone > .dd-top-bar { border-radius: var(--dd-r-lg) var(--dd-r-lg) 0 0; }
    .tb-phone--short { height: 220px; }
  </style>
  <script is:inline>
    // Docs only: buttons in these demos say what they would do in an app, instead of doing nothing.
    document.addEventListener('click', (e) => {
      const b = e.target.closest('.ex-stage .dd-top-bar button:not([data-dd-theme-toggle], [data-dd-menu], [data-dd-nav-open])');
      if (!b || !window.dd?.toast) return;
      const say =
        b.matches('.dd-top-bar__nav-btn') ? ['Open navigation', 'In an app this slides the side nav in — try it in App shell, on a phone.'] :
        b.matches('.dd-top-bar__search, [aria-label="Search"]') ? ['Search', 'In an app this opens the command palette (⌘K).'] :
        b.matches('.dd-top-bar__switch') ? [`Switch ${b.querySelector('span:not(.dd-top-bar__mark)')?.textContent ?? ''}`, 'In an app this opens a menu of workspaces or projects.'] :
        b.matches('.dd-top-bar__icon-btn') ? ['3 new notifications', 'In an app this opens your inbox.'] :
        b.matches('.dd-btn--primary') ? ['Deploy', 'In an app this starts a deploy of auth-gateway.'] : null;
      if (say) window.dd.toast({ title: say[0], description: say[1], duration: 3500 });
    });
  </script>

  <Example title="App header" description="Logo, workspace / project switcher, search, Docs, notifications, the primary action and the avatar menu. Try it: click the avatar, or focus it and press ↓; the other buttons say what they would do." code={app} stage="flush" />

  <h2 id="avatar-menu">Avatar menu</h2>
  <p>A <code>&lt;details data-dd-autoclose&gt;</code>: it closes on a click outside, on Esc or after choosing an item, and ↓ ↑ move through the items. Who you are sits at the top in mono. Shown open; click anywhere else to close it, then the avatar to bring it back.</p>
  <Example code={menuOpen} stage="flush" />

  <h2 id="narrow">Narrow</h2>
  <p>Below 640px of its own width the menu button appears (wire it to the side nav with <code>data-dd-nav-open="#app-nav"</code>), the search collapses to an icon, and the context plus anything marked <code>dd-top-bar__wide</code> step out. In an <a href="../app-shell">app shell</a> the menu button opens the side nav off-canvas.</p>
  <Example code={narrow} stage="flush" />

  <h2 id="site">Site header</h2>
  <p>For docs and marketing pages: links instead of a context switcher. On narrow screens the links fold into the menu button — here a <a href="../menu">menu</a> (<code>data-dd-menu</code>) with the same links; a sheet or the side nav work too.</p>
  <Example code={siteWide} stage="flush" />
  <Example description="Narrow. Try it: open the menu button and pick a section with ↓ ↑ and Enter, or flip dusk from the moon." code={siteNarrow} stage="flush" />

  <h2 id="api">Classes</h2>
  <ClassTable rows={[
    ['.dd-top-bar', 'The <code>&lt;header&gt;</code>. Sticky, 60px min height, translucent page tone with a hairline. A size container: it adapts to its own width.'],
    ['__nav-btn', 'Mobile menu button (a ghost icon <code>.dd-btn</code>). Hidden until the bar is narrow.'],
    ['__brand', 'Logo link. Holds a <code>.dd-logo</code> or a <code>.dd-logo-tile</code>.'],
    ['__context / __sep / __switch / __mark', 'Workspace and project after the logo: a hairline, switch buttons, a small coloured mark.'],
    ['__links / __link', 'Section links for site headers; active with <code>aria-current="page"</code>.'],
    ['__search / __kbd', 'Search trigger styled like a field, with a shortcut hint. Pair it with the command palette.'],
    ['__actions', 'Right-hand group: icon buttons, the primary action, the avatar.'],
    ['__icon-btn / __dot', 'An icon button with an unread dot.'],
    ['__user / __avatar / __menu', 'Avatar menu: <code>&lt;details&gt;</code>, the initials disc, the floating menu.'],
    ['__menu-head / __menu-item / __menu-sep', 'Menu parts: who you are, items (links or buttons), hairline separators.'],
    ['__wide / __narrow', '<code>__wide</code> hides an element when the bar is narrow; <code>__narrow</code> shows one only then (a compact stand-in, such as an icon-only theme button).'],
  ]} />

  <h2 id="behaviour">Behaviour</h2>
  <ClassTable head={['Attribute / key', 'What it does']} rows={[
    ['data-dd-nav-open="#id"', 'On <code>__nav-btn</code>: opens that side nav off-canvas (see <a href="side-nav">Side nav</a>).'],
    ['data-dd-autoclose', 'On <code>__user</code>: outside click, Esc and choosing an item close the menu.'],
    ['↓ / ↑ · Esc', 'Open and move through the avatar menu; Esc closes it and returns focus to the avatar.'],
  ]} />

  <h2 id="guidelines">Guidelines</h2>
  <Guides
    do={['Keep one primary action in the bar, if any — usually the thing people do most (Deploy, New).', 'Show where you are next to the logo: workspace / project.', 'Use the same initials and colour for the avatar everywhere.']}
    dont={['Don’t repeat the side nav’s sections as top bar links in an app.', 'Don’t put more than three icon buttons before the avatar.', 'Don’t hide search on mobile — collapse it to an icon.']}
  />
</Docs>
