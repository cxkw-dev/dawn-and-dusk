---
import Docs from '../../layouts/Docs.astro';
import Example from '../../components/Example.astro';
import ClassTable from '../../components/ClassTable.astro';
import Guides from '../../components/Guides.astro';
import { i } from '../../lib/icon';

const chev = `<svg class="dd-icon dd-accordion__chevron" aria-hidden="true"><use href="#dd-i-chevron-down"/></svg>`;
const item = (title, body, { open = false, name = '', icon = '', meta = '' } = {}) => `
  <details class="dd-accordion__item"${name ? ` name="${name}"` : ''}${open ? ' open' : ''}>
    <summary class="dd-accordion__summary">${icon ? i(icon) : ''}<span class="dd-accordion__title">${title}</span>${meta ? `<span class="dd-accordion__meta">${meta}</span>` : ''}${chev}</summary>
    <div class="dd-accordion__body">${body}</div>
  </details>`;

const faq = `
<div class="dd-accordion" style="max-width: 640px">${[
  item('Do I need a build step to use dawn &amp; dusk?', '<p>No. Link <code>dawn-and-dusk.css</code> and, if you want the behaviours, <code>dawn-and-dusk.js</code> with <code>defer</code>. Everything is plain CSS and one vanilla script.</p>', { open: true }),
  item('How do I switch between dawn and dusk?', '<p>Set <code>data-theme="dawn"</code> or <code>"dusk"</code> on <code>&lt;html&gt;</code> — or on any element to theme just that part. With no attribute, the system follows the OS.</p>'),
  item('Can I change the accent colour?', '<p>Override <code>--dd-accent</code> and its siblings on <code>:root</code>. Components read tokens only, so the change carries everywhere.</p>'),
  item('Does it work without JavaScript?', '<p>Yes. Accordions, cards and dividers are pure CSS. Behaviours like dialogs and tabs enhance markup that already makes sense on its own.</p>'),
].join('')}
</div>`;

const exclusive = `
<div class="dd-accordion dd-accordion--icons" style="max-width: 640px">${[
  item('Environment', '<p>Production runs in <code>eu-west-1</code> and <code>us-east-1</code>; staging mirrors eu-west-1 only.</p>', { open: true, name: 'svc', icon: 'globe', meta: '2 regions' }),
  item('Secrets', '<p><code>JWT_SIGNING_KEY</code>, <code>SESSION_SECRET</code> and <code>OAUTH_CLIENT_SECRET</code> are pulled from the vault at boot and rotated every 30 days.</p>', { name: 'svc', icon: 'key', meta: '3 keys' }),
  item('Health checks', '<p><code>GET /healthz</code> every 10s; three misses in a row drain the instance.</p>', { name: 'svc', icon: 'shield', meta: '10s' }),
  item('Owners', '<p>Platform team · on call this week: cxkw.</p>', { name: 'svc', icon: 'users', meta: '@platform' }),
].join('')}
</div>`;

const boxed = `
<div class="dd-accordion dd-accordion--boxed dd-accordion--icons" style="max-width: 640px">${[
  item('auth-gateway', '<p>Issues and verifies session tokens for every cxkw.dev app. 14 instances, p95 182ms.</p>', { open: true, name: 'boxed', icon: 'shield', meta: 'v2.8.1' }),
  item('billing-worker', '<p>Turns usage events into invoices once an hour. Retries failed charges three times.</p>', { name: 'boxed', icon: 'box', meta: 'v1.4.0' }),
  item('edge-cache', '<p>Caches static assets and API GETs at the edge; purges on deploy.</p>', { name: 'boxed', icon: 'cloud', meta: 'v3.0.2' }),
].join('')}
</div>`;

const expand = `
<div style="max-width: 680px">
  <details class="dd-expand" open>
    <summary class="dd-expand__summary">
      <span class="dd-expand__lead">${i('cloud')}</span>
      <span class="dd-expand__titles">
        <span class="dd-expand__title">Deploy #4821 · auth-gateway</span>
        <span class="dd-expand__meta">a3f9c2e · main · 4m ago</span>
      </span>
      <span class="dd-expand__side">
        <span class="dd-expand__status is-ok">Live</span>
        <svg class="dd-icon dd-expand__chevron" aria-hidden="true"><use href="#dd-i-chevron-down"/></svg>
      </span>
    </summary>
    <div class="dd-expand__body">
      <dl class="dd-expand__dl">
        <dt>Commit</dt><dd>a3f9c2e — Rotate JWT keys on a schedule</dd>
        <dt>Regions</dt><dd>eu-west-1, us-east-1</dd>
        <dt>Duration</dt><dd>2m 41s</dd>
        <dt>Triggered by</dt><dd>cxkw</dd>
      </dl>
    </div>
  </details>
  <details class="dd-expand">
    <summary class="dd-expand__summary">
      <span class="dd-expand__lead">${i('cloud')}</span>
      <span class="dd-expand__titles">
        <span class="dd-expand__title">Deploy #4820 · billing-worker</span>
        <span class="dd-expand__meta">71be04d · main · 1h ago</span>
      </span>
      <span class="dd-expand__side">
        <span class="dd-expand__status is-bad">Failed</span>
        <svg class="dd-icon dd-expand__chevron" aria-hidden="true"><use href="#dd-i-chevron-down"/></svg>
      </span>
    </summary>
    <div class="dd-expand__body">
      <p>Migration <code>0042_invoice_currency</code> timed out after 120s. The previous release is still serving traffic.</p>
      <dl class="dd-expand__dl">
        <dt>Failed step</dt><dd>migrate</dd>
        <dt>Duration</dt><dd>3m 02s</dd>
      </dl>
    </div>
  </details>
  <details class="dd-expand">
    <summary class="dd-expand__summary">
      <span class="dd-expand__lead">${i('cloud')}</span>
      <span class="dd-expand__titles">
        <span class="dd-expand__title">Deploy #4819 · edge-cache</span>
        <span class="dd-expand__meta">9d02aa1 · release/3.0 · yesterday</span>
      </span>
      <span class="dd-expand__side">
        <span class="dd-expand__status is-warn">Rolled back</span>
        <svg class="dd-icon dd-expand__chevron" aria-hidden="true"><use href="#dd-i-chevron-down"/></svg>
      </span>
    </summary>
    <div class="dd-expand__body"><p>Hit rate dropped below 90% in ap-south-1 during the canary; rolled back automatically.</p></div>
  </details>
</div>`;
---
<Docs title="Accordion" group="Layout" lead="Sections that fold away. Built on native details and summary, so it works with no JavaScript, opens with the keyboard and finds text inside closed sections.">
  <Example title="Default" description="Hairlines between sections; the chevron turns when a section opens. Several can be open at once." code={faq} />

  <h2 id="exclusive">One open at a time</h2>
  <p>Give every <code>&lt;details&gt;</code> in the group the same <code>name</code> and the browser closes the others for you. Add <code>--icons</code> when summaries lead with an icon, so the body lines up with the text.</p>
  <Example code={exclusive} />

  <h2 id="boxed">Boxed</h2>
  <p>Each section on its own tonal fill instead of hairlines — for settings pages and lists that sit directly on the page.</p>
  <Example code={boxed} />

  <h2 id="expandable-card">Expandable card</h2>
  <p><code>.dd-expand</code> is a card whose summary is a full row — title, mono meta and a status — and whose body holds the detail. Use it for deploys, jobs and log entries.</p>
  <Example code={expand} />

  <h2 id="api">Classes</h2>
  <ClassTable rows={[
    ['.dd-accordion', 'Wrapper for a stack of sections.'],
    ['.dd-accordion__item', 'A <code>&lt;details&gt;</code>. Add <code>open</code> to start expanded and <code>name="…"</code> to make the group exclusive.'],
    ['.dd-accordion__summary', 'The <code>&lt;summary&gt;</code> row. Holds an optional leading icon, <code>__title</code>, <code>__meta</code> and <code>__chevron</code>.'],
    ['.dd-accordion__body', 'The content under the summary.'],
    ['.dd-accordion--boxed', 'Tonal fill per item instead of hairlines. A closed item lifts a tone on hover (further in dusk, so it clears the grain page); an open one washes its summary row.'],
    ['.dd-accordion--icons', 'Indents the body to line up with titles that follow an icon.'],
    ['.dd-expand', 'Expandable card (<code>&lt;details&gt;</code>). Parts: <code>__summary</code>, <code>__lead</code>, <code>__titles</code>, <code>__title</code>, <code>__meta</code>, <code>__side</code>, <code>__status</code>, <code>__chevron</code>, <code>__body</code>, <code>__dl</code>.'],
    ['.dd-expand__status', 'Status with a coloured dot: add <code>is-ok</code>, <code>is-warn</code>, <code>is-bad</code> or <code>is-info</code>.'],
  ]} />

  <h2 id="behaviour">Behaviour</h2>
  <p>No script. Enter or Space on a summary toggles it; closed content is still found by the browser’s find-in-page. Where <code>::details-content</code> is supported the body eases open; elsewhere it opens instantly.</p>

  <h2 id="guidelines">Guidelines</h2>
  <Guides
    do={['Write summaries that make sense on their own — people skim the closed list.', 'Use <code>name</code> groups when sections are alternatives (one service, one plan).', 'Keep primary actions outside the accordion so they never hide.']}
    dont={['Don’t hide content everyone needs; accordions are for the optional.', 'Don’t nest accordions more than one level.', 'Don’t put a link or button inside a summary — the whole row is already a toggle.']}
  />
</Docs>
