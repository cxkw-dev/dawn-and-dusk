---
import Docs from '../../layouts/Docs.astro';
import Example from '../../components/Example.astro';
import ClassTable from '../../components/ClassTable.astro';
import Guides from '../../components/Guides.astro';

const states = `
<div class="dd-row" style="--dd-gap: var(--dd-space-6)">
  <span class="dd-status-dot dd-status-dot--online">Online</span>
  <span class="dd-status-dot dd-status-dot--idle">Idle</span>
  <span class="dd-status-dot dd-status-dot--error">Error</span>
  <span class="dd-status-dot dd-status-dot--unknown">Unknown</span>
  <span class="dd-status-dot dd-status-dot--offline">Offline</span>
  <span class="dd-status-dot dd-status-dot--info">Maintenance</span>
</div>`;

const sizes = `
<div class="dd-stack" style="--dd-gap: var(--dd-space-4)">
  <div class="dd-row" style="--dd-gap: var(--dd-space-4)">
    <span class="dd-status-dot dd-status-dot--online dd-status-dot--sm" role="img" aria-label="Online"></span>
    <span class="dd-status-dot dd-status-dot--online" role="img" aria-label="Online"></span>
    <span class="dd-status-dot dd-status-dot--online dd-status-dot--lg" role="img" aria-label="Online"></span>
    <span class="dd-status-dot dd-status-dot--error dd-status-dot--sm" role="img" aria-label="Error"></span>
    <span class="dd-status-dot dd-status-dot--error" role="img" aria-label="Error"></span>
    <span class="dd-status-dot dd-status-dot--error dd-status-dot--lg" role="img" aria-label="Error"></span>
  </div>
  <div class="dd-row" style="--dd-gap: var(--dd-space-6)">
    <span class="dd-status-dot dd-status-dot--online dd-status-dot--sm dd-status-dot--muted">3 online</span>
    <span class="dd-status-dot dd-status-dot--idle">Away until 14:00</span>
    <span class="dd-status-dot dd-status-dot--error dd-status-dot--lg">Build failing</span>
  </div>
</div>`;

const live = `
<div class="dd-row" style="--dd-gap: var(--dd-space-6)">
  <span class="dd-status-dot dd-status-dot--online dd-status-dot--live">Live tail</span>
  <span class="dd-status-dot dd-status-dot--info dd-status-dot--live">Deploying to sgp1</span>
  <span class="dd-status-dot dd-status-dot--error dd-status-dot--live">Recording incident</span>
</div>`;

const row = (name: string, state: string, label: string, meta: string, last = false) => `
  <div style="display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--dd-space-1) var(--dd-space-4); align-items: center; padding: var(--dd-space-3) 0;${last ? '' : ' box-shadow: inset 0 -1px 0 color-mix(in oklab, var(--dd-text) 8%, transparent)'}">
    <span><b>${name}</b> <span class="dd-mono dd-muted dd-small">${meta}</span></span>
    <span class="dd-status-dot dd-status-dot--${state}">${label}</span>
  </div>`;
const services = `
<div style="max-width: 520px">${row('auth-gateway', 'online', 'Operational', 'fra1 · sfo3 · sgp1')}${row('billing-worker', 'idle', 'Degraded', 'p95 611 ms')}${row('edge-cache', 'error', 'Down', 'since 09:41')}${row('search-indexer', 'unknown', 'No data', 'last seen 2h ago')}${row('notify-fanout', 'info', 'Maintenance', 'until 02:30', true)}
</div>`;
---
<Docs title="Status dot" group="Feedback & status" lead="A small coloured dot for presence and health — is it up, is someone there. With a word beside it, it’s a status; on its own, it’s a hint that needs a label for screen readers.">
  <Example title="States" description="Online, idle, error and unknown, plus offline and maintenance. Unknown is hollow: no signal is not a colour." code={states} />

  <h2 id="sizes">Sizes and dots alone</h2>
  <p>6, 8 (default) and 10px. A dot without text needs <code>role="img"</code> and an <code>aria-label</code>.</p>
  <Example code={sizes} />

  <h2 id="live">Live</h2>
  <p><code>--live</code> sends a soft ring out from the dot — for things happening right now: a deploy in progress, a live log tail. Use one at a time. Under reduced motion the ring is dropped.</p>
  <Example code={live} />

  <h2 id="in-context">Service health</h2>
  <Example code={services} />

  <h2 id="api">Classes</h2>
  <ClassTable rows={[
    ['.dd-status-dot', 'The dot (its <code>::before</code>) plus any text inside as the label.'],
    ['.dd-status-dot--{state}', '<code>online</code> (ok) · <code>idle</code> (warn) · <code>error</code> (bad) · <code>unknown</code> (hollow ring) · <code>offline</code> (greige) · <code>info</code> (maintenance).'],
    ['.dd-status-dot--sm / --lg', '6px and 10px dots (default 8px). Or set <code>--dd-status-size</code>.'],
    ['.dd-status-dot--live', 'Pulsing ring.'],
    ['.dd-status-dot--muted', 'Muted label colour.'],
  ]} />

  <h2 id="guidelines">Guidelines</h2>
  <Guides
    do={['Pair the dot with a word wherever there’s room.', 'Use the same words across the product: Operational, Degraded, Down.', 'Reserve <code>--live</code> for one thing on screen.']}
    dont={['Don’t use status dots as bullets or decoration.', 'Don’t use green for “selected” or “new” — it means healthy.', 'Don’t pulse things that aren’t changing.']}
  />
</Docs>
