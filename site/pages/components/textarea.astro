---
import Docs from '../../layouts/Docs.astro';
import Example from '../../components/Example.astro';
import ClassTable from '../../components/ClassTable.astro';
import Guides from '../../components/Guides.astro';

const basic = `
<div class="dd-field" style="max-width: 520px">
  <label class="dd-field__label" for="ta-1">Release notes</label>
  <div class="dd-input dd-textarea">
    <textarea class="dd-input__control" id="ta-1" rows="4" maxlength="500" placeholder="What changed in this deploy?">Moves session refresh into auth-gateway and drops the legacy cookie. Cold starts on billing-worker are down 38%.</textarea>
  </div>
  <div class="dd-field__foot">
    <p class="dd-field__hint">Markdown works. Shown on the changelog.</p>
    <span class="dd-field__counter">112 / 500</span>
  </div>
</div>`;

const autogrow = `
<div class="dd-field" style="max-width: 520px">
  <label class="dd-field__label" for="ta-2">Comment</label>
  <div class="dd-input dd-textarea">
    <textarea class="dd-input__control" id="ta-2" data-dd-autogrow placeholder="Leave a note for the reviewer…"></textarea>
  </div>
  <p class="dd-field__hint">Grows as you type, up to ten lines.</p>
</div>`;

const states = `
<div class="dd-form__grid">
  <div class="dd-field">
    <label class="dd-field__label" for="ta-3">Commit message</label>
    <div class="dd-input dd-textarea">
      <textarea class="dd-input__control" id="ta-3" rows="2" aria-invalid="true" aria-describedby="ta-3-err ta-3-c">fix(edge-cache): respect stale-while-revalidate on 304s so purges stop racing the origin</textarea>
    </div>
    <div class="dd-field__foot">
      <p class="dd-field__error" id="ta-3-err">Keep the subject line under 72 characters.</p>
      <span class="dd-field__counter is-over" id="ta-3-c" data-dd-counter="72">88 / 72</span>
    </div>
  </div>
  <div class="dd-field">
    <label class="dd-field__label" for="ta-4">Incident summary</label>
    <div class="dd-input dd-textarea">
      <textarea class="dd-input__control" id="ta-4" rows="2" disabled>edge-cache served stale purges for 14 minutes after the 09:12 deploy.</textarea>
    </div>
    <p class="dd-field__hint">Locked since the post-mortem went out on Oct 21.</p>
  </div>
</div>`;

const mono = `
<div class="dd-field dd-field--above" style="max-width: 520px">
  <label class="dd-field__label" for="ta-5">Environment variables</label>
  <div class="dd-input dd-textarea">
    <textarea class="dd-input__control dd-mono" id="ta-5" rows="4" spellcheck="false">DATABASE_URL=postgres://billing@db.internal:5432/billing
EDGE_CACHE_TTL=300
LOG_LEVEL=info</textarea>
  </div>
  <p class="dd-field__hint">One KEY=value per line. Values are encrypted at rest.</p>
</div>`;
---
<Docs title="Textarea" group="Forms" lead="Several lines of text in the same tonal box as the text input. The label tucks in above the text, a counter keeps length honest, and auto-grow is one attribute away.">
  <Example title="With counter" description="Put a .dd-field__counter in the field’s foot; it counts against the textarea’s maxlength as you type." code={basic} />

  <h2 id="autogrow">Auto-grow</h2>
  <p>Add <code>data-dd-autogrow</code>: the box starts at two lines, grows with the content up to ten, then scrolls.</p>
  <Example code={autogrow} />

  <h2 id="states">Soft limit, error and disabled</h2>
  <p><code>data-dd-counter="72"</code> sets a soft limit: typing past it is allowed, but the counter turns red and the control is marked invalid until it is back under.</p>
  <Example code={states} />

  <h2 id="mono">Code and config</h2>
  <p>Add <code>.dd-mono</code> to the control for config, keys and logs; turn spellcheck off.</p>
  <Example code={mono} />

  <h2 id="api">Classes</h2>
  <ClassTable rows={[
    ['.dd-input.dd-textarea', 'The box. Carries the padding so scrolled text never slides under the tucked label.'],
    ['.dd-input__control', 'The <code>&lt;textarea&gt;</code>. Height follows <code>rows</code> (2, 3, 4 or 6); resizes vertically.'],
    ['[data-dd-autogrow]', 'Grows with its content (2–10 lines).'],
    ['.dd-field__counter', 'Character counter in the field foot (see Form field).'],
  ]} />

  <h2 id="behaviour">Behaviour</h2>
  <ClassTable head={['Attribute', 'What it does']} rows={[
    ['textarea[data-dd-autogrow]', 'Resizes to fit on every input, up to the CSS max-height, then scrolls.'],
    ['.dd-field__counter', 'Counts the field’s control: <code>n / maxlength</code>, or <code>n / data-dd-counter</code> as a soft limit. <code>.is-near</code> at 90%, <code>.is-over</code> past it.'],
  ]} />

  <h2 id="guidelines">Guidelines</h2>
  <Guides
    do={['Size the box to the expected answer — two lines for a note, six for a description.', 'Show a counter only when there is a limit.', 'Use a soft limit when people need to see the whole draft before trimming.']}
    dont={['Don’t use a textarea for one-line answers.', 'Don’t cut pasted text silently at maxlength; prefer a soft limit.', 'Don’t disable resizing unless the layout truly depends on it.']}
  />
</Docs>
