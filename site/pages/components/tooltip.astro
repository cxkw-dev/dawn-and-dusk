---
import Docs from '../../layouts/Docs.astro';
import Example from '../../components/Example.astro';
import ClassTable from '../../components/ClassTable.astro';
import Guides from '../../components/Guides.astro';
import { i } from '../../lib/icon';

const live = `
<div class="dd-row">
  <button class="dd-btn dd-btn--ghost dd-btn--icon" type="button" aria-label="Copy link" data-dd-tooltip="Copy link">${i('link')}</button>
  <button class="dd-btn dd-btn--ghost dd-btn--icon" type="button" aria-label="Download logs" data-dd-tooltip="Download logs">${i('download')}</button>
  <button class="dd-btn dd-btn--ghost dd-btn--icon" type="button" aria-label="Redeploy" data-dd-tooltip="Redeploy the last build to every region">${i('refresh')}</button>
  <button class="dd-btn dd-btn--ghost dd-btn--icon" type="button" aria-label="Settings" data-dd-tooltip="Settings">${i('settings')}</button>
  <span class="dd-muted dd-small" data-dd-tooltip="12 Oct 2026, 09:41:07 UTC" tabindex="0">3 minutes ago</span>
</div>`;

const placements = `
<div class="dd-row" style="--dd-gap: var(--dd-space-3)">
  <button class="dd-btn" type="button" data-dd-tooltip="Placed on top" data-dd-tooltip-placement="top">${i('arrow-up')}<span>Top</span></button>
  <button class="dd-btn" type="button" data-dd-tooltip="Placed below" data-dd-tooltip-placement="bottom">${i('arrow-down')}<span>Bottom</span></button>
  <button class="dd-btn" type="button" data-dd-tooltip="Placed to the left" data-dd-tooltip-placement="left">${i('arrow-left')}<span>Left</span></button>
  <button class="dd-btn" type="button" data-dd-tooltip="Placed to the right" data-dd-tooltip-placement="right">${i('arrow-right')}<span>Right</span></button>
  <button class="dd-btn" type="button" data-dd-tooltip="Aligned to the start edge" data-dd-tooltip-placement="bottom-start"><span>Bottom start</span></button>
</div>`;

const anatomy = `
<div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: var(--dd-space-8)">
  <div class="dd-tooltip dd-tooltip--static" data-placement="top" role="tooltip"><span>Copy link</span></div>
  <div class="dd-tooltip dd-tooltip--static" data-placement="bottom" role="tooltip"><span>Download logs</span></div>
  <div class="dd-tooltip dd-tooltip--static" data-placement="left" role="tooltip"><span>Previous deploy</span></div>
  <div class="dd-tooltip dd-tooltip--static" data-placement="right" role="tooltip"><span>Next deploy</span></div>
  <div class="dd-tooltip dd-tooltip--static" data-placement="top" role="tooltip"><span>Search</span><span class="dd-tooltip__keys"><kbd>⌘</kbd><kbd>K</kbd></span></div>
</div>`;

const kbd = `
<div class="dd-row">
  <button class="dd-btn" type="button" data-dd-tooltip="Search" data-dd-tooltip-kbd="⌘ K">${i('search')}<span>Search</span></button>
  <button class="dd-btn dd-btn--primary" type="button" data-dd-tooltip="New deploy" data-dd-tooltip-kbd="N">${i('plus')}<span>New deploy</span></button>
  <button class="dd-btn dd-btn--ghost dd-btn--icon" type="button" aria-label="Toggle sidebar" data-dd-tooltip="Toggle sidebar" data-dd-tooltip-kbd="⌘ \\">${i('sidebar')}</button>
  <button class="dd-btn dd-btn--ghost dd-btn--icon" type="button" aria-label="Archive" data-dd-tooltip="Archive" data-dd-tooltip-kbd="E" data-dd-tooltip-placement="bottom">${i('archive')}</button>
</div>`;
---
<Docs title="Tooltip" group="Feedback & status" lead="A few words about a control, on hover or keyboard focus. Add one attribute; the tooltip finds its own place and points back at what it describes.">
  <Example title="On hover and focus" description="Hover any button, or Tab to it. Icon-only buttons need a tooltip and an aria-label with the same words. A short delay stops tooltips flashing as the pointer passes; once one is open, the next appears instantly." code={live} stage="center" />

  <h2 id="placement">Placement</h2>
  <p>Top by default. <code>data-dd-tooltip-placement</code> asks for another side or an edge alignment; if it doesn’t fit, the tooltip flips to the opposite side and slides to stay on screen, and the arrow keeps pointing at the trigger.</p>
  <Example code={placements} stage="center" />

  <h2 id="kbd">Shortcut hint</h2>
  <p><code>data-dd-tooltip-kbd</code> adds the keyboard shortcut after the label — one <code>&lt;kbd&gt;</code> per space-separated key.</p>
  <Example code={kbd} stage="center" />

  <h2 id="anatomy">Anatomy</h2>
  <p>An ink chip in dawn, a raised <code>--dd-surface-3</code> chip in dusk; 11px medium type, an 8px arrow. <code>--static</code> renders one in the flow for mockups and docs.</p>
  <Example code={anatomy} stage="center" />

  <h2 id="api">Classes</h2>
  <ClassTable rows={[
    ['.dd-tooltip', 'The tooltip. The JS creates one, <code>role="tooltip"</code>, at the end of <code>&lt;body&gt;</code>.'],
    ['.is-open', 'Visible (fades and slides 3px toward its trigger).'],
    ['[data-placement]', 'The side it ended up on: <code>top</code>, <code>bottom</code>, <code>left</code>, <code>right</code> (+ <code>-start</code> / <code>-end</code>). Moves the arrow.'],
    ['.dd-tooltip__keys > kbd', 'Shortcut keys.'],
    ['.dd-tooltip--static', 'In-flow rendering for docs and mockups.'],
    ['--dd-tooltip-bg / --dd-tooltip-fg', 'Colours: ink in dawn, surface-3 in dusk.'],
  ]} />

  <h2 id="behaviour">Behaviour</h2>
  <ClassTable head={['Attribute', 'What it does']} rows={[
    ['data-dd-tooltip="text"', 'Shows the text on mouse hover (450ms delay, instant while moving between tooltips) and on keyboard focus.'],
    ['data-dd-tooltip-placement', '<code>top</code> (default) · <code>bottom</code> · <code>left</code> · <code>right</code>, optionally <code>-start</code> / <code>-end</code>.'],
    ['data-dd-tooltip-kbd', 'Shortcut hint, keys separated by spaces: <code>"⌘ K"</code>.'],
    ['aria-describedby', 'Added to the trigger while the tooltip is open (unless its <code>aria-label</code> already says the same thing).'],
    ['Esc · click · scroll', 'Hide the tooltip. The pointer can move onto the tooltip without it closing. Touch taps don’t open tooltips.'],
    ['Top layer', 'The tooltip is a manual popover, so it shows above open dialogs, drawers and popovers — buttons inside them can have tooltips too. It fades in from the side it lands on, after any flip.'],
  ]} />

  <h2 id="guidelines">Guidelines</h2>
  <Guides
    do={['Name the action in two or three words: “Copy link”.', 'Give every icon-only button a tooltip.', 'Use the shortcut hint to teach the keyboard.']}
    dont={['Don’t put anything interactive or essential in a tooltip — use a popover.', 'Don’t add tooltips to things that already have a visible label.', 'Don’t use tooltips on disabled buttons to explain why; say it next to them.']}
  />
</Docs>
