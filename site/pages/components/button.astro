---
import Docs from '../../layouts/Docs.astro';
import Example from '../../components/Example.astro';
import ClassTable from '../../components/ClassTable.astro';
import Guides from '../../components/Guides.astro';
import { i } from '../../lib/icon';

const variants = `
<div class="dd-row">
  <button class="dd-btn dd-btn--primary">${i('plus')}<span>New project</span></button>
  <button class="dd-btn dd-btn--secondary">${i('external')}<span>Open</span></button>
  <button class="dd-btn dd-btn--ink">${i('download')}<span>Export</span></button>
  <button class="dd-btn dd-btn--ghost">${i('copy')}<span>Copy</span></button>
  <button class="dd-btn dd-btn--danger">${i('trash')}<span>Delete</span></button>
  <a class="dd-btn dd-btn--link" href="#guidelines"><span>Read the docs</span>${i('arrow-right')}</a>
</div>`;

const sizes = `
<div class="dd-row">
  <button class="dd-btn dd-btn--primary dd-btn--sm">${i('plus')}<span>Small</span></button>
  <button class="dd-btn dd-btn--primary">${i('plus')}<span>Medium</span></button>
  <button class="dd-btn dd-btn--primary dd-btn--lg">${i('plus')}<span>Large</span></button>
</div>`;

const iconOnly = `
<div class="dd-row">
  <button class="dd-btn dd-btn--primary dd-btn--icon" aria-label="Add">${i('plus')}</button>
  <button class="dd-btn dd-btn--secondary dd-btn--icon" aria-label="Save">${i('heart')}</button>
  <button class="dd-btn dd-btn--ghost dd-btn--icon" aria-label="Settings">${i('settings')}</button>
  <button class="dd-btn dd-btn--ghost dd-btn--icon dd-btn--sm" aria-label="More">${i('more')}</button>
</div>`;

const states = `
<div class="dd-stack" style="--dd-gap: 15px">
  <div class="dd-row">
    <button class="dd-btn dd-btn--primary" disabled>${i('plus')}<span>New project</span></button>
    <button class="dd-btn dd-btn--secondary" disabled>${i('external')}<span>Open</span></button>
    <button class="dd-btn dd-btn--ink" disabled>${i('download')}<span>Export</span></button>
    <button class="dd-btn dd-btn--ghost" disabled>${i('copy')}<span>Copy</span></button>
    <button class="dd-btn dd-btn--danger" disabled>${i('trash')}<span>Delete</span></button>
    <a class="dd-btn dd-btn--link" aria-disabled="true"><span>Read the docs</span>${i('arrow-right')}</a>
  </div>
  <div class="dd-row">
    <button class="dd-btn dd-btn--primary is-loading" aria-busy="true"><span class="dd-btn__spinner"></span><span>Saving</span></button>
    <button class="dd-btn dd-btn--secondary is-loading" aria-busy="true"><span class="dd-btn__spinner"></span><span>Syncing</span></button>
    <button class="dd-btn dd-btn--ghost is-loading" aria-busy="true"><span class="dd-btn__spinner"></span><span>Retrying</span></button>
  </div>
</div>`;

const onSurface = `
<div class="dd-surface" style="display: flex; flex-wrap: wrap; align-items: center; gap: 10px; padding: 15px 15px 15px 20px">
  <span class="dd-stack" style="--dd-gap: 2px; flex: 1 1 200px; min-width: 0">
    <b style="font-weight: 600">billing-worker</b>
    <span class="dd-small dd-muted"><span class="dd-mono">7be04d2</span> · failed 1h ago · iad1</span>
  </span>
  <button class="dd-btn dd-btn--ghost dd-btn--icon dd-btn--sm" aria-label="Copy deployment ID" data-dd-toast="Deployment ID copied" data-dd-toast-description="7be04d2" data-dd-toast-intent="ok">${i('copy')}</button>
  <button class="dd-btn dd-btn--ghost dd-btn--sm">${i('terminal')}<span>Logs</span></button>
  <button class="dd-btn dd-btn--secondary dd-btn--sm">${i('arrow-left')}<span>Roll back</span></button>
  <button class="dd-btn dd-btn--primary dd-btn--sm" id="bt-redeploy">${i('refresh')}<span>Redeploy</span></button>
</div>`;

const block = `
<div class="dd-stack" style="max-width: 320px">
  <button class="dd-btn dd-btn--primary dd-btn--block dd-btn--lg">Continue</button>
  <button class="dd-btn dd-btn--ghost dd-btn--block">Back</button>
</div>`;
---
<Docs title="Button" group="Actions" lead="Starts an action. Primary is filled with the Golden hour apricot; everything else steps down in emphasis. Icons lead the label.">
  <Example title="Variants" description="One primary per view. Secondary for the common alternatives, ghost for tertiary actions in toolbars, ink when the action needs weight but not colour." code={variants} />
  <h2 id="sizes">Sizes</h2>
  <p>Medium is the default. Small for dense toolbars and table rows; large for hero calls to action.</p>
  <Example code={sizes} />
  <h2 id="icon-only">Icon only</h2>
  <p>Square, same height as a text button. Always give it an <code>aria-label</code>.</p>
  <Example code={iconOnly} />
  <h2 id="states">States</h2>
  <p>Hover steps each fill one tone (ghost buttons take a translucent wash, so they show on the page, on cards and in menus alike); pressing nudges the button down a pixel; keyboard focus draws the ring. Use the native <code>disabled</code> attribute (or <code>aria-disabled="true"</code> on links) to fade a button and stop clicks. While work is in flight, add <code>is-loading</code> and swap the icon for a spinner.</p>
  <Example code={states} description="Try it: the faded buttons ignore clicks and Tab skips them; the busy ones ignore clicks and Enter too. Press “Redeploy” in the next example to see the busy state live." />
  <h2 id="on-a-surface">On a surface</h2>
  <p>Every variant works on a <code>.dd-surface</code> card as well as on the page. Hover the ghost buttons in dusk: the wash still reads.</p>
  <Example code={onSurface} description="Try it: “Redeploy” goes busy while it works, then confirms with a toast; clicking it again meanwhile does nothing. The copy button confirms too." />
  <h2 id="block">Full width</h2>
  <p><code>.dd-btn--block</code> stretches a button across its container, for stacked actions in narrow forms and on phones.</p>
  <Example code={block} />
  <h2 id="api">Classes</h2>
  <ClassTable rows={[
    ['.dd-btn', 'Base button. Works on <code>&lt;button&gt;</code> and <code>&lt;a&gt;</code>.'],
    ['.dd-btn--primary', 'Filled with <code>--dd-primary</code> (apricot). One per view.'],
    ['.dd-btn--secondary', 'Tonal fill. The default look if no variant is given.'],
    ['.dd-btn--ink', 'Filled with the text colour — heavy but colourless.'],
    ['.dd-btn--ghost', 'No fill until hover, then a translucent wash (<code>--dd-wash-strong</code>). Toolbars, table rows, dismiss actions.'],
    ['.dd-btn--danger', 'Destructive actions. Pair with a confirmation dialog.'],
    ['.dd-btn--link', 'Reads as a link; wrap the label in a <code>&lt;span&gt;</code> for the dotted underline.'],
    ['.dd-btn--sm / --lg', 'Sizes. Medium has no modifier.'],
    ['.dd-btn--icon', 'Square icon-only button.'],
    ['.dd-btn--block', 'Fills its container.'],
    ['.is-loading + .dd-btn__spinner', 'Busy state: ignores clicks and the keyboard; also set <code>aria-busy="true"</code>.'],
    [':disabled / [aria-disabled="true"]', 'Faded to 45% and not clickable. Native <code>disabled</code> also leaves the tab order; <code>aria-disabled</code> keeps it focusable, so keyboard users still find it.'],
  ]} />
  <h2 id="behaviour">Behaviour</h2>
  <p><code>ds/behaviors/button.js</code> makes a busy (<code>.is-loading</code>) or <code>aria-disabled="true"</code> button ignore activation from the keyboard too: Enter, Space, a form’s implicit submit and an <code>aria-disabled</code> link’s navigation are all stopped before your own click handlers run. Without it, CSS still blocks pointer clicks.</p>
  <h2 id="guidelines">Guidelines</h2>
  <Guides
    do={['Lead with a verb: “New project”, “Export”, “Delete”.', 'Keep one primary button per view or dialog.', 'Put the icon first; it is part of the label’s rhythm.']}
    dont={['Don’t use primary for navigation — use a link.', 'Don’t stack two filled buttons side by side; make one secondary.', 'Don’t disable without saying why nearby.']}
  />
</Docs>
<script>
  // Docs demo: “Redeploy” shows the busy state while the work runs, then confirms with a toast.
  document.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest<HTMLButtonElement>('#bt-redeploy');
    if (!btn) return;
    const before = btn.innerHTML;
    btn.classList.add('is-loading');
    btn.setAttribute('aria-busy', 'true');
    btn.innerHTML = '<span class="dd-btn__spinner"></span><span>Redeploying</span>';
    setTimeout(() => {
      btn.classList.remove('is-loading');
      btn.removeAttribute('aria-busy');
      btn.innerHTML = before;
      (window as any).dd?.toast({ title: 'Redeployed billing-worker', description: '7be04d2 · iad1 · 41s', intent: 'ok' });
    }, 1400);
  });
</script>
