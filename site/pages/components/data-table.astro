---
import Docs from '../../layouts/Docs.astro';
import Example from '../../components/Example.astro';
import ClassTable from '../../components/ClassTable.astro';
import Guides from '../../components/Guides.astro';
import { i } from '../../lib/icon';

// Service fleet: [id, name, status, label, region, version, owner, req/min, error %, p95 ms, cpu %, updated]
const services = [
  ['svc-0141', 'auth-gateway', 'ok', 'Healthy', 'us-east-1', 'v2.14.0', 'platform', 12480, 0.02, 84, 41, '09:41:07'],
  ['svc-0152', 'billing-worker', 'ok', 'Healthy', 'us-east-1', 'v1.8.3', 'payments', 3212, 0.11, 142, 58, '09:41:02'],
  ['svc-0167', 'search-indexer', 'warn', 'Degraded', 'us-east-1', 'v0.9.12', 'search', 8904, 1.84, 611, 87, '09:40:55'],
  ['svc-0171', 'edge-cache', 'ok', 'Healthy', 'us-east-1', 'v3.2.1', 'platform', 41337, 0, 12, 33, '09:40:51'],
  ['svc-0203', 'ledger-sync', 'ok', 'Healthy', 'eu-west-2', 'v1.2.0', 'payments', 1048, 0.05, 96, 22, '09:40:48'],
  ['svc-0219', 'notify-fanout', 'bad', 'Down', 'eu-west-2', 'v2.0.0-rc.2', 'growth', 0, null, null, 0, '09:39:12'],
  ['svc-0224', 'mail-relay', 'ok', 'Healthy', 'eu-west-2', 'v4.1.7', 'growth', 2771, 0.08, 133, 19, '09:40:40'],
  ['svc-0230', 'session-store', 'ok', 'Healthy', 'eu-west-2', 'v5.0.2', 'platform', 18452, 0.01, 9, 47, '09:40:38'],
  ['svc-0310', 'image-resizer', 'ok', 'Healthy', 'ap-south-1', 'v1.5.0', 'media', 6502, 0.32, 188, 64, '09:40:37'],
  ['svc-0318', 'metrics-agg', 'warn', 'Degraded', 'ap-south-1', 'v2.3.4', 'observability', 19220, 0.94, 402, 91, '09:40:33'],
  ['svc-0327', 'cron-runner', 'ok', 'Healthy', 'ap-south-1', 'v1.0.9', 'platform', 112, 0, 51, 6, '09:40:29'],
  ['svc-0331', 'webhook-relay', 'ok', 'Healthy', 'ap-south-1', 'v2.7.1', 'growth', 4380, 0.21, 117, 38, '09:40:21'],
];
const fmt = (n) => n.toLocaleString('en-US');
const dash = '<span class="is-faint">—</span>';
const errCell = (e) => e === null ? `<td class="is-num">${dash}</td>` : `<td class="is-num${e >= 1 ? ' is-warn' : ''}">${e.toFixed(2)}%</td>`;
const p95Cell = (p) => p === null ? `<td class="is-num">${dash}</td>` : `<td class="is-num${p >= 400 ? ' is-warn' : ''}" data-value="${p}">${p}<span class="dd-data-table__unit">ms</span></td>`;
const cpuCell = (c) => `<td class="is-num${c >= 85 ? ' is-warn' : ''}">${c}%</td>`;
const commits = { 'auth-gateway': ['a41f9c2', 'Rotate JWKS keys every 6h'], 'search-indexer': ['c90e5aa', 'Batch shard merges'], 'billing-worker': ['7be03d1', 'Retry idempotent charges'] };
const SEL = ['billing-worker', 'ledger-sync'];
const OPEN = ['search-indexer'];

const sortTh = (label, col, cls = '', sort = 'none') =>
  `<th${cls ? ` class="${cls}"` : ''} data-col="${col}" aria-sort="${sort}"><button class="dd-data-table__sort" type="button">${label}${i('chevron-down')}</button></th>`;

// The flagship pages 10 rows at a time; rows past the first page start hidden so nothing jumps while the script loads.
const PAGE = 10;
const flagRows = services.map(([id, name, s, label, region, ver, owner, req, err, p95, cpu, at], n) => {
  const open = OPEN.includes(name);
  const off = n >= PAGE;
  const sel = SEL.includes(name);
  const [sha, msg] = commits[name] ?? ['3f0d8b1', 'Bump runtime to node 22.12'];
  return `
      <tr${sel ? ' class="is-selected"' : ''}${off ? ' hidden' : ''}>
        <td class="dd-data-table__select"><input class="dd-data-table__check" type="checkbox" aria-label="Select ${name}"${sel ? ' checked' : ''}></td>
        <td class="is-frozen" data-col="service"><button class="dd-data-table__expand" type="button" aria-expanded="${open}" aria-controls="dt-${id}" aria-label="Details for ${name}">${i('chevron-right')}</button><a href="#">${name}</a></td>
        <td class="is-mono is-muted" data-col="id">${id}</td>
        <td data-col="status" data-value="${s}"><span class="dd-data-table__status" data-status="${s}">${label}</span></td>
        <td data-col="region">${region}</td>
        <td class="is-mono" data-col="version">${ver}</td>
        <td class="is-muted" data-col="owner">${owner}</td>
        <td class="is-num">${fmt(req)}</td>
        ${errCell(err)}
        ${p95Cell(p95)}
        ${cpuCell(cpu)}
        <td class="is-num is-muted" data-value="2026-10-30T${at}">${at}</td>
        <td class="is-actions"><button class="dd-btn dd-btn--ghost dd-btn--sm dd-btn--icon" type="button" aria-label="Actions for ${name}" data-dd-menu="dt-row-menu" data-dd-placement="bottom-end" aria-haspopup="menu" aria-expanded="false" aria-controls="dt-row-menu">${i('more')}</button></td>
      </tr>
      <tr class="dd-data-table__detail" id="dt-${id}"${open ? '' : ' hidden'}>
        <td colspan="13"><div class="dd-data-table__detail-body">
          <dl class="dd-data-table__facts">
            <div><dt>Last deploy</dt><dd><span class="dd-mono">${sha}</span> · ${msg}</dd></div>
            <div><dt>Instances</dt><dd class="dd-mono">${s === 'bad' ? '0 / 3' : n % 2 ? '6 / 6' : '3 / 3'}</dd></div>
            <div><dt>Uptime (30d)</dt><dd class="dd-mono">${s === 'bad' ? '97.12%' : s === 'warn' ? '99.71%' : '99.99%'}</dd></div>
            <div><dt>Endpoint</dt><dd class="dd-mono">${name}.${region}.cxkw.dev</dd></div>
          </dl>
        </div></td>
      </tr>`;
}).join('');

const head = (cols) => `<thead>
      <tr>${cols}
      </tr>
    </thead>`;

const flagship = `
<div class="dd-data-table" data-dd-data-table style="--dd-data-table-height: 460px">
  <div class="dd-data-table__toolbar">
    <label class="dd-data-table__search">${i('search')}<input type="search" placeholder="Filter services…" aria-label="Filter services" data-dd-data-table-search></label>
    <details class="dd-data-table__menu dd-data-table__menu--start">
      <summary class="dd-data-table__chip"><span>Region</span> <b data-dd-data-table-filter-label="region">all</b>${i('chevron-down')}</summary>
      <div class="dd-data-table__menu-panel">
        <p class="dd-data-table__menu-title">Region</p>
        <label><input class="dd-data-table__check" type="checkbox" data-dd-data-table-filter="region=us-east-1"> us-east-1</label>
        <label><input class="dd-data-table__check" type="checkbox" data-dd-data-table-filter="region=eu-west-2"> eu-west-2</label>
        <label><input class="dd-data-table__check" type="checkbox" data-dd-data-table-filter="region=ap-south-1"> ap-south-1</label>
      </div>
    </details>
    <button class="dd-data-table__chip" type="button" aria-pressed="false" data-dd-data-table-filter="status=warn"><span class="dd-data-table__chip-dot" style="--_c: var(--dd-warn)"></span>Degraded</button>
    <button class="dd-data-table__chip" type="button" aria-pressed="false" data-dd-data-table-filter="status=bad"><span class="dd-data-table__chip-dot" style="--_c: var(--dd-bad)"></span>Down</button>
    <div class="dd-data-table__tools">
      <span class="dd-data-table__count" data-dd-data-table-count="services">12 services</span>
      <details class="dd-data-table__menu">
        <summary class="dd-btn dd-btn--ghost dd-btn--sm">${i('layers')}<span>Columns</span></summary>
        <div class="dd-data-table__menu-panel">
          <p class="dd-data-table__menu-title">Show columns</p>
          <label><input class="dd-data-table__check" type="checkbox" data-dd-data-table-column="id" checked> ID</label>
          <label><input class="dd-data-table__check" type="checkbox" data-dd-data-table-column="region" checked> Region</label>
          <label><input class="dd-data-table__check" type="checkbox" data-dd-data-table-column="version" checked> Version</label>
          <label><input class="dd-data-table__check" type="checkbox" data-dd-data-table-column="owner"> Owner</label>
        </div>
      </details>
      <button class="dd-btn dd-btn--ghost dd-btn--sm" type="button" data-dd-toast="Export started" data-dd-toast-description="services.csv downloads when it’s ready.">${i('download')}<span>Export</span></button>
    </div>
  </div>
  <div class="dd-data-table__bulk" role="region" aria-label="Bulk actions">
    <span class="dd-data-table__bulk-count"><span data-dd-data-table-selected>2</span> selected</span>
    <button class="dd-btn dd-btn--sm" type="button" data-dd-toast="Restart queued" data-dd-toast-description="The selected services restart one instance at a time." data-dd-toast-intent="ok">${i('refresh')}<span>Restart</span></button>
    <button class="dd-btn dd-btn--sm" type="button" data-dd-toast="Traffic paused" data-dd-toast-description="The selected services stop taking new requests." data-dd-toast-intent="warn">${i('pause')}<span>Pause</span></button>
    <button class="dd-btn dd-btn--sm" type="button" data-dd-toast="Export started" data-dd-toast-description="The selected rows download as a CSV.">${i('download')}<span>Export</span></button>
    <button class="dd-btn dd-btn--sm dd-data-table__bulk-end" type="button" data-dd-data-table-clear>Clear</button>
  </div>
  <div class="dd-data-table__scroll" tabindex="0" role="region" aria-label="Services">
    <table class="dd-data-table__table">
      ${head(`
        <th class="dd-data-table__select"><input class="dd-data-table__check" type="checkbox" aria-label="Select all services"></th>
        ${sortTh('Service', 'service', 'is-frozen')}
        <th data-col="id">ID</th>
        ${sortTh('Status', 'status')}
        ${sortTh('Region', 'region')}
        <th data-col="version">Version</th>
        <th data-col="owner">Owner</th>
        ${sortTh('Req / min', 'req', 'is-num')}
        ${sortTh('Errors', 'err', 'is-num')}
        ${sortTh('p95', 'p95', 'is-num')}
        ${sortTh('CPU', 'cpu', 'is-num')}
        ${sortTh('Updated', 'at', 'is-num')}
        <th class="is-actions"><span class="dd-visually-hidden">Actions</span></th>`)}
      <tbody>${flagRows}
      <tr class="dd-data-table__empty-row" hidden>
        <td colspan="13"><div class="dd-data-table__empty">
          <span class="dd-data-table__empty-icon">${i('search')}</span>
          <p class="dd-data-table__empty-title">No services match <span data-dd-data-table-query></span></p>
          <p>Try another name or region, or clear the filters.</p>
          <div class="dd-row"><button class="dd-btn dd-btn--secondary dd-btn--sm" type="button" data-dd-data-table-reset>Clear filters</button></div>
        </div></td>
      </tr>
      </tbody>
    </table>
  </div>
  <div class="dd-data-table__footer" data-dd-pagination data-total="${services.length}">
    <label class="dd-pagination__size">Rows per page
      <span class="dd-pagination__select"><select aria-label="Rows per page"><option selected>${PAGE}</option><option>25</option><option>50</option></select>${i('chevron-down')}</span>
    </label>
    <nav class="dd-pagination dd-pagination--compact" aria-label="Pagination">
      <span class="dd-pagination__range"><b>1–${PAGE}</b> of ${services.length}</span>
      <button class="dd-pagination__step" type="button" aria-label="Previous page" aria-disabled="true">${i('chevron-left')}</button>
      <button class="dd-pagination__step" type="button" aria-label="Next page">${i('chevron-right')}</button>
    </nav>
  </div>
  <div class="dd-menu" id="dt-row-menu" role="menu" aria-label="Service actions" hidden>
    <button class="dd-menu__item" role="menuitem" type="button" data-dd-toast="Opening logs" data-dd-toast-description="The log viewer opens filtered to this service."><span class="dd-menu__body">View logs</span></button>
    <button class="dd-menu__item" role="menuitem" type="button" data-dd-toast="Restart queued" data-dd-toast-description="Instances restart one at a time." data-dd-toast-intent="ok"><span class="dd-menu__body">Restart</span></button>
    <button class="dd-menu__item" role="menuitem" type="button" data-dd-toast="Traffic paused" data-dd-toast-description="The service stops taking new requests." data-dd-toast-intent="warn"><span class="dd-menu__body">Pause traffic</span></button>
    <hr class="dd-menu__sep">
    <button class="dd-menu__item dd-menu__item--danger" role="menuitem" type="button" data-dt-remove><span class="dd-menu__body">Remove from fleet</span></button>
  </div>
</div>`;

// Grouped, numbered, read-only, compact
let last = '';
const grouped = `
<div class="dd-data-table dd-data-table--compact" data-dd-data-table>
  <div class="dd-data-table__scroll" tabindex="0" role="region" aria-label="Services by region">
    <table class="dd-data-table__table">
      ${head(`
        <th class="dd-data-table__rownum"><span class="dd-visually-hidden">Row</span></th>
        <th class="is-frozen">Service</th>
        <th>Status</th>
        ${sortTh('Req / min', 'req', 'is-num')}
        ${sortTh('p95', 'p95', 'is-num')}
        <th class="is-num">Updated</th>`)}
      <tbody>${services.map(([id, name, s, label, region, , , req, , p95, , at], n) => {
        const g = region !== last ? `
        <tr class="dd-data-table__group"><th colspan="6" scope="colgroup"><span class="dd-data-table__group-label"><b>${region}</b><span class="dd-data-table__group-count">${services.filter((r) => r[4] === region).length} services</span></span></th></tr>` : '';
        last = region;
        return `${g}
        <tr>
          <td class="dd-data-table__rownum">${n + 1}</td>
          <td class="is-frozen">${name}</td>
          <td><span class="dd-data-table__status" data-status="${s}">${label}</span></td>
          <td class="is-num">${fmt(req)}</td>
          ${p95Cell(p95)}
          <td class="is-num is-muted">${at}</td>
        </tr>`;
      }).join('')}
      </tbody>
    </table>
  </div>
</div>`;

const skelRow = (w) => `
        <tr>
          <td class="dd-data-table__select"><span class="dd-data-table__skeleton dd-data-table__skeleton--box"></span></td>
          <td class="is-frozen"><span class="dd-data-table__skeleton" style="--w: ${w}px"></span></td>
          <td><span class="dd-data-table__skeleton" style="--w: 64px"></span></td>
          <td><span class="dd-data-table__skeleton" style="--w: 72px"></span></td>
          <td class="is-num"><span class="dd-data-table__skeleton" style="--w: 48px"></span></td>
          <td class="is-num"><span class="dd-data-table__skeleton" style="--w: 40px"></span></td>
        </tr>`;
const loadHead = head(`
        <th class="dd-data-table__select"><input class="dd-data-table__check" type="checkbox" aria-label="Select all" disabled></th>
        <th class="is-frozen">Service</th>
        <th>Status</th>
        <th>Region</th>
        <th class="is-num">Req / min</th>
        <th class="is-num">p95</th>`);
const loading = `
<div class="dd-data-table">
  <div class="dd-data-table__scroll" role="region" aria-label="Services" aria-busy="true">
    <table class="dd-data-table__table">
      ${loadHead}
      <tbody>${[112, 96, 128, 84, 104].map(skelRow).join('')}
      </tbody>
    </table>
  </div>
</div>`;

const empty = `
<div class="dd-data-table" data-dd-data-table>
  <div class="dd-data-table__toolbar">
    <label class="dd-data-table__search">${i('search')}<input type="search" value="edge-proxy" aria-label="Filter services" data-dd-data-table-search></label>
    <button class="dd-data-table__chip" type="button" aria-pressed="true" data-dd-data-table-filter="region=eu-west-2" data-dd-data-table-removable aria-label="Remove filter: region eu-west-2">Region <b>eu-west-2</b>${i('x')}</button>
    <div class="dd-data-table__tools"><span class="dd-data-table__count" data-dd-data-table-count="services">0 of 3 services</span></div>
  </div>
  <div class="dd-data-table__scroll" role="region" aria-label="Services">
    <table class="dd-data-table__table">
      ${head(`
        <th class="is-frozen">Service</th>
        <th>Status</th>
        <th data-col="region">Region</th>
        <th class="is-num">Req / min</th>`)}
      <tbody>${services.slice(0, 3).map(([, name, s, label, region, , , req]) => `
        <tr><td class="is-frozen">${name}</td><td><span class="dd-data-table__status" data-status="${s}">${label}</span></td><td data-col="region">${region}</td><td class="is-num">${fmt(req)}</td></tr>`).join('')}
        <tr class="dd-data-table__empty-row">
          <td colspan="4"><div class="dd-data-table__empty">
            <span class="dd-data-table__empty-icon">${i('filter')}</span>
            <p class="dd-data-table__empty-title">No services match <span data-dd-data-table-query>“edge-proxy”</span></p>
            <p>Nothing in eu-west-2 has that name. Check the spelling or search every region.</p>
            <div class="dd-row"><button class="dd-btn dd-btn--secondary dd-btn--sm" type="button" data-dd-data-table-reset>Clear filters</button></div>
          </div></td>
        </tr>
      </tbody>
    </table>
  </div>
</div>`;

const noData = `
<div class="dd-data-table dd-data-table--card">
  <div class="dd-data-table__scroll" role="region" aria-label="Webhooks">
    <table class="dd-data-table__table">
      ${head(`
        <th class="is-frozen">Endpoint</th>
        <th>Events</th>
        <th class="is-num">Success</th>
        <th class="is-num">Last delivery</th>`)}
      <tbody>
        <tr class="dd-data-table__empty-row">
          <td colspan="4"><div class="dd-data-table__empty">
            <span class="dd-data-table__empty-icon">${i('link')}</span>
            <p class="dd-data-table__empty-title">No webhooks yet</p>
            <p>Send deploy and incident events from billing-worker to your own endpoint.</p>
            <div class="dd-row"><button class="dd-btn dd-btn--primary dd-btn--sm" type="button" data-dd-toast="Add webhook" data-dd-toast-description="In an app this opens the new-webhook form.">${i('plus')}<span>Add webhook</span></button></div>
          </div></td>
        </tr>
      </tbody>
    </table>
  </div>
</div>`;

// Height: a --fill table in a box with a set height; Created sorts by its ISO data-value, not its text.
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const when = (iso) => { const [d, t] = iso.split('T'); const [y, m, day] = d.split('-'); return `${MONTHS[+m - 1]} ${+day}${y === '2026' ? '' : `, ${y}`} · ${t}`; };
const deploys = [
  ['dpl_7Hq2xK9m', 'auth-gateway', 'ok', 'Ready', 'iad1', 18.2, '2026-10-30T09:41'],
  ['dpl_71be09Qa', 'billing-worker', 'bad', 'Failed', 'fra1', 41.0, '2026-10-30T08:12'],
  ['dpl_8f3a2cLw', 'edge-cache', 'ok', 'Ready', 'hnd1', 9.4, '2026-10-29T22:47'],
  ['dpl_5c40d1Tz', 'dockey-ui', 'info', 'Building', 'iad1', null, '2026-10-29T17:03'],
  ['dpl_2e91aaRk', 'search-indexer', 'ok', 'Ready', 'fra1', 63.5, '2026-10-28T11:55'],
  ['dpl_44c18bPe', 'ai-focus', 'ok', 'Ready', 'iad1', 22.8, '2026-10-21T06:58'],
  ['dpl_0b7e52Ns', 'notify-fanout', 'bad', 'Failed', 'fra1', 12.1, '2026-10-09T14:20'],
  ['dpl_6a3f90Cu', 'leetnode', 'ok', 'Ready', 'hnd1', 31.7, '2026-09-30T05:42'],
  ['dpl_3c71e4Vd', 'insomnia', 'ok', 'Ready', 'iad1', 15.0, '2026-09-04T16:15'],
  ['dpl_1f88d2Jb', 'image-resizer', 'muted', 'Rolled back', 'fra1', 27.3, '2026-08-17T03:02'],
  ['dpl_5e2c07Xo', 'ledger-sync', 'ok', 'Ready', 'hnd1', 19.9, '2025-12-31T23:47'],
];
const fill = `
<div style="display: flex; flex-direction: column; height: 340px">
  <div class="dd-data-table dd-data-table--compact dd-data-table--fill" data-dd-data-table>
    <div class="dd-data-table__toolbar">
      <label class="dd-data-table__search">${i('search')}<input type="search" placeholder="Filter deploys…" aria-label="Filter deploys" data-dd-data-table-search></label>
      <div class="dd-data-table__tools"><span class="dd-data-table__count" data-dd-data-table-count="deploys">${deploys.length} deploys</span></div>
    </div>
    <div class="dd-data-table__scroll" tabindex="0" role="region" aria-label="Deploys">
      <table class="dd-data-table__table">
        ${head(`
          <th class="is-frozen">Deploy</th>
          ${sortTh('Service', 'service')}
          <th>Status</th>
          <th>Region</th>
          ${sortTh('Build', 'build', 'is-num')}
          ${sortTh('Created', 'created', 'is-num')}`)}
        <tbody>${deploys.map(([id, name, s, label, region, build, at]) => `
          <tr>
            <td class="is-frozen is-mono">${id}</td>
            <td>${name}</td>
            <td><span class="dd-data-table__status" data-status="${s}">${label}</span></td>
            <td class="is-muted">${region}</td>
            <td class="is-num">${build === null ? dash : `${build.toFixed(1)}<span class="dd-data-table__unit">s</span>`}</td>
            <td class="is-num is-muted" data-value="${at}">${when(at)}</td>
          </tr>`).join('')}
        </tbody>
      </table>
    </div>
  </div>
</div>`;
---
<Docs title="Data table" group="Data display" lead="The dense table for large data sets: search and filter, sort, select in bulk, expand a row for detail, and scroll wide data with the header and first column pinned." wide>
  <Example
    title="Hairline"
    description="Toolbar, bulk actions, sticky header, frozen service column, sortable figures, selectable and expandable rows, pagination. Try it: click a header to sort (again for descending, a third time to reset), filter for “cache”, pick a region or toggle Degraded, select rows (Shift-click for a range), expand a row, open Columns, page with the arrows, scroll sideways."
    code={flagship}
    stage="pad"
  />

  <h2 id="anatomy">Anatomy</h2>
  <ul>
    <li><strong>Toolbar</strong>: search on the left, filter chips, then the row count, column toggle and table-level actions on the right. It wraps on narrow screens; search takes the first line.</li>
    <li><strong>Bulk bar</strong>: appears under the toolbar while rows are selected, in the accent tone, with the count and the actions that apply to the selection.</li>
    <li><strong>Scroll container</strong>: <code>.dd-data-table__scroll</code> scrolls both ways. The header sticks to its top; the select and first data column stick to its left and cast a soft edge once you scroll. Its height caps at <code>--dd-data-table-height</code> (default <code>70vh</code>); see <a href="#height">Height</a> to drop the cap.</li>
    <li><strong>Footer</strong>: page size and the <a href="pagination">pagination</a> range. Give it <code>data-dd-pagination</code> and the table pages its rows in the browser; leave it off when the server pages.</li>
  </ul>

  <h2 id="columns">Columns and cells</h2>
  <p>Text columns align left; figures align right in DM Mono with tabular digits (<code>.is-num</code>) so magnitudes line up. Units sit in a muted <code>.dd-data-table__unit</code>. Cells past a threshold take <code>.is-warn</code> or <code>.is-bad</code>, and status cells pair a dot with a word.</p>

  <h2 id="grouped">Grouped rows and row numbers</h2>
  <p>Group rows are a tonal band whose label stays visible while the table scrolls sideways. Sorting keeps rows inside their group. Row numbers (<code>.dd-data-table__rownum</code>) make a read-only table feel like a sheet. This one is <code>--compact</code>.</p>
  <Example code={grouped} description="Try it: sort Req / min or p95. Rows reorder inside their region; the group bands stay put." />

  <h2 id="loading">Loading</h2>
  <p>Keep the header and draw skeleton bars where values will land, with widths that vary like real data. Set <code>aria-busy="true"</code> on the region.</p>
  <Example code={loading} />

  <h2 id="empty">Empty and filtered</h2>
  <p>When filters hide everything, say so, name the query and offer to clear the filters. The behaviour fills in the query and shows <code>.dd-data-table__empty-row</code> for you.</p>
  <Example code={empty} description="Try it: remove the region chip, then press Clear filters." />
  <p>With no data at all, explain what will appear and give the one action that creates it. <code>--card</code> puts the whole table on <code>--dd-surface</code>.</p>
  <Example code={noData} />

  <h2 id="height">Height</h2>
  <p>By default the scroll area caps at <code>70vh</code> and scrolls inside the page, so the header stays pinned while the rows scroll. In an app, where the page already scrolls, that is a scroller inside a scroller. Two ways out:</p>
  <ul>
    <li><code>style="--dd-data-table-height: none"</code> drops the cap: the table grows with its rows and the page does all the scrolling (wide tables still scroll sideways). The header then scrolls away with the page, so page the rows.</li>
    <li><code>.dd-data-table--fill</code> takes the height its parent gives it — a flex column, or a box with a set height — and the scroll area gets what the toolbar and footer leave. The table body is the only scroller and the header stays pinned. In an <a href="app-shell">app shell</a>, give the <code>.dd-app-shell__page</code> that holds it <code>height: 100%</code>, so the page fills the content area and the table fills the rest of the page.</li>
  </ul>
  <p>Inside <code>.dd-app-shell</code>, whose content area is a plain <code>--dd-bg</code>, the cells drop the page grain so the table reads as the same surface (in dusk the grain would make it a lighter, textured block). The shell does this by setting <code>--dd-data-table-grain: none</code>; set it to <code>var(--dd-grain)</code> on a shell that keeps the grained page behind it.</p>
  <Example code={fill} description="A --fill table in a 340px box. Created shows a short date but sorts by its ISO data-value, so last year’s deploy goes last; Build reads “18.2 s” as a number." />

