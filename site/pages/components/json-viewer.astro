---
import Docs from '../../layouts/Docs.astro';
import Example from '../../components/Example.astro';
import ClassTable from '../../components/ClassTable.astro';
import Guides from '../../components/Guides.astro';
import { i } from '../../lib/icon';

const deploy = {
  id: 'dpl_7Hq2xK9m',
  service: 'auth-gateway',
  region: 'us-east-1',
  status: 'healthy',
  version: '3.14.0',
  commit: {
    sha: '9f2c41e7b0d3',
    message: 'Cache JWKS for 10 minutes and retry on 429',
    author: 'andy@cxkw.dev',
  },
  timings: { queuedMs: 412, buildMs: 18240, rolloutMs: 23109, p95LatencyMs: 84.2 },
  replicas: [
    { id: 'auth-gw-1', zone: 'us-east-1a', ready: true, restarts: 0 },
    { id: 'auth-gw-2', zone: 'us-east-1b', ready: true, restarts: 1 },
    { id: 'auth-gw-3', zone: 'us-east-1c', ready: false, restarts: 4 },
  ],
  env: { NODE_ENV: 'production', LOG_LEVEL: 'info', 'jwks.ttl': 600 },
  flags: ['edge-cache', 'rate-limit-v2'],
  rollbackOf: null,
  finishedAt: '2026-10-30T09:41:07.214Z',
};

const services = [
  { name: 'auth-gateway', region: 'us-east-1', rpm: 12480, healthy: true },
  { name: 'billing-worker', region: 'us-east-1', rpm: 3212, healthy: true },
  { name: 'edge-cache', region: 'eu-west-2', rpm: 41337, healthy: true },
  { name: 'notify-fanout', region: 'eu-west-2', rpm: 0, healthy: false, lastError: 'ECONNRESET upstream smtp-relay' },
  { name: 'metrics-agg', region: 'ap-south-1', rpm: 19220, healthy: true },
];

const viewer = (data: unknown, attrs: string) =>
  `<div class="dd-json-viewer" data-dd-json-viewer ${attrs}>
  <script type="application/json">${JSON.stringify(data, null, 2)}</script>
</div>`;

const main = viewer(deploy, 'data-depth="2" aria-label="Deploy dpl_7Hq2xK9m"');
const collapsed = viewer(services, 'data-depth="1" aria-label="Services" style="--dd-json-viewer-height: 300px"');

const api = `
<figure class="dd-code">
  <figcaption class="dd-code__bar">
    <span class="dd-code__title">${i('file')}app.js</span>
    <span class="dd-code__lang">js</span>
    <button class="dd-code__copy" type="button" data-dd-copy-target="#json-api" aria-label="Copy code">${i('copy')}${i('check')}</button>
  </figcaption>
  <pre class="dd-code__pre" tabindex="0"><code id="json-api"><span class="dd-code__c">// Render any value into an element (replaces its content).</span>
<span class="dd-code__k">const</span> res = <span class="dd-code__k">await</span> <span class="dd-code__f">fetch</span>(<span class="dd-code__s">'/api/deploys/dpl_7Hq2xK9m'</span>);
dd.<span class="dd-code__f">jsonViewer</span>(document.<span class="dd-code__f">querySelector</span>(<span class="dd-code__s">'#deploy'</span>), <span class="dd-code__k">await</span> res.<span class="dd-code__f">json</span>(), { <span class="dd-code__p">depth</span>: <span class="dd-code__n">1</span> });

<span class="dd-code__c">// Viewers added to the page later: render every unrendered [data-dd-json-viewer].</span>
dd.jsonViewer.<span class="dd-code__f">init</span>();</code></pre>
</figure>`;
---
<Docs title="JSON viewer" group="Data display" lead="A collapsible tree for API responses, deploy records and config. Values keep their type colour, containers show how much they hold, and any node’s path is one click from the clipboard.">
  <Example title="Deploy record" description="Two levels open by default. Click a row to select it — the bar shows its path, ready to copy. Use the chevrons (or the arrow keys) to open and close." code={main} />

  <h2 id="collapsed">Collapsed &amp; capped</h2>
  <p><code>data-depth="1"</code> opens only the root, so long arrays read as a list of previews. Cap the height with <code>--dd-json-viewer-height</code>; the tree scrolls inside.</p>
  <Example code={collapsed} />

  <h2 id="api-render">Rendering from script</h2>
  <p>Put the JSON in an inline <code>&lt;script type="application/json"&gt;</code> and the viewer renders on load. For data you fetch at runtime, call <code>dd.jsonViewer</code>.</p>
  <div set:html={api} />

  <h2 id="api">Classes</h2>
  <ClassTable rows={[
    ['.dd-json-viewer', 'Container on a tonal surface. Add <code>data-dd-json-viewer</code> to render from its JSON script.'],
    ['.dd-json-viewer__bar', 'Path of the selected node (<code>__path-value</code>), a copy-path button and Expand all / Collapse all.'],
    ['.dd-json-viewer__tree', 'The <code>role="tree"</code> list. Scrolls when <code>--dd-json-viewer-height</code> is set.'],
    ['.dd-json-viewer__node', 'A <code>treeitem</code>; containers carry <code>aria-expanded</code>, the selected node <code>aria-selected</code>.'],
    ['.dd-json-viewer__row', 'One line: toggle, key or index, value / brace, preview and count.'],
    ['.dd-json-viewer__key / __index', 'An object key (<code>--dd-json-key</code>) or a muted array index.'],
    ['.dd-json-viewer__value--string / --number / --boolean / --null', 'Type colours. Override with <code>--dd-json-string</code>, <code>--dd-json-number</code>, <code>--dd-json-boolean</code>, <code>--dd-json-null</code>.'],
    ['.dd-json-viewer__count / __preview', 'Child count (“3 items”, “6 keys”) and the <code>{…}</code> shown while collapsed.'],
    ['.dd-json-viewer__group', 'Nested <code>role="group"</code> list with a faint indent guide.'],
    ['.dd-json-viewer__error', 'Shown instead of the tree when the inline JSON can’t be parsed.'],
  ]} />

  <h2 id="behaviour">Behaviour</h2>
  <ClassTable head={['Attribute / key', 'What it does']} rows={[
    ['data-dd-json-viewer', 'Renders the tree from the inline <code>&lt;script type="application/json"&gt;</code> on load.'],
    ['data-depth="2"', 'Levels open at first (root is level 0). Default 2.'],
    ['aria-label', 'Names the tree for screen readers (“Deploy dpl_7Hq2xK9m”).'],
    ['dd.jsonViewer(el, data, { depth, label })', 'Renders a value into <code>el</code>, replacing its content. <code>dd.jsonViewer.init()</code> renders viewers added later.'],
    ['Expand all / Collapse all', 'Bar buttons: open every container, or close all but the root.'],
    ['↑ / ↓', 'Previous / next visible node. Selection follows focus and updates the path.'],
    ['→ / ←', 'Expand, or move to the first child · collapse, or move to the parent.'],
    ['Enter / Space', 'Toggle the focused container.'],
    ['Home / End', 'First / last visible node.'],
  ]} />

  <h2 id="guidelines">Guidelines</h2>
  <Guides
    do={['Open just enough levels to show the shape; let people dig.', 'Cap the height in panels and drawers so the page doesn’t jump.', 'Use the copied path in docs and bug reports — it is unambiguous.']}
    dont={['Don’t use it for data people compare across records — that is a table.', 'Don’t render huge payloads unpaged; summarise or page them first.', 'Don’t hide <code>null</code> fields; their absence is information.']}
  />
</Docs>
