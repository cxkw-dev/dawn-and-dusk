---
import Docs from '../../layouts/Docs.astro';
import Example from '../../components/Example.astro';
import ClassTable from '../../components/ClassTable.astro';
import Guides from '../../components/Guides.astro';
import { i } from '../../lib/icon';
import { base } from '../../lib/nav'; // links are base-absolute: they must resolve from /x and /x/ alike

const chev = `<span class="dd-select__chevron">${i('chevron-down')}</span>`;

const native = `
<div class="dd-form__grid">
  <div class="dd-field">
    <label class="dd-field__label" for="sn-1">Region</label>
    <div class="dd-input dd-select">
      <select class="dd-input__control" id="sn-1">
        <optgroup label="Europe">
          <option value="eu-west-1" selected>eu-west-1 · Dublin</option>
          <option value="eu-central-1">eu-central-1 · Frankfurt</option>
        </optgroup>
        <optgroup label="North America">
          <option value="us-east-1">us-east-1 · N. Virginia</option>
          <option value="us-west-2">us-west-2 · Oregon</option>
        </optgroup>
      </select>
      ${chev}
    </div>
  </div>
  <div class="dd-field">
    <label class="dd-field__label" for="sn-2">Runtime</label>
    <div class="dd-input dd-select">
      <select class="dd-input__control" id="sn-2">
        <option value="" disabled selected>Choose a runtime</option>
        <option>Node 22</option>
        <option>Deno 2</option>
        <option>Bun 1.2</option>
      </select>
      ${chev}
    </div>
    <p class="dd-field__hint">Used for build and preview.</p>
  </div>
</div>`;

const nativeStates = `
<div class="dd-form__grid">
  <div class="dd-field">
    <label class="dd-field__label" for="ss-1">Log level</label>
    <div class="dd-input dd-select">
      <select class="dd-input__control" id="ss-1" aria-invalid="true" aria-describedby="ss-1-err">
        <option>trace</option><option selected>debug</option><option>info</option>
      </select>
      ${chev}
    </div>
    <p class="dd-field__error" id="ss-1-err">Debug logging is off in production.</p>
  </div>
  <div class="dd-field">
    <label class="dd-field__label" for="ss-2">Billing plan</label>
    <div class="dd-input dd-select">
      <select class="dd-input__control" id="ss-2" disabled><option>Studio</option></select>
      ${chev}
    </div>
    <p class="dd-field__hint">Only owners can change the plan.</p>
  </div>
</div>`;

type Opt = { value: string; label: string; desc?: string; meta?: string; icon?: string; selected?: boolean; disabled?: boolean };
const option = (o: Opt, id: string) => `
        <li class="dd-listbox__option" role="option" id="${id}" data-value="${o.value}" aria-selected="${o.selected ? 'true' : 'false'}"${o.disabled ? ' aria-disabled="true"' : ''}>${o.icon ? `
          <span class="dd-listbox__icon">${i(o.icon)}</span>` : ''}
          <span class="dd-listbox__text"><span class="dd-listbox__label">${o.label}</span>${o.desc ? `<span class="dd-listbox__desc">${o.desc}</span>` : ''}</span>${o.meta ? `
          <span class="dd-listbox__meta">${o.meta}</span>` : ''}
          <span class="dd-listbox__check">${i('check')}</span>
        </li>`;

const regions: [string, Opt[]][] = [
  ['Europe', [
    { value: 'eu-west-1', label: 'eu-west-1', desc: 'Dublin', meta: '18 ms', selected: true },
    { value: 'eu-central-1', label: 'eu-central-1', desc: 'Frankfurt', meta: '24 ms' },
  ]],
  ['North America', [
    { value: 'us-east-1', label: 'us-east-1', desc: 'N. Virginia', meta: '82 ms' },
    { value: 'us-west-2', label: 'us-west-2', desc: 'Oregon', meta: '141 ms' },
  ]],
  ['Asia Pacific', [
    { value: 'ap-southeast-1', label: 'ap-southeast-1', desc: 'Singapore · at capacity', meta: '190 ms', disabled: true },
  ]],
];
const regionList = (prefix: string, open: boolean) => `
      <ul class="dd-listbox" role="listbox" id="${prefix}-list" tabindex="-1" aria-labelledby="${prefix}-label"${open ? '' : ' hidden'}>${regions.map(([g, opts], gi) => `
        <li class="dd-listbox__group" role="presentation">${g}</li>${opts.map((o, oi) => option(o, `${prefix}-${gi}${oi}`)).join('')}`).join('')}
      </ul>`;

const customOpen = `
<div class="dd-field" style="max-width: 340px">
  <span class="dd-field__label" id="sc-label">Primary region</span>
  <div class="dd-select-menu is-open" data-dd-select>
    <button class="dd-input dd-select" type="button" aria-haspopup="listbox" aria-expanded="true" aria-controls="sc-list" aria-labelledby="sc-label sc-value">
      <span class="dd-input__control" id="sc-value" data-dd-select-value>eu-west-1</span>
      ${chev}
    </button>${regionList('sc', true)}
    <input type="hidden" name="region" value="eu-west-1">
  </div>
</div>`;

const envs: Opt[] = [
  { value: 'production', label: 'Production', icon: 'globe', desc: 'cxkw.dev · protected', selected: true },
  { value: 'preview', label: 'Preview', icon: 'eye', desc: 'Every pull request' },
  { value: 'development', label: 'Development', icon: 'code', desc: 'Local tunnels' },
];
const customClosed = `
<form class="dd-form" id="se-form" onsubmit="return false">
<div class="dd-form__grid">
  <div class="dd-field">
    <span class="dd-field__label" id="se-label">Environment</span>
    <div class="dd-select-menu" data-dd-select>
      <button class="dd-input dd-select" type="button" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="se-label se-value">
        <span class="dd-input__control" id="se-value" data-dd-select-value><span class="dd-listbox__icon">${i('globe')}</span>Production</span>
        ${chev}
      </button>
      <ul class="dd-listbox" role="listbox" tabindex="-1" aria-labelledby="se-label" hidden>${envs.map((o, n) => option(o, `se-${n}`)).join('')}
      </ul>
    </div>
  </div>
  <div class="dd-field">
    <span class="dd-field__label" id="sp-label">Owner</span>
    <div class="dd-select-menu" data-dd-select>
      <button class="dd-input dd-select" type="button" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="sp-label sp-value">
        <span class="dd-input__control dd-select__placeholder" id="sp-value" data-dd-select-value>Unassigned</span>
        ${chev}
      </button>
      <ul class="dd-listbox" role="listbox" tabindex="-1" aria-labelledby="sp-label" hidden>
        <li class="dd-listbox__option" role="option" data-value="andy" aria-selected="false"><span class="dd-listbox__swatch" style="--dd-chip: var(--dd-set-7)"></span><span class="dd-listbox__text"><span class="dd-listbox__label">Andy Nguyen</span></span><span class="dd-listbox__check">${i('check')}</span></li>
        <li class="dd-listbox__option" role="option" data-value="mika" aria-selected="false"><span class="dd-listbox__swatch" style="--dd-chip: var(--dd-set-5)"></span><span class="dd-listbox__text"><span class="dd-listbox__label">Mika Kato</span></span><span class="dd-listbox__check">${i('check')}</span></li>
        <li class="dd-listbox__option" role="option" data-value="jules" aria-selected="false"><span class="dd-listbox__swatch" style="--dd-chip: var(--dd-set-1)"></span><span class="dd-listbox__text"><span class="dd-listbox__label">Jules Sato</span></span><span class="dd-listbox__check">${i('check')}</span></li>
      </ul>
    </div>
  </div>
  <div class="dd-field dd-form__span">
    <label class="dd-field__label" for="se-note">Escalation</label>
    <div class="dd-input"><input class="dd-input__control" id="se-note" value="Page the owner if a deploy fails twice in an hour"></div>
  </div>
</div>
<div class="dd-form__footer">
  <button class="dd-btn dd-btn--ghost" type="button">Cancel</button>
  <button class="dd-btn dd-btn--primary" type="submit">Save alert rule</button>
</div>
</form>`;

const events: Opt[] = [
  { value: 'deploy-failed', label: 'Failed deploys', icon: 'error', selected: true },
  { value: 'rollback', label: 'Rollbacks', icon: 'refresh', selected: true },
  { value: 'deploy-ok', label: 'Successful deploys', icon: 'success' },
  { value: 'spend', label: 'Spend alerts', icon: 'chart' },
  { value: 'incident', label: 'Incidents', icon: 'alert', desc: 'Always on for owners', disabled: true },
];
const multiple = `
<div class="dd-field" style="max-width: 340px">
  <span class="dd-field__label" id="sm-label">Notify me about</span>
  <div class="dd-select-menu" data-dd-select>
    <button class="dd-input dd-select" type="button" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="sm-label sm-value">
      <span class="dd-input__control" id="sm-value" data-dd-select-value data-dd-placeholder="Nothing">Failed deploys, Rollbacks</span>
      ${chev}
    </button>
    <ul class="dd-listbox" role="listbox" tabindex="-1" aria-labelledby="sm-label" aria-multiselectable="true" hidden>${events.map((o, n) => option(o, `sm-${n}`)).join('')}
    </ul>
    <input type="hidden" name="notify" value="deploy-failed,rollback">
  </div>
</div>`;

const toolbar = `
<div class="dd-stack" style="--dd-gap: 10px">
<div class="dd-row">
  <div class="dd-select-menu" data-dd-select>
    <button class="dd-input dd-input--sm dd-select" type="button" aria-haspopup="listbox" aria-expanded="false" aria-label="Sort deploys" style="width: auto">
      <span class="dd-input__control" data-dd-select-value><span class="dd-listbox__icon">${i('sort')}</span>Newest first</span>
      ${chev}
    </button>
    <ul class="dd-listbox" role="listbox" tabindex="-1" aria-label="Sort deploys" hidden>
      <li class="dd-listbox__option" role="option" aria-selected="true"><span class="dd-listbox__icon">${i('sort')}</span><span class="dd-listbox__text"><span class="dd-listbox__label">Newest first</span></span><span class="dd-listbox__check">${i('check')}</span></li>
      <li class="dd-listbox__option" role="option" aria-selected="false"><span class="dd-listbox__icon">${i('clock')}</span><span class="dd-listbox__text"><span class="dd-listbox__label">Longest build</span></span><span class="dd-listbox__check">${i('check')}</span></li>
      <li class="dd-listbox__option" role="option" aria-selected="false"><span class="dd-listbox__icon">${i('error')}</span><span class="dd-listbox__text"><span class="dd-listbox__label">Failures first</span></span><span class="dd-listbox__check">${i('check')}</span></li>
    </ul>
  </div>
  <div class="dd-input dd-input--sm dd-select" style="width: auto">
    <select class="dd-input__control" aria-label="Branch"><option>main</option><option>release/2.4</option></select>
    ${chev}
  </div>
</div>
<div class="dd-table">
  <table>
    <thead><tr><th>Service</th><th>Commit</th><th class="is-num">Build</th><th class="is-num">Started</th></tr></thead>
    <tbody>
      <tr><td>billing-worker</td><td class="dd-mono">a41f9c2</td><td class="is-num">1m 12s</td><td class="is-num is-muted">4 min ago</td></tr>
      <tr><td>edge-cache</td><td class="dd-mono">9be03d7</td><td class="is-num">48s</td><td class="is-num is-muted">22 min ago</td></tr>
      <tr><td>auth-gateway</td><td class="dd-mono">17c5e80</td><td class="is-num">2m 03s</td><td class="is-num is-muted">1 h ago</td></tr>
      <tr><td>dockey-ui</td><td class="dd-mono">e2d6b11</td><td class="is-num">1m 37s</td><td class="is-num is-muted">3 h ago</td></tr>
    </tbody>
  </table>
</div>
</div>`;
---
<Docs title="Select" group="Forms" lead="Pick one option from a list. Use the native select for plain text options — it is the best picker on phones — and the custom select menu when options need icons, descriptions or metadata.">
  <Example title="Native select" description="A real <select> in the tonal box, with the label tucked in and a chevron. Option groups and placeholders work as usual." code={native} />

  <h2 id="states">States</h2>
  <p>Set <code>aria-invalid="true"</code> or <code>disabled</code> on the <code>&lt;select&gt;</code>; the box and the tucked label follow. A custom trigger takes <code>disabled</code> the same way; for the error look give it both <code>aria-invalid="true"</code> and <code>.is-invalid</code>.</p>
  <Example code={nativeStates} />

  <h2 id="custom">Custom select menu</h2>
  <p>A button that opens a <code>.dd-listbox</code>. Options can carry an icon, a colour swatch, a description and mono metadata; the chosen one shows a check and is copied into the trigger.</p>
  <Example description="Try it: open Environment and pick with the mouse, or focus Owner and press ↓, type “j”, then Enter. Save shows what was chosen." code={customClosed} />

  <h3 id="open">Open, with groups and metadata</h3>
  <p>Group labels use the menu’s small caps. Disabled options stay visible so people learn why they can’t pick them.</p>
  <Example description="Rendered open to show the anatomy; it works like the others. Try it: End skips the disabled Singapore option; type “e” twice to step through the eu- regions." code={customOpen} minHeight="520px" />

  <h3 id="multiple">Multiple</h3>
  <p>Add <code>aria-multiselectable="true"</code> to the listbox. Choosing toggles an option and keeps the list open; the trigger lists what is chosen (or its <code>data-dd-placeholder</code> when nothing is), and a hidden input gets the values joined by commas. Past a handful of options, or when people type to find them, use a multi-select <a href={`${base}/components/combobox#multi`}>combobox</a> instead.</p>
  <Example description="Try it: open the list, toggle a few with Space or a click, then Esc." code={multiple} minHeight="320px" />

  <h2 id="toolbar">In a toolbar</h2>
  <p>Without a field the trigger is button height; size it to its content with <code>width: auto</code>. The list floats over the content below.</p>
  <Example description="Try it: pick a sort order; the list floats over the table." code={toolbar} />

  <h2 id="api">Classes</h2>
  <ClassTable rows={[
    ['.dd-input.dd-select', 'Select box: native <code>&lt;select class="dd-input__control"&gt;</code> inside, or the custom trigger <code>&lt;button&gt;</code> itself.'],
    ['.dd-select__chevron', 'Trailing chevron (wrap the icon). Flips while the custom menu is open.'],
    ['.dd-select__placeholder', 'Quiet text in the trigger before anything is chosen.'],
    ['.dd-select-menu', 'Wrapper for the custom select: anchors the listbox under the trigger. <code>.is-open</code> while the list shows.'],
    ['.dd-listbox', 'Floating option list (<code>role="listbox"</code>). <code>--up</code> opens above, <code>--end</code> aligns right, <code>--static</code> renders in flow.'],
    ['.dd-listbox__option', 'An option (<code>role="option"</code>). <code>aria-selected</code> (check), <code>aria-disabled</code> (quiet, never highlights), <code>.is-active</code> (the one highlighted row — keyboard and pointer share it).'],
    ['.dd-listbox__group · __sep', 'Small-caps group label (<code>role="presentation"</code>) and hairline divider.'],
    ['.dd-listbox__icon · __swatch', 'Leading icon, or a colour dot from <code>--dd-chip</code> (e.g. <code>var(--dd-set-3)</code>).'],
    ['.dd-listbox__text · __label · __desc', 'Label stack with an optional muted description.'],
    ['.dd-listbox__meta · __check', 'Mono metadata (latency, counts) and the selected check.'],
    ['.dd-listbox__empty', 'Shown when filtering leaves nothing (combobox).'],
  ]} />

  <h2 id="behaviour">Behaviour</h2>
  <p>Add <code>data-dd-select</code> to the <code>.dd-select-menu</code>. The script wires <code>aria-expanded</code>, <code>aria-controls</code> and <code>aria-activedescendant</code>, writes the chosen label into <code>[data-dd-select-value]</code>, puts the option’s <code>data-value</code> (or its label) into an optional hidden input and fires <code>change</code> on it, and fires a bubbling <code>dd:select</code> event (and the legacy <code>dd-select</code> event) with <code>{'{ value, label, option, values, selected }'}</code> — <code>values</code> is every chosen value (one, unless the list is multiple) and <code>selected</code> says whether the option was turned on or off.</p>
  <ClassTable head={['Key', 'What it does']} rows={[
    ['Enter · Space · ↓ · ↑', 'On the trigger: open the list on the selected option (↑ opens on the last).'],
    ['Home · End', 'On the trigger: open on the first or last option.'],
    ['↑ ↓ · Home · End', 'Move through enabled options; disabled ones are skipped. Page Up / Page Down jump like Home / End.'],
    ['a–z', 'Type to jump to the option that starts with the letters; the same letter again moves to the next one. Typing on the closed trigger opens it there.'],
    ['Enter · Space', 'Choose the active option and close. In a multiple list: toggle it and stay open.'],
    ['Esc · Tab', 'Close (Esc returns focus to the trigger). Clicking outside, or focus leaving the menu, also closes it.'],
  ]} />

  <script is:inline>
    // Docs only: the alert-rule form says what it would save.
    document.getElementById('se-form')?.addEventListener('submit', () => {
      const pick = (id) => document.getElementById(id)?.textContent.trim();
      window.dd?.toast?.({ title: 'Alert rule saved', description: `${pick('se-value')} · owner: ${pick('sp-value')}`, intent: 'ok' });
    });
  </script>

  <h2 id="guidelines">Guidelines</h2>
  <Guides
    do={['Use the native select for short, plain lists — especially on mobile.', 'Order options by likelihood, or alphabetically when there is no obvious order.', 'Switch to a combobox once the list passes about 15 options.']}
    dont={['Don’t use a select for two options — use a switch or a radio group.', 'Don’t hide disabled options people expect to see; explain them in the description.', 'Don’t put actions (“Add new…”) inside a select — use a menu.']}
  />
</Docs>
