---
import Docs from '../../layouts/Docs.astro';
import Example from '../../components/Example.astro';
import ClassTable from '../../components/ClassTable.astro';
import Guides from '../../components/Guides.astro';
import { i } from '../../lib/icon';

const group = `
<fieldset class="dd-radio-group">
  <legend class="dd-radio-group__legend">Deploy strategy</legend>
  <label class="dd-radio">
    <input class="dd-radio__input" type="radio" name="strategy" checked>
    <span class="dd-radio__text"><span class="dd-radio__label">Rolling</span><span class="dd-radio__desc">Replace instances one at a time. No extra capacity.</span></span>
  </label>
  <label class="dd-radio">
    <input class="dd-radio__input" type="radio" name="strategy">
    <span class="dd-radio__text"><span class="dd-radio__label">Blue / green</span><span class="dd-radio__desc">Boot a full copy, then switch traffic at once.</span></span>
  </label>
  <label class="dd-radio">
    <input class="dd-radio__input" type="radio" name="strategy">
    <span class="dd-radio__text"><span class="dd-radio__label">Canary</span><span class="dd-radio__desc">Send 5% of traffic first and watch error rates.</span></span>
  </label>
  <label class="dd-radio">
    <input class="dd-radio__input" type="radio" name="strategy" disabled>
    <span class="dd-radio__text"><span class="dd-radio__label">Shadow</span><span class="dd-radio__desc">Mirror traffic without serving it. Team plan only.</span></span>
  </label>
</fieldset>`;

const inline = `
<fieldset class="dd-radio-group dd-radio-group--inline">
  <legend class="dd-radio-group__legend">Billing cycle</legend>
  <label class="dd-radio"><input class="dd-radio__input" type="radio" name="cycle"> Monthly</label>
  <label class="dd-radio"><input class="dd-radio__input" type="radio" name="cycle" checked> Yearly <span class="dd-muted">· two months free</span></label>
</fieldset>`;

const box = (name: string, icon: string, title: string, desc: string, meta: string, checked = false, disabled = false) => `
  <label class="dd-radio-card">
    <input class="dd-radio__input" type="radio" name="${name}"${checked ? ' checked' : ''}${disabled ? ' disabled' : ''}>
    <span class="dd-radio-card__icon">${i(icon)}</span>
    <span class="dd-radio-card__title">${title}</span>
    <span class="dd-radio-card__desc">${desc}</span>
    <span class="dd-radio-card__meta">${meta}</span>
    <span class="dd-radio-card__mark">${i('check')}</span>
  </label>`;
const cards = `
<fieldset class="dd-radio-cards">
  <legend class="dd-radio-group__legend">Plan</legend>${box('plan', 'user', 'Hobby', 'One project, community support.', '<b>$0</b> / mo')}${box('plan', 'bolt', 'Studio', 'Unlimited projects, preview deploys, 3 regions.', '<b>$24</b> / mo', true)}${box('plan', 'users', 'Team', 'Seats, audit log, SSO and every region.', '<b>$18</b> / seat / mo')}
</fieldset>`;

const row = (name: string, title: string, desc: string, meta: string, checked = false) => `
  <label class="dd-radio-card dd-radio-card--row">
    <input class="dd-radio__input" type="radio" name="${name}"${checked ? ' checked' : ''}>
    <span class="dd-radio__text"><span class="dd-radio-card__title">${title}</span><span class="dd-radio-card__desc">${desc}</span></span>
    <span class="dd-radio-card__meta">${meta}</span>
    <span class="dd-radio-card__mark">${i('check')}</span>
  </label>`;
const rows = `
<fieldset class="dd-radio-cards" style="--_min: 100%">
  <legend class="dd-radio-group__legend">Instance size for billing-worker</legend>${row('size', 'Small', '1 vCPU · 512 MiB', '$7/mo')}${row('size', 'Medium', '2 vCPU · 2 GiB', '$25/mo', true)}${row('size', 'Large', '4 vCPU · 8 GiB', '$85/mo')}
</fieldset>`;
---
<Docs title="Radio" group="Forms" lead="Picks exactly one option from a short set. A radio group lists options with descriptions; a radio box group turns each option into a selectable card.">
  <Example title="Radio group" description="A fieldset with a legend. The 8px accent dot and accent edge mark the choice; hovering anywhere on an option lifts its edge; disabled options stay readable. Try it: click an option, or Tab in and use the arrow keys (Shadow is skipped)." code={group} />

  <h2 id="inline">Inline</h2>
  <Example code={inline} />

  <h2 id="box-group">Radio box group</h2>
  <p>Selectable cards for choices that deserve weight — plans, regions, templates. The native radio is visually hidden but keeps focus, arrow keys and form submission; the chosen card tints with the accent and shows a check badge.</p>
  <Example description="Try it: click a plan, or Tab to the group and use ← →; one Tab leaves it." code={cards} />

  <h3 id="rows">Row cards</h3>
  <p><code>.dd-radio-card--row</code> puts each option on one line. Set <code>--_min: 100%</code> on the group to stack them.</p>
  <Example code={rows} />

  <h2 id="api">Classes</h2>
  <ClassTable rows={[
    ['.dd-radio', 'The <code>&lt;label&gt;</code> wrapper: control + text.'],
    ['.dd-radio__input', 'The native <code>&lt;input type="radio"&gt;</code>.'],
    ['.dd-radio__text · __label · __desc', 'Label stack with a muted description.'],
    ['.dd-radio-group', 'A <code>&lt;fieldset&gt;</code> of radios; <code>--inline</code> lays them in a row.'],
    ['.dd-radio-group__legend · __hint', 'Group legend and an optional hint under it.'],
    ['.dd-radio-cards', 'Radio box group: a responsive grid (min column <code>--_min</code>, default 11rem).'],
    ['.dd-radio-card', 'One selectable card. Holds a hidden <code>.dd-radio__input</code>.'],
    ['.dd-radio-card__icon · __title · __desc · __meta', 'Card content: icon tile (accent when chosen), title, description, mono meta (wrap a price in <code>&lt;b&gt;</code>).'],
    ['.dd-radio-card__mark', 'Check badge, shown when chosen.'],
    ['.dd-radio-card--row', 'One-line card with the mark at the end.'],
  ]} />

  <h2 id="guidelines">Guidelines</h2>
  <Guides
    do={['Use radios for 2–6 mutually exclusive options that people should compare.', 'Pre-select the safest or most common option.', 'Use cards when each option needs an explanation or a price.']}
    dont={['Don’t use radios for a single on/off choice — use a checkbox or switch.', 'Don’t mix cards and plain radios in one group.', 'Don’t hide which option is chosen behind colour alone; the check badge carries it too.']}
  />
</Docs>
