---
import Docs from '../../layouts/Docs.astro';
import Example from '../../components/Example.astro';
import ClassTable from '../../components/ClassTable.astro';
import Guides from '../../components/Guides.astro';

// The ampersand from the logo: Outfit 800 "&" traced from the font (1000-unit em, baseline at y=0, y down), plus the
// geometry the variants need. Every viewBox is the same, and ds/components/loader.css masks with the same glyph.
const A = 'M499 0L179 -353Q142 -395 125.5 -433Q109 -471 109 -516Q109 -570 137 -616.5Q165 -663 214 -692Q263 -721 328 -721Q379 -721 418.5 -706.5Q458 -692 486 -670Q514 -648 528 -625L415 -514Q396 -540 376 -551Q356 -562 332 -562Q306 -562 289 -547Q272 -532 272 -511Q272 -494 280 -479.5Q288 -465 302 -448L702 0Z';
const B = 'M272 11Q200 11 146.5 -18Q93 -47 63.5 -96.5Q34 -146 34 -207Q34 -274 68.5 -326.5Q103 -379 175 -412L248 -296Q221 -286 208 -265.5Q195 -245 195 -220Q195 -200 204.5 -183Q214 -166 232 -156Q250 -146 275 -146Q300 -146 320.5 -157.5Q341 -169 357 -194L477 -76Q461 -56 430.5 -36Q400 -16 359.5 -2.5Q319 11 272 11Z';
const OUTLINE = 'M499 0L452.2 -51.7Q442.4 -43.8 430.5 -36Q400 -16 359.5 -2.5Q319 11 272 11Q200 11 146.5 -18Q93 -47 63.5 -96.5Q34 -146 34 -207Q34 -274 68.5 -326.5Q95.5 -367.5 145.4 -396.7Q133.2 -415.3 125.5 -433Q109 -471 109 -516Q109 -570 137 -616.5Q165 -663 214 -692Q263 -721 328 -721Q379 -721 418.5 -706.5Q458 -692 486 -670Q514 -648 528 -625L415 -514Q396 -540 376 -551Q356 -562 332 -562Q306 -562 289 -547Q272 -532 272 -511Q272 -494 280 -479.5Q288 -465 302 -448L702 0Z';
const COUNTER = 'M235.7 -290.5Q217.8 -281 208 -265.5Q195 -245 195 -220Q195 -200 204.5 -183Q214 -166 232 -156Q250 -146 275 -146Q300 -146 320.5 -157.5Q331.6 -163.7 341.4 -173.9Z';
const PEN_A = 'M520 -505C511.8 -515.7 491 -548.8 471 -569C451 -589.2 423.5 -614 400 -626C376.5 -638 354.7 -642 330 -641C305.3 -640 272.8 -631.5 252 -620C231.2 -608.5 215.3 -589.8 205 -572C194.7 -554.2 190.3 -532.3 190 -513C189.7 -480 205 -440 235 -403L650 55';
const PEN_B = 'M262 -372C253.5 -369 231.3 -366.3 211 -354C190.7 -341.7 156.2 -321.5 140 -298C123.8 -274.5 114.8 -239.7 114 -213C113.2 -186.3 120.7 -159.8 135 -138C149.3 -116.2 177 -93.7 200 -82C223 -70.3 248.8 -68 273 -68C297.2 -68 321 -70.8 345 -82C369 -93.2 399.2 -120 417 -135C434.8 -150 446.2 -165.8 452 -172';
const THIN = 'M588 0L256 -335Q212 -379 191.5 -421Q171 -463 171 -509Q171 -562 193.5 -601.5Q216 -641 257 -663.5Q298 -686 351 -686Q386 -686 416 -676Q446 -666 470.5 -647.5Q495 -629 512 -601L489 -578Q464 -616 429.5 -635.5Q395 -655 352 -655Q285 -655 244 -614.5Q203 -574 203 -506Q203 -465 221 -430Q239 -395 284 -350L633 0ZM311 10Q251 10 204 -15.5Q157 -41 130 -85Q103 -129 103 -186Q103 -250 137 -304.5Q171 -359 227 -386L246 -364Q197 -342 166 -292.5Q135 -243 135 -186Q135 -138 158 -100.5Q181 -63 221 -41.5Q261 -20 312 -20Q368 -20 416 -46.5Q464 -73 489 -119L510 -98Q491 -65 460.5 -40.5Q430 -16 392 -3Q354 10 311 10Z';
const BLACK = 'M486 0L170 -349Q132 -392 116.5 -430Q101 -468 101 -513Q101 -568 129.5 -616Q158 -664 208.5 -694Q259 -724 326 -724Q380 -724 420.5 -709.5Q461 -695 489 -673.5Q517 -652 530 -631L405 -506Q387 -531 369 -539.5Q351 -548 331 -548Q309 -548 295.5 -535.5Q282 -523 282 -506Q282 -495 287.5 -483Q293 -471 304 -458L712 0ZM262 12Q190 12 136.5 -17.5Q83 -47 53.5 -97Q24 -147 24 -208Q24 -276 59 -329.5Q94 -383 167 -416L247 -284Q224 -277 213.5 -260Q203 -243 203 -224Q203 -209 210 -195Q217 -181 231 -172Q245 -163 265 -163Q282 -163 298 -171.5Q314 -180 330 -203L465 -74Q451 -56 421.5 -36Q392 -16 351 -2Q310 12 262 12Z';
const GLYPH = 'M499 0L179 -353Q142 -395 125.5 -433Q109 -471 109 -516Q109 -570 137 -616.5Q165 -663 214 -692Q263 -721 328 -721Q379 -721 418.5 -706.5Q458 -692 486 -670Q514 -648 528 -625L415 -514Q396 -540 376 -551Q356 -562 332 -562Q306 -562 289 -547Q272 -532 272 -511Q272 -494 280 -479.5Q288 -465 302 -448L702 0ZM272 11Q200 11 146.5 -18Q93 -47 63.5 -96.5Q34 -146 34 -207Q34 -274 68.5 -326.5Q103 -379 175 -412L248 -296Q221 -286 208 -265.5Q195 -245 195 -220Q195 -200 204.5 -183Q214 -166 232 -156Q250 -146 275 -146Q300 -146 320.5 -157.5Q341 -169 357 -194L477 -76Q461 -56 430.5 -36Q400 -16 359.5 -2.5Q319 11 272 11Z';
const VB = '-2 -755 740 800';
const svg = (inner: string, cls = '') => `<svg${cls ? ` class="${cls}"` : ''} viewBox="${VB}" aria-hidden="true" focusable="false">${inner}</svg>`;
const glyph = (inner = '') => `<span class="dd-loader__glyph" aria-hidden="true">${inner}</span>`;
const strokes = `<path class="dd-loader__b" d="${B}"/><path class="dd-loader__a" d="${A}"/>`;
const ease = '.45 0 .55 1';

const parts: Record<string, string> = {
  ink: glyph() + svg(`<path pathLength="1" d="${PEN_B}"/>`, 'dd-loader__b') + svg(`<path pathLength="1" d="${PEN_A}"/>`, 'dd-loader__a'),
  trace: glyph() + svg(`<path class="dd-loader__line" pathLength="1" d="${OUTLINE}"/><path class="dd-loader__line" pathLength="1" d="${COUNTER}"/>`),
  sky: glyph('<i></i>'),
  sun: `<span class="dd-loader__sky" aria-hidden="true"><i></i></span>` + glyph(),
  horizon: glyph('<i></i>'),
  weight: svg(`<path class="dd-loader__morph" d="${BLACK}"><animate attributeName="d" dur="2.56s" repeatCount="indefinite" calcMode="spline" keyTimes="0;.5;1" keySplines="${ease};${ease}" values="${BLACK};${THIN};${BLACK}"/></path>`) + glyph(),
  firefly: glyph() + svg(`<path class="dd-loader__tail" pathLength="1" d="${OUTLINE}"/><path class="dd-loader__spark" pathLength="1" d="${OUTLINE}"/>`),
  tones: svg(strokes),
  cut: glyph('<i></i>'),
  join: glyph() + svg(strokes),
};

/** Markup for one loader. Inside something that already has role="status" and a label, pass { hidden: true }. */
const loader = (v: string, { size = '', label = 'Loading', hidden = false, style = '' } = {}) =>
  `<span class="dd-loader dd-loader--${v}${size ? ` dd-loader--${size}` : ''}"${style ? ` style="${style}"` : ''} ${hidden ? 'aria-hidden="true"' : `role="status" aria-label="${label}"`}>${parts[v]}</span>`;

const variants: [string, string, string][] = [
  ['ink', 'Ink', 'Written stroke by stroke with a broad pen — the main stroke, then the bowl — then lifted away the way it was written.'],
  ['trace', 'Trace', 'An apricot line traces the outline, ink floods in behind it, then the glyph fades back to its track.'],
  ['sky', 'Sky', 'The golden-hour set drifts through the glyph along its leg: honey, apricot, rose, wine, and round to dawn again.'],
  ['sun', 'Sunrise', 'A big sun rises behind the & from the baseline and sets again. The & is cut out of it, like the logo’s second line.'],
  ['horizon', 'Horizon', 'Dawn light rises through the & from the baseline, then dusk ink rises over it, and again.'],
  ['weight', 'Breathe', 'The & breathes from Outfit Black down to Thin and back — the font’s own outlines, interpolated.'],
  ['firefly', 'Firefly', 'A small apricot light with a short tail runs round the outline of a faint &.'],
  ['tones', 'Tones', 'The & turns through all eight golden-hour colours; the bowl follows the main stroke half a beat behind.'],
  ['cut', 'Cut', 'The logo’s knocked-out gap slides through the ink &, parallel to its leg. A real cut: the page shows through.'],
  ['join', 'Join', 'The two strokes drift in from opposite corners, lock into the glyph, hold, then drift apart.'],
];

const sizes = `
<div class="dd-row" style="--dd-gap: var(--dd-space-8); align-items: flex-end">
  ${loader('sun', { size: 'sm' })}
  ${loader('sun')}
  ${loader('sun', { size: 'lg' })}
  ${loader('sun', { size: 'xl' })}
</div>`;

const colours = `
<div class="dd-row" style="--dd-gap: var(--dd-space-8); align-items: flex-end">
  ${loader('ink', { size: 'lg' })}
  ${loader('ink', { size: 'lg', style: 'color: var(--dd-muted)' })}
  ${loader('trace', { size: 'lg', style: '--dd-loader-accent: var(--dd-set-5)' })}
  ${loader('horizon', { size: 'lg', style: '--dd-loader-accent: var(--dd-set-6)' })}
</div>`;

const page = `
<div class="dd-page-loader" role="status" style="min-height: 280px">
  ${loader('sun', { size: 'xl', hidden: true })}
  <p class="dd-page-loader__label">Loading dashboard</p>
  <p class="dd-page-loader__meta">cxkw.dev · 3 regions</p>
</div>`;

const overlay = `
<div style="position: relative; min-height: 240px; padding: var(--dd-space-6)">
  <p class="dd-eyebrow">billing-worker · invoices</p>
  <p class="dd-h3" style="margin: var(--dd-space-2) 0 var(--dd-space-4)">october</p>
  <p class="dd-text dd-muted">142 invoices · $18,420.00 · 3 overdue</p>
  <p class="dd-text dd-muted">Last sync 09:41 UTC</p>
  <div class="dd-page-loader dd-page-loader--overlay" role="status">
    ${loader('sun', { size: 'lg', hidden: true })}
    <p class="dd-page-loader__label">Recalculating totals</p>
  </div>
</div>`;

const card = `
<div class="dd-card-grid">
  <article class="dd-card">
    <div class="dd-card__body">
      <p class="dd-card__eyebrow">edge-cache · fra1</p>
      <h3 class="dd-card__title">Hit rate</h3>
      <div class="dd-page-loader" role="status" style="min-height: 150px; padding: var(--dd-space-4)">
        ${loader('sun', { size: 'lg', hidden: true })}
        <p class="dd-page-loader__meta" style="margin: 0">Loading the last 24h…</p>
      </div>
    </div>
  </article>
  <article class="dd-card">
    <div class="dd-card__body">
      <p class="dd-card__eyebrow">insomnia · deploys</p>
      <h3 class="dd-card__title">Release notes</h3>
      <div class="dd-page-loader" role="status" style="min-height: 150px; padding: var(--dd-space-4)">
        ${loader('sun', { size: 'lg', hidden: true })}
        <p class="dd-page-loader__meta" style="margin: 0">Reading 12 commits…</p>
      </div>
    </div>
  </article>
</div>`;

const inline = `
<div class="dd-stack" style="--dd-gap: var(--dd-space-4)">
  <span class="dd-loading" role="status">${loader('sun', { hidden: true })}Loading deploys…</span>
  <span class="dd-loading" role="status">${loader('sun', { hidden: true })}<span>Fetching logs from <span class="dd-mono">auth-gateway</span> · iad1</span></span>
</div>`;

const fullPage = `<div class="dd-page-loader dd-page-loader--fixed" role="status">
  ${loader('sun', { size: 'xl', hidden: true })}
  <p class="dd-page-loader__label">Opening dockey-ui</p>
  <p class="dd-page-loader__meta">cxkw.dev</p>
</div>`;
---
<Docs title="Loader" group="Feedback & status" lead="The ampersand from the logo, set moving — the brand’s own way to say “loading”. The default is #4 Sunrise — a sun rising behind the &, cut out like the logo’s second line — with nine alternatives, each the real Outfit 800 & from the wordmark. Use it wherever a page or a panel waits.">
  <style is:global>
    /* docs only: the numbered picker gallery — every variant in dawn and dusk side by side */
    .ldr-gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr)); gap: var(--dd-space-3); margin: var(--dd-space-6) 0 var(--dd-space-2); }
    .ldr-tile { display: flex; flex-direction: column; margin: 0; border-radius: var(--dd-r-box); background: var(--dd-surface); overflow: hidden; }
    .ldr-tile__stages { display: grid; grid-template-columns: 1fr 1fr; }
    .ldr-stage { display: grid; place-items: center; min-height: 132px; background-color: var(--dd-bg); background-image: var(--dd-grain); background-size: var(--dd-grain-size); color: var(--dd-text); }
    .ldr-tile__cap { display: grid; gap: 4px; padding: var(--dd-space-3) var(--dd-space-4) var(--dd-space-4); }
    .ldr-tile__head { display: flex; align-items: baseline; gap: var(--dd-space-2); margin: 0; }
    .ldr-tile__num { font-family: var(--dd-font-mono); font-size: var(--dd-fs-sm); color: var(--dd-primary); }
    .ldr-tile__name { font-weight: 700; font-size: var(--dd-fs-base); color: var(--dd-text); text-decoration: none; }
    a.ldr-tile__name:hover { text-decoration: underline; text-underline-offset: 3px; }
    .ldr-tile__class { margin-left: auto; font-family: var(--dd-font-mono); font-size: var(--dd-fs-xs); color: var(--dd-quiet); }
    .ldr-tile__desc { margin: 0; font-size: var(--dd-fs-sm); line-height: 1.45; color: var(--dd-muted); }
  </style>

  <h2 id="variants">Variants</h2>
  <p>Every variant in dawn (left) and dusk (right), at <code>--lg</code>. They share one outer element and one set of sizes; only the inside differs. <strong>#4 Sunrise (<code>.dd-loader--sun</code>) is the default</strong>; reach for another only when a product needs a different mood, and use one per product.</p>
  <div class="ldr-gallery">
    {variants.map(([v, name, desc], n) => (
      <figure class="ldr-tile" data-variant={v}>
        <div class="ldr-tile__stages">
          <div class="ldr-stage" data-theme="dawn"><Fragment set:html={loader(v, { size: 'lg', label: `Loading (${name})` })} /></div>
          <div class="ldr-stage" data-theme="dusk"><Fragment set:html={loader(v, { size: 'lg', hidden: true })} /></div>
        </div>
        <figcaption class="ldr-tile__cap">
          <p class="ldr-tile__head"><span class="ldr-tile__num">#{n + 1}</span><a class="ldr-tile__name" href={`#v-${v}`}>{name}</a><code class="ldr-tile__class">--{v}</code></p>
          <p class="ldr-tile__desc">{desc}</p>
        </figcaption>
      </figure>
    ))}
  </div>

  <h2 id="markup">Markup, variant by variant</h2>
  <p>Open <b>Code</b> to copy a variant. The outer <code>.dd-loader</code> carries <code>role="status"</code> and the label; everything inside is <code>aria-hidden</code>. Sky, Sunrise, Horizon and Cut draw the glyph with a CSS mask and need no path data at all.</p>
  {variants.map(([v, name, desc], n) => (
    <div id={`v-${v}`}>
      <Example title={`#${n + 1} ${name}`} description={desc} code={`\n${loader(v, { size: 'xl' })}`} stage="center" />
    </div>
  ))}

  <h2 id="sizes">Sizes</h2>
  <p>sm 20 · md 32 (default) · lg 56 · xl 96px tall; the box is 0.925 of the height wide. Every variant takes every size, and thin lines (Trace, Firefly) thicken a little as the glyph gets smaller so they stay legible. Inside <code>.dd-page-loader</code> the default is 64px; inside <code>.dd-loading</code> it follows the text.</p>
  <Example code={sizes} stage="center" />

  <h2 id="colour">Colour</h2>
  <p>The ink is <code>currentColor</code> — <code>--dd-text</code>, like the logo — so a quieter colour on the loader or its parent works. <code>--dd-loader-accent</code> (apricot primary by default) colours Trace’s line, Horizon’s dawn and Firefly’s light; <code>--dd-loader-track</code> is the faint glyph behind Ink, Trace, Firefly and Join. Sky, Sunrise and Tones use the Golden hour set as it is.</p>
  <Example code={colours} stage="center" />

  <h2 id="page">Page and section loading</h2>
  <p>Compose with the page loader from <a href="spinner#page">Spinner</a>: the loader goes where the spinner would, the container keeps <code>role="status"</code> and the words, and the loader itself is <code>aria-hidden</code>. <code>--overlay</code> lays it over content that is being recalculated (its parent needs <code>position: relative</code>).</p>
  <Example code={page} stage="flush" />
  <Example code={overlay} stage="flush" />
  <p>For a booting app, use the same markup with <code>dd-page-loader--fixed</code> instead of <code>--overlay</code> (it covers the viewport) and an <code>--xl</code> loader. <button class="dd-btn dd-btn--secondary dd-btn--sm" type="button" data-ldr-fullpage>Show the full-page loader</button></p>
  <template id="ldr-fullpage"><Fragment set:html={fullPage} /></template>

  <h2 id="card">In a card</h2>
  <p>When one panel waits, load that panel — not the page. Centre the loader in the space the content will fill, with a line of meta saying what’s coming.</p>
  <Example code={card} />

  <h2 id="inline">Inline</h2>
  <p>Beside text in a <code>.dd-loading</code> row the glyph sizes itself to the type. For loading buttons and very small waits, the ring <a href="spinner">Spinner</a> is still the better fit.</p>
  <Example code={inline} />

  <h2 id="api">Classes</h2>
  <ClassTable rows={[
    ['.dd-loader', 'The loader, 32px tall, ink in <code>currentColor</code> (<code>--dd-text</code>). Give it <code>role="status"</code> and an <code>aria-label</code> — or <code>aria-hidden="true"</code> when it sits inside something that already has them.'],
    ['.dd-loader--ink / --trace / --sky / --sun / --horizon / --weight / --firefly / --tones / --cut / --join', 'The ten variants, #1 to #10. Each has its own inner markup — copy it from the examples above.'],
    ['.dd-loader--sm / --lg / --xl', '20 / 56 / 96px. 64px by default in <code>.dd-page-loader</code>; 1.5em in <code>.dd-loading</code>.'],
    ['.dd-loader__glyph', 'The ampersand as a window (a CSS mask): its background and children show only inside the glyph.'],
    ['.dd-loader__a / __b', 'The glyph’s two strokes — the main stroke with its leg, and the bowl — or the pen paths that write them (Ink).'],
    ['.dd-loader__line / __tail / __spark / __morph / __sky', 'Variant parts: Trace’s outline, Firefly’s tail and light, Breathe’s morphing path, Sunrise’s sky.'],
    ['--dd-loader-accent', 'Accent for Trace, Horizon and Firefly. Defaults to <code>--dd-primary</code>.'],
    ['--dd-loader-track', 'The faint glyph behind Ink, Trace, Firefly and Join. Defaults to 14% of the ink.'],
  ]} />

  <h2 id="motion">Motion</h2>
  <p>Every loop is a multiple of <code>--dd-dur</code> (2.2–3.8s) eased with <code>--dd-ease</code>, and each one ends exactly where it began, so the loop never jumps. Variants move only <code>transform</code>, <code>opacity</code>, <code>stroke-dashoffset</code> and masks, except Breathe, which morphs the path with SVG <code>&lt;animate&gt;</code> (2.56s) because CSS can’t interpolate path data in every browser. Tones animates <code>fill</code>.</p>
  <p>Under <code>prefers-reduced-motion</code> nothing travels: each variant rests on the whole glyph (Horizon in dawn light, Tones in apricot, Sunrise with the sun up behind it, Firefly with its light parked) and the loader fades slowly between full and 40% instead, so it still reads as working, never as done.</p>

  <h2 id="guidelines">Guidelines</h2>
  <Guides
    do={['Choose one variant for the product and use it everywhere a page or panel waits.', 'Say what’s loading beside it: “Loading dashboard”.', 'Wait ~300ms before showing it so fast loads don’t flash.', 'Use <code>--xl</code> for a booting app, <code>--lg</code> for a panel.']}
    dont={['Don’t mix variants in one product, or show more than one loader in a view.', 'Don’t use it inside buttons or for progress you can measure — use Spinner or Progress.', 'Don’t recolour it with status colours; it’s the brand, not a state.', 'Don’t redraw or restyle the ampersand — it’s the logo’s.']}
  />

  <script>
    // Docs only: show the fixed full-page loader for a moment.
    document.addEventListener('click', (e) => {
      const btn = (e.target as Element).closest('[data-ldr-fullpage]');
      if (!btn) return;
      const tpl = document.getElementById('ldr-fullpage') as HTMLTemplateElement;
      const node = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
      document.body.append(node);
      setTimeout(() => node.remove(), 2800);
    });
  </script>
</Docs>
