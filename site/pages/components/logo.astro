---
import Docs from '../../layouts/Docs.astro';
import Example from '../../components/Example.astro';
import ClassTable from '../../components/ClassTable.astro';
import Guides from '../../components/Guides.astro';

const oneLine = `
<span class="dd-logo dd-logo--xl">dawn &amp; dusk</span>`;

const sizes = `
<div class="dd-stack" style="--dd-gap: 22px">
  <span class="dd-logo dd-logo--2xl">dawn &amp; dusk</span>
  <span class="dd-logo dd-logo--xl">dawn &amp; dusk</span>
  <span class="dd-logo dd-logo--lg">dawn &amp; dusk</span>
  <span class="dd-logo">dawn &amp; dusk</span>
  <span class="dd-logo dd-logo--sm">dawn &amp; dusk</span>
  <span class="dd-logo dd-logo--xs">dawn &amp; dusk</span>
</div>`;

const stacked = `
<div class="dd-row" style="--dd-gap: 48px; align-items: flex-end">
  <span class="dd-logo dd-logo--stack dd-logo--2xl" role="img" aria-label="dawn &amp; dusk">
    <span class="dd-logo__line" aria-hidden="true">dawn</span>
    <span class="dd-logo__line" aria-hidden="true"><span class="dd-logo__amp">&amp;</span>dusk</span>
  </span>
  <span class="dd-logo dd-logo--stack dd-logo--lg" role="img" aria-label="dawn &amp; dusk">
    <span class="dd-logo__line" aria-hidden="true">dawn</span>
    <span class="dd-logo__line" aria-hidden="true"><span class="dd-logo__amp">&amp;</span>dusk</span>
  </span>
</div>`;

const grounds = `
<div class="logo-grounds logo-tray">
  <div class="dd-logo-block" data-theme="dawn"><span class="dd-logo dd-logo--lg">dawn &amp; dusk</span></div>
  <div class="dd-logo-block" data-theme="dusk"><span class="dd-logo dd-logo--lg">dawn &amp; dusk</span></div>
  <div class="dd-logo-block dd-logo-block--primary"><span class="dd-logo dd-logo--lg">dawn &amp; dusk</span></div>
  <div class="dd-logo-block dd-logo-block--ink">
    <span class="dd-logo dd-logo--stack dd-logo--lg" role="img" aria-label="dawn &amp; dusk">
      <span class="dd-logo__line" aria-hidden="true">dawn</span>
      <span class="dd-logo__line" aria-hidden="true"><span class="dd-logo__amp">&amp;</span>dusk</span>
    </span>
  </div>
</div>`;

const tiles = `
<div class="dd-row logo-tray" style="--dd-gap: 20px; align-items: flex-end">
  <span class="dd-logo-tile dd-logo-tile--96" role="img" aria-label="dawn &amp; dusk">d&amp;</span>
  <span class="dd-logo-tile dd-logo-tile--64" role="img" aria-label="dawn &amp; dusk">d&amp;</span>
  <span class="dd-logo-tile" role="img" aria-label="dawn &amp; dusk">d&amp;</span>
  <span class="dd-logo-tile dd-logo-tile--32" role="img" aria-label="dawn &amp; dusk">d&amp;</span>
  <span class="dd-logo-tile dd-logo-tile--24" role="img" aria-label="dawn &amp; dusk">d&amp;</span>
  <span class="dd-logo-tile dd-logo-tile--16" role="img" aria-label="dawn &amp; dusk">d&amp;</span>
  <span class="dd-logo-tile dd-logo-tile--64 dd-logo-tile--primary" role="img" aria-label="dawn &amp; dusk">d&amp;</span>
  <span class="dd-logo-tile dd-logo-tile--64 dd-logo-tile--paper" role="img" aria-label="dawn &amp; dusk">d&amp;</span>
</div>`;

const clear = `
<div class="logo-cs-wrap">
  <div class="logo-cs">
    <span class="dd-logo dd-logo--xl">dawn &amp; dusk</span>
    <span class="logo-cs-x logo-cs-t">x</span><span class="logo-cs-x logo-cs-b">x</span>
    <span class="logo-cs-x logo-cs-l">x</span><span class="logo-cs-x logo-cs-r">x</span>
  </div>
  <p class="dd-caption dd-mono">x = the height of the “a”. Keep text, edges and other marks outside the dashed line.</p>
</div>`;

const inContext = `
<div class="dd-stack" style="--dd-gap: 16px">
  <div class="logo-ctx">
    <a class="dd-logo dd-logo--sm" href="#">dawn &amp; dusk</a>
    <span class="dd-small dd-muted" style="margin-left:auto">Docs · Changelog · GitHub</span>
  </div>
  <div class="logo-ctx">
    <span class="dd-logo-tile dd-logo-tile--32" aria-hidden="true">d&amp;</span>
    <span class="dd-small"><b>dawn-and-dusk</b> <span class="dd-muted">· deployed 4m ago</span></span>
  </div>
</div>`;
---
<Docs title="Logo" group="Layout" lead="The dawn & dusk wordmark: Outfit 800, tracked in to -0.055em, always lowercase. One line is the default. The stacked lockup and the “d&” tile come from the same letters.">
  <style is:global>
    /* docs only: a tonal tray, so grounds and tiles that match the page (dawn on dawn, paper on paper) still read as shapes */
    .logo-tray { padding: var(--dd-space-2); border-radius: var(--dd-r-lg); background: var(--dd-surface); }
    .dd-row.logo-tray { padding: var(--dd-space-5); }
    .logo-grounds { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: var(--dd-space-2); }
    .logo-grounds > .dd-logo-block { min-height: 120px; }
    .logo-cs-wrap { display: flex; flex-direction: column; align-items: center; gap: 14px; }
    .logo-cs { position: relative; padding: 0.6em; font-size: 46px; border: 1px dashed var(--dd-accent);
      background: repeating-linear-gradient(45deg, color-mix(in oklab, var(--dd-accent) 14%, transparent) 0 1px, transparent 1px 7px); }
    .logo-cs .dd-logo { display: block; background: var(--dd-bg); outline: 1px dashed var(--dd-border-strong); }
    .logo-cs-x { position: absolute; font-family: var(--dd-font-mono); font-size: 11px; line-height: 1; color: var(--dd-accent); }
    .logo-cs-t { top: 7px; left: 50%; translate: -50% 0; } .logo-cs-b { bottom: 7px; left: 50%; translate: -50% 0; }
    .logo-cs-l { left: 10px; top: 50%; translate: 0 -50%; } .logo-cs-r { right: 10px; top: 50%; translate: 0 -50%; }
    .logo-ctx { display: flex; align-items: center; gap: 12px; padding: 14px 18px; border-radius: var(--dd-r-box); background: var(--dd-surface); }
  </style>

  <Example title="One line" description="The default mark. It is set in currentColor, so it follows dawn and dusk and whatever block it sits on." code={oneLine} stage="center" />

  <h2 id="sizes">Sizes</h2>
  <p>Six steps from 64px down to 15px. The top bar uses the default (22px); the docs header and email footers use <code>--sm</code>. Below 15px, switch to the tile.</p>
  <Example code={sizes} />

  <h2 id="stacked">Stacked lockup</h2>
  <p>“dawn” over “&amp; dusk”, with the second line cut out of the first by a stroke in the colour behind it. Use it where there is height to spare: covers, splash screens, the about page. On anything but the page background, set <code>--dd-logo-bg</code> (the colour blocks below do it for you).</p>
  <Example code={stacked} stage="center" />

  <h2 id="grounds">On dawn, dusk and primary</h2>
  <p>The mark never changes colour on its own — only the ground does. Scope a theme with <code>data-theme</code>, or use a colour block.</p>
  <Example code={grounds} />

  <h2 id="tile">Favicon tile</h2>
  <p>“d&amp;” in the page colour on an ink square, corners at 22%. It is the favicon, the app icon and the logo at the top of the side nav. Primary and paper versions are for social cards and light chrome.</p>
  <Example code={tiles} />

  <h2 id="clear-space">Clear space</h2>
  <p>Leave at least one <em>x</em> — the height of the lowercase “a” — on every side. At 22px that is about 11px.</p>
  <Example code={clear} stage="center" />

  <h2 id="context">In context</h2>
  <Example code={inContext} />

  <h2 id="api">Classes</h2>
  <ClassTable rows={[
    ['.dd-logo', 'The one-line wordmark. Inherits colour; works on <code>&lt;span&gt;</code> and <code>&lt;a&gt;</code>.'],
    ['.dd-logo--xs / --sm / --lg / --xl / --2xl', '15 · 18 · 32 · 46 · 64px. Default is 22px. Or set <code>--dd-logo-size</code>.'],
    ['.dd-logo--stack', 'Stacked lockup. Two <code>.dd-logo__line</code> children; wrap the ampersand in <code>.dd-logo__amp</code>. Give it <code>role="img"</code> and an <code>aria-label</code>.'],
    ['--dd-logo-bg', 'The colour of the cut-out stroke on the second line. Defaults to <code>--dd-bg</code>.'],
    ['.dd-logo--muted / --accent', 'Quieter colourways for footers and credits.'],
    ['.dd-logo-block', 'A padded block that sets the ground. <code>--surface</code>, <code>--ink</code>, <code>--primary</code>.'],
    ['.dd-logo-tile', '“d&amp;” tile, 40px. <code>--16 / --24 / --32 / --64 / --96</code>; <code>--primary</code>, <code>--paper</code>.'],
  ]} />

  <h2 id="guidelines">Guidelines</h2>
  <Guides
    do={['Write it lowercase with the ampersand: “dawn &amp; dusk”.', 'Use one line in bars and headers; save the stack for big, quiet moments.', 'Switch to the tile below 15px or when space is square.']}
    dont={['Don’t recolour the mark with status or categorical colours.', 'Don’t stretch, outline, or add effects to the letters.', 'Don’t set the wordmark in another font or open up the tracking.']}
  />
</Docs>
