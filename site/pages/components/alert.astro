---
import Docs from '../../layouts/Docs.astro';
import Example from '../../components/Example.astro';
import ClassTable from '../../components/ClassTable.astro';
import Guides from '../../components/Guides.astro';
import { i } from '../../lib/icon';

const intents = `
<div class="dd-stack">
  <div class="dd-alert dd-alert--info">
    ${i('info')}
    <div class="dd-alert__body">
      <p class="dd-alert__title">Fonts are cached for 24 hours</p>
      <p class="dd-alert__text">Changes to <code>fonts.css</code> reach visitors after the next cache refresh on edge-cache.</p>
    </div>
  </div>
  <div class="dd-alert dd-alert--ok">
    ${i('success')}
    <div class="dd-alert__body">
      <p class="dd-alert__title">Deployed to production</p>
      <p class="dd-alert__text">dawn-and-dusk v0.3 is live in fra1, sfo3 and sgp1. The build took 41s.</p>
    </div>
  </div>
  <div class="dd-alert dd-alert--warn">
    ${i('alert')}
    <div class="dd-alert__body">
      <p class="dd-alert__title">Slow build</p>
      <p class="dd-alert__text">billing-worker took 2m 14s, about twice the usual. The dependency cache missed.</p>
    </div>
  </div>
  <div class="dd-alert dd-alert--bad">
    ${i('danger')}
    <div class="dd-alert__body">
      <p class="dd-alert__title">Couldn’t reach auth-gateway</p>
      <p class="dd-alert__text">Sign-ins are failing in sfo3. We retry every 30 seconds.</p>
    </div>
  </div>
</div>`;

const actions = `
<div class="dd-stack">
  <div class="dd-alert dd-alert--warn">
    ${i('alert')}
    <div class="dd-alert__body">
      <p class="dd-alert__title">cxkw.dev renews in 3 days</p>
      <p class="dd-alert__text">Auto-renew is off. If it lapses, every project on the domain goes dark.</p>
    </div>
    <div class="dd-alert__actions">
      <button class="dd-alert__action" type="button">Renew now</button>
      <button class="dd-alert__action dd-alert__action--secondary" type="button">Remind me</button>
    </div>
    <button class="dd-alert__dismiss" type="button" data-dd-dismiss aria-label="Dismiss">${i('x')}</button>
  </div>
  <div class="dd-alert dd-alert--bad">
    ${i('danger')}
    <div class="dd-alert__body">
      <p class="dd-alert__title">Deploy failed on step 4 of 6</p>
      <p class="dd-alert__text">leetnode · <span class="dd-mono">a91f3c2</span> · migrations exited with code 1.</p>
    </div>
    <div class="dd-alert__actions">
      <button class="dd-alert__action" type="button">Retry</button>
      <a class="dd-alert__action dd-alert__action--secondary" href="#logs">View logs</a>
    </div>
    <button class="dd-alert__dismiss" type="button" data-dd-dismiss aria-label="Dismiss">${i('x')}</button>
  </div>
  <div class="dd-alert dd-alert--info">
    ${i('info')}
    <div class="dd-alert__body">
      <p class="dd-alert__title">New sign-in from Hanoi</p>
      <p class="dd-alert__text">Safari on macOS, 2 minutes ago. If it wasn’t you, sign out everywhere.</p>
    </div>
    <button class="dd-alert__dismiss" type="button" data-dd-dismiss aria-label="Dismiss">${i('x')}</button>
  </div>
</div>`;

const compact = `
<div class="dd-stack">
  <div class="dd-alert dd-alert--ok dd-alert--compact">
    ${i('success')}
    <div class="dd-alert__body"><p class="dd-alert__title">Saved.</p><p class="dd-alert__text">Changes sync in a few seconds.</p></div>
  </div>
  <div class="dd-alert dd-alert--info dd-alert--compact">
    ${i('info')}
    <div class="dd-alert__body"><p class="dd-alert__title">Read-only.</p><p class="dd-alert__text">This snapshot is from 12 Oct, 09:41 UTC.</p></div>
    <div class="dd-alert__actions"><a class="dd-alert__action" href="#latest">Open latest</a></div>
  </div>
  <div class="dd-alert dd-alert--warn dd-alert--compact">
    ${i('alert')}
    <div class="dd-alert__body"><p class="dd-alert__text">2 of 14 checks are flaky on main.</p></div>
    <button class="dd-alert__dismiss" type="button" data-dd-dismiss aria-label="Dismiss">${i('x')}</button>
  </div>
</div>`;

const list = `
<div class="dd-alert dd-alert--bad" role="alert">
  ${i('danger')}
  <div class="dd-alert__body">
    <p class="dd-alert__title">3 fields need attention</p>
    <ul>
      <li>Project name is already used by <code>dockey-ui</code>.</li>
      <li>Region must be one of fra1, sfo3 or sgp1.</li>
      <li>Build command can’t be empty.</li>
    </ul>
  </div>
</div>`;

const narrow = `
<div style="max-width: 360px">
  <div class="dd-alert dd-alert--warn">
    ${i('alert')}
    <div class="dd-alert__body">
      <p class="dd-alert__title">cxkw.dev renews in 3 days</p>
      <p class="dd-alert__text">Auto-renew is off for this domain.</p>
    </div>
    <div class="dd-alert__actions">
      <button class="dd-alert__action" type="button">Renew now</button>
      <button class="dd-alert__action dd-alert__action--secondary" type="button">Remind me</button>
    </div>
    <button class="dd-alert__dismiss" type="button" data-dd-dismiss aria-label="Dismiss">${i('x')}</button>
  </div>
</div>`;

const both = `
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--dd-space-3)">
  <div data-theme="dawn" style="background: var(--dd-bg); color: var(--dd-text); padding: var(--dd-space-4); border-radius: var(--dd-r-box)" class="dd-stack">
    <div class="dd-alert dd-alert--ok dd-alert--compact">${i('success')}<div class="dd-alert__body"><p class="dd-alert__title">Deployed</p></div></div>
    <div class="dd-alert dd-alert--bad dd-alert--compact">${i('danger')}<div class="dd-alert__body"><p class="dd-alert__title">Build failed</p></div></div>
  </div>
  <div data-theme="dusk" style="background: var(--dd-bg); color: var(--dd-text); padding: var(--dd-space-4); border-radius: var(--dd-r-box)" class="dd-stack">
    <div class="dd-alert dd-alert--ok dd-alert--compact">${i('success')}<div class="dd-alert__body"><p class="dd-alert__title">Deployed</p></div></div>
    <div class="dd-alert dd-alert--bad dd-alert--compact">${i('danger')}<div class="dd-alert__body"><p class="dd-alert__title">Build failed</p></div></div>
  </div>
</div>`;
---
<Docs title="Alert" group="Feedback & status" lead="An inline message about the thing in front of you: what happened, what it means, what to do next. A soft fill of the status colour, text actions on the right.">
  <Example title="Intents" description="Info, ok, warn and bad. The icon and the fill carry the intent; the title says what happened in a few words and the description adds the one detail that matters." code={intents} />

  <h2 id="actions">Actions and dismiss</h2>
  <p>Actions are dotted text links on the right — the first is the way forward, <code>--secondary</code> steps back. A dismiss button with <code>data-dd-dismiss</code> fades the alert out and collapses the space it took.</p>
  <Example code={actions} />

  <h2 id="compact">Compact</h2>
  <p>One line, title and text running together. For forms, panels and table toolbars where a full alert would shout.</p>
  <Example code={compact} />

  <h2 id="lists">With a list</h2>
  <p>Validation summaries and multi-part warnings can hold a short list in the body.</p>
  <Example code={list} />

  <h2 id="responsive">Narrow</h2>
  <p>The alert is its own size container. Below about 460px the actions drop under the text and line up with the title, and dismiss stays top-right — no breakpoints needed in your layout.</p>
  <Example code={narrow} />

  <h2 id="themes">Dawn and dusk</h2>
  <p>In dawn the status colour washes 14% over the page. In dusk a wash over a dark page goes muddy, so the alert becomes a solid fill — 30% status over <code>--dd-surface</code> — with no border, and the description tints toward the text colour to stay readable.</p>
  <Example code={both} />

  <h2 id="api">Classes</h2>
  <ClassTable rows={[
    ['.dd-alert', 'The container. Flex row; a size container named <code>dd-alert</code>.'],
    ['.dd-alert--{intent}', 'Intent: <code>info</code> (default) · <code>ok</code> · <code>warn</code> · <code>bad</code>.'],
    ['.dd-alert--compact', 'One line: tighter padding, title and text inline.'],
    ['> .dd-icon (or .dd-alert__icon)', 'Leading icon, centred on the first line. Info → <code>info</code>, ok → <code>success</code>, warn → <code>alert</code>, bad → <code>danger</code>.'],
    ['.dd-alert__body', 'Title and text column. Can hold a <code>&lt;ul&gt;</code>.'],
    ['.dd-alert__title / __text', 'Title (600) and description (text tinted toward the intent).'],
    ['.dd-alert__actions', 'Right-aligned actions; wrap under the text when narrow.'],
    ['.dd-alert__action', 'Dotted text action — a <code>&lt;button&gt;</code> or <code>&lt;a&gt;</code>. <code>--secondary</code> for the quieter one.'],
    ['.dd-alert__dismiss', 'Square icon button, top-right. Add <code>data-dd-dismiss</code> and an <code>aria-label</code>.'],
    ['--dd-alert-wash / -base', 'Theme-level knobs: 14% over <code>--dd-bg</code> in dawn, 30% over <code>--dd-surface</code> in dusk.'],
  ]} />

  <h2 id="behaviour">Behaviour</h2>
  <ClassTable head={['Attribute / API', 'What it does']} rows={[
    ['data-dd-dismiss', 'On a button inside an alert, banner or callout: removes it with a short fade-and-collapse (instant under reduced motion). Focus moves to the parent so keyboard users aren’t dropped at the top of the page.'],
    ['data-dd-dismiss="#id"', 'Dismisses the element the selector names instead of the enclosing one.'],
    ['dd:dismiss', 'Cancelable event fired on the alert before it goes. Call <code>preventDefault()</code> to keep it (e.g. to store the choice first).'],
    ['dd.dismiss(el)', 'Dismiss from code.'],
  ]} />
  <p>Alerts that appear while someone works should be announced: <code>role="status"</code> for info and ok, <code>role="alert"</code> for errors that need attention now. Alerts already on the page when it loads need no role.</p>

  <h2 id="guidelines">Guidelines</h2>
  <Guides
    do={['Put the alert next to what it is about — above the form, at the top of the panel.', 'Lead with what happened (“Deploy failed”), then what to do (“Retry”).', 'Keep it to one alert per area; merge related problems into a list.']}
    dont={['Don’t use an alert for success that’s already visible — a toast is enough.', 'Don’t add borders or a coloured edge; the fill is the signal.', 'Don’t hide the only way to fix a problem behind dismiss.']}
  />
</Docs>
