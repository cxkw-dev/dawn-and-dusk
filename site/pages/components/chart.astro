---
import Docs from '../../layouts/Docs.astro';
import Example from '../../components/Example.astro';
import ClassTable from '../../components/ClassTable.astro';
import Guides from '../../components/Guides.astro';
import { i } from '../../lib/icon';
const docs = import.meta.env.BASE_URL.replace(/\/$/, ''); // links are base-absolute: they must resolve from /x and /x/ alike

// The examples are static HTML/SVG generated here; the Code panel shows the output.
const r1 = (n: number) => +n.toFixed(1);
const fmt = (n: number) => n.toLocaleString('en-US');
const yAxis = (ticks: string[]) => `<div class="dd-chart__y" aria-hidden="true">${ticks.map((t) => `<span>${t}</span>`).join('')}</div>`;
const legend = (items: [string, string][], mod = '') =>
  `<ul class="dd-chart__legend">${items.map(([s, n]) => `<li class="dd-chart__key${mod} ${s}">${n}</li>`).join('')}</ul>`;
const tbody = (head: string[], rows: (string | number)[][]) => `
      <thead><tr>${head.map((h) => `<th scope="col">${h}</th>`).join('')}</tr></thead>
      <tbody>${rows.map((r) => `<tr>${r.map((c, k) => (k ? `<td>${c}</td>` : `<th scope="row">${c}</th>`)).join('')}</tr>`).join('')}</tbody>`;
const table = (caption: string, head: string[], rows: (string | number)[][]) => `
  <details class="dd-chart__data">
    <summary>View as table</summary>
    <div class="dd-chart__data-scroll"><table>
      <caption class="dd-visually-hidden">${caption}</caption>${tbody(head, rows)}
    </table></div>
  </details>`;
// Swap form: a [data-dd-chart-view] toggle in the head replaces the plot with this table.
const swapTable = (id: string, caption: string, head: string[], rows: (string | number)[][]) => `
  <div class="dd-chart__data dd-chart__data--swap" id="${id}" hidden>
    <div class="dd-chart__data-scroll" tabindex="0" role="region" aria-label="${caption}"><table>
      <caption class="dd-visually-hidden">${caption}</caption>${tbody(head, rows)}
    </table></div>
  </div>`;
const viewToggle = (id: string) =>
  `<button class="dd-btn dd-btn--ghost dd-btn--sm" type="button" data-dd-chart-view aria-controls="${id}" aria-pressed="false">${i('list')}<span>Table</span></button>`;

/* ---------- grouped columns ---------- */
const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
const dates = ['Oct 20', 'Oct 21', 'Oct 22', 'Oct 23', 'Oct 24', 'Oct 25', 'Oct 26'];
const builds: [string, string, number[]][] = [
  ['dd-chart-s1', 'dawn-and-dusk', [42, 58, 35, 66, 51, 18, 12]],
  ['dd-chart-s2', 'dockey-ui', [31, 40, 44, 29, 47, 9, 6]],
];
const barMax = 80;
const grouped = `
<figure class="dd-chart" data-dd-chart>
  <figcaption class="dd-chart__head">
    <div><p class="dd-chart__title">Build minutes per day</p><p class="dd-chart__sub">Last 7 days · minutes on shared runners</p></div>
    ${legend(builds.map(([s, n]) => [s, n]))}
  </figcaption>
  <div class="dd-chart__frame">
    ${yAxis(['80', '60', '40', '20', '0'])}
    <div class="dd-chart__plot" role="group" aria-label="Build minutes per day, by project">
      <div class="dd-chart__cols">${days.map((d, k) => `
        <div class="dd-chart__slot${k >= 5 ? ' is-flip' : ''}" tabindex="0" role="img" aria-label="${d} ${dates[k]}: ${builds.map(([, n, v]) => `${n} ${v[k]} min`).join(', ')}">
          ${builds.map(([s, , v]) => `<span class="dd-chart__col ${s}" style="--v:${r1((v[k] / barMax) * 100)}"></span>`).join('')}
          <div class="dd-chart__tip" aria-hidden="true"><p class="dd-chart__tip-title">${d}, ${dates[k]}</p>${builds.map(([s, n, v]) => `<p class="dd-chart__tip-row ${s}">${n}<b>${v[k]} min</b></p>`).join('')}</div>
        </div>`).join('')}
      </div>
    </div>
    <div class="dd-chart__x" aria-hidden="true">${days.map((d) => `<span>${d}</span>`).join('')}</div>
  </div>
  ${table('Build minutes per day, by project', ['Day', ...builds.map(([, n]) => n)], days.map((d, k) => [`${d} ${dates[k]}`, ...builds.map(([, , v]) => v[k])]))}
</figure>`;

/* ---------- line (two series) ---------- */
const hours = ['22:00', '23:00', '00:00', '01:00', '02:00', '03:00', '04:00', '05:00', '06:00', '07:00', '08:00', '09:00'];
const lines: [string, string, number[]][] = [
  ['dd-chart-s1', 'edge-cache', [24.1, 21.8, 18.2, 15.9, 14.7, 15.2, 17.9, 22.4, 28.6, 33.9, 38.2, 41.3]],
  ['dd-chart-s2', 'auth-gateway', [9.8, 8.7, 7.1, 6.2, 5.8, 6.0, 7.4, 9.1, 11.6, 12.9, 13.2, 12.5]],
];
const lineMax = 50;
const xOf = (k: number, n: number) => r1((k / (n - 1)) * 100);
const yOf = (v: number, max: number) => r1(100 - (v / max) * 100);
const path = (vals: number[], max: number) => vals.map((v, k) => `${k ? 'L' : 'M'}${xOf(k, vals.length)} ${yOf(v, max)}`).join(' ');
const hits = (labels: string[], series: [string, string, number[]][], max: number, unit: (v: number) => string) => `
      <div class="dd-chart__hits" style="--dd-chart-points:${labels.length}">${labels.map((h, k) => `
        <div class="dd-chart__hit${k >= labels.length * 0.6 ? ' is-flip' : ''}" style="--x:${xOf(k, labels.length)}" tabindex="0" role="img" aria-label="${h}: ${series.map(([, n, v]) => `${n} ${unit(v[k])}`).join(', ')}">
          ${series.map(([s, , v]) => `<span class="dd-chart__dot ${s}" style="--y:${yOf(v[k], max)}"></span>`).join('')}
          <div class="dd-chart__tip" aria-hidden="true"><p class="dd-chart__tip-title">${h}</p>${series.map(([s, n, v]) => `<p class="dd-chart__tip-row ${s}">${n}<b>${unit(v[k])}</b></p>`).join('')}</div>
        </div>`).join('')}
      </div>`;
const kUnit = (v: number) => `${v}K`;
const line = `
<figure class="dd-chart" data-dd-chart>
  <figcaption class="dd-chart__head">
    <div><p class="dd-chart__title">Requests / min</p><p class="dd-chart__sub">Last 12 hours · us-east-1</p></div>
    ${legend(lines.map(([s, n]) => [s, n]), ' dd-chart__key--line')}
  </figcaption>
  <div class="dd-chart__frame">
    ${yAxis(['50K', '40K', '30K', '20K', '10K', '0'])}
    <div class="dd-chart__plot" style="--dd-chart-ticks:5" role="group" aria-label="Requests per minute over the last 12 hours">
      <svg class="dd-chart__svg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        ${lines.map(([s, , v]) => `<path class="dd-chart__line ${s}" d="${path(v, lineMax)}"/>`).join('\n        ')}
      </svg>
      ${lines.map(([s, , v]) => `<span class="dd-chart__marker ${s}" style="--x:100; --y:${yOf(v[v.length - 1], lineMax)}"></span>`).join('')}
      ${hits(hours, lines, lineMax, kUnit)}
    </div>
    <div class="dd-chart__end" aria-hidden="true">${lines.map(([s, n, v]) => `<span class="${s}" style="--y:${yOf(v[v.length - 1], lineMax)}">${n} <b>${v[v.length - 1]}K</b></span>`).join('')}</div>
    <div class="dd-chart__x dd-chart__x--points" aria-hidden="true">${hours.map((h, k) => `<span${k % 3 ? ' class="is-minor"' : ''}>${h}</span>`).join('')}</div>
  </div>
  ${table('Requests per minute, last 12 hours', ['Hour', ...lines.map(([, n]) => `${n} (K/min)`)], hours.map((h, k) => [h, ...lines.map(([, , v]) => v[k])]))}
</figure>`;

/* ---------- area (single series + SLO rule) ---------- */
const p95 = [118, 112, 108, 104, 101, 99, 103, 110, 126, 141, 152, 158, 149, 214, 171, 154, 147, 151, 160, 166, 158, 149, 139, 131, 142];
const areaMax = 250;
const hourLabels = p95.map((_, k) => `${String((10 + k) % 24).padStart(2, '0')}:00`);
const areaPath = path(p95, areaMax);
const area = `
<figure class="dd-chart" data-dd-chart>
  <figcaption class="dd-chart__head">
    <div><p class="dd-chart__title">p95 latency · auth-gateway</p><p class="dd-chart__sub">Last 24 hours · milliseconds</p><p class="dd-chart__total">142 ms</p></div>
    ${viewToggle('p95-table')}
  </figcaption>
  <div class="dd-chart__frame">
    ${yAxis(['250', '200', '150', '100', '50', '0'])}
    <div class="dd-chart__plot" style="--dd-chart-ticks:5" role="group" aria-label="auth-gateway p95 latency over 24 hours, against a 200 ms SLO">
      <svg class="dd-chart__svg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <path class="dd-chart__area dd-chart-s1" d="${areaPath} L100 100 L0 100 Z"/>
        <path class="dd-chart__line dd-chart-s1" d="${areaPath}"/>
      </svg>
      <div class="dd-chart__rule" style="--y:${yOf(200, areaMax)}"><span>SLO 200 ms</span></div>
      <span class="dd-chart__marker dd-chart-s1" style="--x:100; --y:${yOf(p95[p95.length - 1], areaMax)}"></span>
      ${hits(hourLabels, [['dd-chart-s1', 'p95', p95]], areaMax, (v) => `${v} ms`)}
    </div>
    <div class="dd-chart__x dd-chart__x--points" aria-hidden="true"><span>10:00</span><span>16:00</span><span>22:00</span><span>04:00</span><span>now</span></div>
  </div>
  ${swapTable('p95-table', 'auth-gateway p95 latency by hour', ['Hour', 'p95 (ms)'], hourLabels.map((h, k) => [h, p95[k]]))}
</figure>`;

/* ---------- horizontal bars ---------- */
const services: [string, number][] = [
  ['edge-cache', 41337], ['metrics-agg', 19220], ['auth-gateway', 12480], ['search-indexer', 8904], ['image-resizer', 6502], ['billing-worker', 3212],
];
const hmax = services[0][1];
const hbars = `
<figure class="dd-chart" data-dd-chart>
  <figcaption class="dd-chart__head">
    <div><p class="dd-chart__title">Busiest services</p><p class="dd-chart__sub">Requests / min · now · top 6 of 24</p></div>
  </figcaption>
  <ul class="dd-chart__hbars">${services.map(([n, v]) => `
    <li class="dd-chart__hbar dd-chart-s1"><span class="dd-chart__hbar-label">${n}</span><span class="dd-chart__hbar-track"><span class="dd-chart__hbar-fill" style="--v:${r1((v / hmax) * 100)}"></span></span><span class="dd-chart__hbar-value">${fmt(v)}</span></li>`).join('')}
  </ul>
</figure>`;

/* ---------- stacked columns ---------- */
const regions: [string, string, number[]][] = [
  ['dd-chart-s1', 'us-east-1', [42, 45, 44, 48, 46, 31, 28]],
  ['dd-chart-s2', 'eu-west-2', [18, 19, 21, 20, 22, 12, 10]],
  ['dd-chart-s3', 'ap-south-1', [11, 12, 12, 13, 14, 9, 8]],
];
const stackMax = 100;
const stacked = `
<figure class="dd-chart" data-dd-chart>
  <figcaption class="dd-chart__head">
    <div><p class="dd-chart__title">Requests by region</p><p class="dd-chart__sub">Last 7 days · millions</p></div>
    ${legend(regions.map(([s, n]) => [s, n]))}
  </figcaption>
  <div class="dd-chart__frame">
    ${yAxis(['100M', '75M', '50M', '25M', '0'])}
    <div class="dd-chart__plot" role="group" aria-label="Requests per day, stacked by region">
      <div class="dd-chart__cols">${days.map((d, k) => {
        const total = regions.reduce((a, [, , v]) => a + v[k], 0);
        return `
        <div class="dd-chart__slot${k >= 5 ? ' is-flip' : ''}" tabindex="0" role="img" aria-label="${d}: ${regions.map(([, n, v]) => `${n} ${v[k]}M`).join(', ')}; total ${total}M">
          <span class="dd-chart__stackcol" style="--v:${r1((total / stackMax) * 100)}">${regions.map(([s, , v]) => `<span class="${s}" style="--v:${v[k]}"></span>`).join('')}</span>
          <div class="dd-chart__tip" aria-hidden="true"><p class="dd-chart__tip-title">${d}, ${dates[k]}</p>${regions.map(([s, n, v]) => `<p class="dd-chart__tip-row ${s}">${n}<b>${v[k]}M</b></p>`).join('')}<p class="dd-chart__tip-row dd-chart__tip-row--total">Total<b>${total}M</b></p></div>
        </div>`;
      }).join('')}
      </div>
    </div>
    <div class="dd-chart__x" aria-hidden="true">${days.map((d) => `<span>${d}</span>`).join('')}</div>
  </div>
</figure>`;

/* ---------- 100% stacked bar ---------- */
const storage: [string, string, number][] = [
  ['dd-chart-s1', 'dawn-and-dusk', 5.4], ['dd-chart-s2', 'dockey-ui', 3.1], ['dd-chart-s3', 'insomnia', 2.2], ['dd-chart-other', 'Other (4)', 1.7],
];
const storageTotal = storage.reduce((a, [, , v]) => a + v, 0);
const pct = (v: number, t: number) => Math.round((v / t) * 100);
const minutes: [string, string, number][] = [
  ['dd-chart-s1', 'dawn-and-dusk', 1248], ['dd-chart-s2', 'dockey-ui', 716], ['dd-chart-s3', 'insomnia', 291], ['dd-chart-s4', 'ai-focus', 142],
];
const minutesTotal = minutes.reduce((a, [, , v]) => a + v, 0);
const share = `
<div class="dd-stack" style="--dd-gap: 20px">
  <figure class="dd-chart" data-dd-chart>
    <figcaption class="dd-chart__head">
      <div><p class="dd-chart__title">Storage by project</p><p class="dd-chart__sub">${storageTotal.toFixed(1)} TB across 7 projects</p></div>
      ${legend(storage.map(([s, n]) => [s, n]))}
    </figcaption>
    <div class="dd-chart__stack" role="group" aria-label="Storage by project">
      ${storage.map(([s, n, v]) => `<span class="dd-chart__seg ${s}${pct(v, storageTotal) < 14 ? ' is-quiet' : ''}" style="--v:${v}" tabindex="0" role="img" aria-label="${n} ${v} TB, ${pct(v, storageTotal)}%" data-dd-chart-label="${n}" data-dd-chart-value="${v} TB · ${pct(v, storageTotal)}%">${pct(v, storageTotal)}%</span>`).join('\n      ')}
    </div>
  </figure>
  <figure class="dd-chart" data-dd-chart>
    <figcaption class="dd-chart__head">
      <div><p class="dd-chart__title">Build minutes · October</p><p class="dd-chart__sub">${fmt(minutesTotal)} of 3,000 included minutes</p></div>
    </figcaption>
    <div class="dd-chart__stack dd-chart__stack--thin" role="group" aria-label="Build minutes by project">
      ${minutes.map(([s, n, v]) => `<span class="dd-chart__seg ${s}" style="--v:${v}" tabindex="0" role="img" aria-label="${n} ${fmt(v)} min" data-dd-chart-label="${n}" data-dd-chart-value="${fmt(v)} min"></span>`).join('')}
    </div>
    <ul class="dd-chart__legend">${minutes.map(([s, n, v]) => `<li class="dd-chart__key dd-chart__key--dot ${s}">${n} <span class="dd-chart__key-value" style="padding-left:0">${fmt(v)}</span></li>`).join('')}</ul>
  </figure>
</div>`;

/* ---------- donut ---------- */
const GAP = 0.8;
let cum = 0;
const arcs = storage.map(([s, n, v]) => {
  const len = (v / storageTotal) * 100;
  const arc = `<circle class="dd-chart__arc ${s}" cx="21" cy="21" r="15.9155" pathLength="100" stroke-dasharray="${r1(len - GAP)} ${r1(100 - len + GAP)}" stroke-dashoffset="${r1(-(cum + GAP / 2))}" tabindex="0" role="img" aria-label="${n} ${v} TB, ${pct(v, storageTotal)}%" data-dd-chart-label="${n}" data-dd-chart-value="${v} TB · ${pct(v, storageTotal)}%"></circle>`;
  cum += len;
  return arc;
});
const donut = `
<figure class="dd-chart" data-dd-chart>
  <figcaption class="dd-chart__head">
    <div><p class="dd-chart__title">Storage by project</p><p class="dd-chart__sub">Object storage · all regions</p></div>
  </figcaption>
  <div class="dd-chart__pie">
    <div class="dd-chart__donut" role="group" aria-label="Storage by project, ${storageTotal.toFixed(1)} TB total">
      <svg viewBox="0 0 42 42" role="none">
        ${arcs.join('\n        ')}
      </svg>
      <div class="dd-chart__donut-center" aria-hidden="true"><b>${storageTotal.toFixed(1)} TB</b><span>stored</span></div>
    </div>
    <ul class="dd-chart__legend dd-chart__legend--stack">${storage.map(([s, n, v]) => `
      <li class="dd-chart__key ${s}">${n}<span class="dd-chart__key-value">${v} TB</span><span class="dd-chart__key-share">${pct(v, storageTotal)}%</span></li>`).join('')}
    </ul>
  </div>
</figure>`;

/* ---------- legends ---------- */
const legends = `
<div class="dd-stack" style="--dd-gap: 25px">
  ${legend(regions.map(([s, n]) => [s, n]))}
  ${legend([['dd-chart-s1', 'This week'], ['dd-chart-other', 'Last week']], ' dd-chart__key--line')}
  ${legend([['dd-chart-s1', 'dawn-and-dusk'], ['dd-chart-s2', 'dockey-ui'], ['dd-chart-s3', 'insomnia'], ['dd-chart-s4', 'ai-focus']], ' dd-chart__key--dot')}
  <ul class="dd-chart__legend dd-chart__legend--stack" style="max-width: 320px">
    <li class="dd-chart__key dd-chart-s1">us-east-1<span class="dd-chart__key-value">276M</span><span class="dd-chart__key-share">58%</span></li>
    <li class="dd-chart__key dd-chart-s2">eu-west-2<span class="dd-chart__key-value">122M</span><span class="dd-chart__key-share">26%</span></li>
    <li class="dd-chart__key dd-chart-s3">ap-south-1<span class="dd-chart__key-value">79M</span><span class="dd-chart__key-share">16%</span></li>
  </ul>
</div>`;

/* ---------- tooltip ---------- */
const tooltip = `
<div class="dd-row" style="--dd-gap: 20px; align-items: flex-start">
  <div class="dd-chart__tip is-static">
    <p class="dd-chart__tip-title">Thu, Oct 23 · 14:00</p>
    <p class="dd-chart__tip-row dd-chart-s1">us-east-1<b>48M</b></p>
    <p class="dd-chart__tip-row dd-chart-s2">eu-west-2<b>20M</b></p>
    <p class="dd-chart__tip-row dd-chart-s3">ap-south-1<b>13M</b></p>
    <p class="dd-chart__tip-row dd-chart__tip-row--total">Total<b>81M</b></p>
  </div>
  <div class="dd-chart__tip is-static">
    <p class="dd-chart__tip-title">06:00</p>
    <p class="dd-chart__tip-row dd-chart-s1">p95<b>126 ms</b></p>
  </div>
</div>`;

/* ---------- empty ---------- */
const empty = `
<figure class="dd-chart" data-dd-chart>
  <figcaption class="dd-chart__head">
    <div><p class="dd-chart__title">Cache hit ratio · edge-cache</p><p class="dd-chart__sub">ap-south-1 · last 7 days</p></div>
  </figcaption>
  <div class="dd-chart__frame">
    <div class="dd-chart__plot is-empty">
      <div class="dd-chart__empty">${i('chart')}<b>No data for this range</b><span>edge-cache hasn’t reported metrics from ap-south-1 since Oct 24.</span><button class="dd-btn dd-btn--secondary dd-btn--sm" type="button" data-dd-toast="Range picker opens here" data-dd-toast-description="Pick dates before Oct 24 to see edge-cache’s last ap-south-1 metrics.">${i('calendar')}<span>Change range</span></button></div>
    </div>
    <div class="dd-chart__x" aria-hidden="true">${days.map((d) => `<span>${d}</span>`).join('')}</div>
  </div>
</figure>`;

/* ---------- colour order ---------- */
const ORDER: [string, string, string][] = [
  ['dd-chart-s1', '1', 'terracotta · set-4'], ['dd-chart-s2', '2', 'honey · set-1'], ['dd-chart-s3', '3', 'wine · set-6'], ['dd-chart-s4', '4', 'rose · set-5'],
  ['dd-chart-s5', '5', 'sand · set-8'], ['dd-chart-s6', '6', 'ochre · set-7'], ['dd-chart-s7', '7', 'apricot · set-3'], ['dd-chart-s8', '8', 'amber · set-2'],
  ['dd-chart-other', 'other', 'tone-2'],
];
const order = `
<div class="dd-stack" style="--dd-gap: 15px">
  <div class="dd-chart__stack" role="img" aria-label="Series colour order">${ORDER.map(([s, n]) => `<span class="dd-chart__seg ${s}" style="--v:1">${n}</span>`).join('')}</div>
  <ul class="dd-chart__legend">${ORDER.map(([s, n, name]) => `<li class="dd-chart__key ${s}"><b class="dd-mono" style="font-weight:500">${n}</b>&nbsp;${name}</li>`).join('')}</ul>
</div>`;
---
<Docs title="Chart" group="Data display" lead="Conventions for charts in dawn & dusk: recessive axes and grid, thin marks, the Golden hour series in a fixed order, and text that never wears a series colour. Static HTML and inline SVG — the same classes style SVG from D3 or any charting library.">
  <Example title="Anatomy — grouped columns" description="Title, subtitle and legend on top; y ticks in mono, solid hairline gridlines and a firmer baseline; bars ≤24px with a 4px rounded data end and 2px surface gaps. The table view carries every value. Try it: hover a day, or Tab into the plot and use ← → Home End; Esc hides the tooltip. Open “View as table”." code={grouped} />

  <h2 id="line">Line</h2>
  <p>Lines are inline SVG on a 0–100 viewBox with <code>preserveAspectRatio="none"</code>, so the plot stretches to any width while <code>vector-effect: non-scaling-stroke</code> keeps every line at 2px. Markers, crosshair and end labels are HTML positioned by <code>--x</code> / <code>--y</code> percentages, so they stay round. End labels drop out on narrow cards — the legend stays.</p>
  <Example description="Try it: hover the plot or Tab in and step through the hours with the arrow keys." code={line} />

  <h2 id="area">Area and reference rule</h2>
  <p>A single series needs no legend — the title names it. The area is the series hue as a ~14% wash under its line. A <code>.dd-chart__rule</code> marks a target or SLO; label it, don’t colour it.</p>
  <Example description="Try it: press Table in the corner to swap the plot for its data, and again to swap back." code={area} />

  <h2 id="bar-horizontal">Horizontal bars</h2>
  <p>For ranked categories with long names. Pure HTML: label, bar, value in mono. Below 460px the label moves above its bar.</p>
  <Example code={hbars} />

  <h2 id="stacked">Stacked</h2>
  <p>Stacked columns show a total and its parts over time; segments are separated by a 2px surface gap, and only the top one is rounded. The tooltip adds the total.</p>
  <Example description="Try it: hover or arrow through the days — the tooltip adds the total." code={stacked} />
  <p>A 100% bar shows one whole split into parts. The tall bar (28px) prints each share inside in dark or light ink chosen per series; parts too narrow for a label get <code>.is-quiet</code> and leave it to the legend. The thin bar (8px) is a quiet figure for cards and quotas.</p>
  <Example description="Try it: hover, tap or Tab to a segment for its name and value." code={share} />

  <h2 id="donut">Donut</h2>
  <p>SVG circles with <code>pathLength="100"</code>: each arc’s <code>stroke-dasharray</code> is its share minus a 0.8 gap, offset by the running total. Keep it to 3–4 parts plus “Other”, and always pair it with a legend that carries the values.</p>
  <Example description="Try it: hover an arc, or Tab in and use the arrow keys." code={donut} />

  <h2 id="legend">Legend</h2>
  <p>Every chart with two or more series has a legend. Keys are swatches (bars, areas), short lines (line charts) or dots (scatter, small figures); the label stays in text colour. The stacked legend adds values and shares for donuts and parts-of-a-whole.</p>
  <Example code={legends} />

  <h2 id="tooltip">Tooltip</h2>
  <p>A floating layer: <code>--dd-float-bg</code> with <code>--dd-shadow-float</code>, so it lifts off the chart card in both themes. A mono title for the x value, one row per series with a key, values right-aligned in mono, and an optional total. In charts it opens beside the hovered slot or crosshair; add <code>.is-flip</code> to open it to the left near the right edge.</p>
  <Example description="Pinned with .is-static for reference — the charts above show the same tooltip live." code={tooltip} />

  <h2 id="empty">Empty</h2>
  <p>Keep the plot height, a faint baseline and the x axis so the space still reads as a chart; drop the gridlines and say why there’s nothing, with a way forward.</p>
  <Example description="Try it: Change range gives feedback here; in an app it opens the range picker." code={empty} />

  <h2 id="colour-order">Colour order</h2>
  <p>Series take the Golden hour set in this fixed order — never cycled, never re-sorted by rank, and a series keeps its colour when filters remove its neighbours. The order was chosen by measuring separation (OKLab ΔE, normal vision plus protan and deutan simulation, in both modes) because the set is warm-only:</p>
  <ul>
    <li><b>1–2</b> are clearly distinct for everyone (ΔE ≥ 13.9). <b>1–3</b> is the comfortable maximum (≥ 8.2).</li>
    <li><b>4 series</b> (≥ 7.4) need a legend <em>and</em> direct labels or a table view.</li>
    <li><b>5 or more</b> fall below a safe distance: fold the tail into <code>.dd-chart-other</code> (tone-2), or split into small multiples.</li>
    <li>Never put apricot (7) next to amber (8) — they are nearly identical (ΔE 3.1).</li>
    <li>Honey, sand, apricot, amber, rose and ochre are below 3:1 against the dawn background: fine as fills, weak as thin lines. Prefer terracotta (1) or wine (3) for a single line, and give light series labels or a table view.</li>
  </ul>
  <Example code={order} />

  <h2 id="dusk">Dusk</h2>
  <p>Nothing changes in markup. The set tokens are lifted for dusk, so marks keep their contrast on dark surfaces; gridlines and the baseline are mixed from <code>--dd-text</code> and follow it; the 2px gaps and marker rings use the chart’s own surface (<code>--_bg</code>), so they cut cleanly in both modes. Ink inside a filled segment comes from <code>--dd-series-ink</code>: dark on every hue, except wine (3), which flips to light ink in dawn. Use “View in dusk” on any example above to compare.</p>

