---
import Docs from '../../layouts/Docs.astro';
import Example from '../../components/Example.astro';
import ClassTable from '../../components/ClassTable.astro';
import Guides from '../../components/Guides.astro';
import { Code } from 'astro:components';
import { ddTheme } from '../../lib/syntax';
import { i } from '../../lib/icon';

const x = `<button class="dd-toast__dismiss" type="button" aria-label="Dismiss notification" data-dd-dismiss>${i('x')}</button>`;

const intents = `
<div class="dd-stack" style="max-width: 400px; margin-inline: auto">
  <div class="dd-toast dd-toast--ok" data-dd-dismissible>
    ${i('success')}
    <div class="dd-toast__body"><p class="dd-toast__title">Deployed to production</p><p class="dd-toast__text">insomnia v2.8 is live in 3 regions.</p></div>
    ${x}
  </div>
  <div class="dd-toast dd-toast--info" data-dd-dismissible>
    ${i('info')}
    <div class="dd-toast__body"><p class="dd-toast__title">Invite sent</p><p class="dd-toast__text">mai@cxkw.dev can join ai-focus until Friday.</p></div>
    ${x}
  </div>
  <div class="dd-toast dd-toast--warn" data-dd-dismissible>
    ${i('alert')}
    <div class="dd-toast__body"><p class="dd-toast__title">Running low on build minutes</p><p class="dd-toast__text">312 of 3,000 left this month.</p></div>
    ${x}
  </div>
  <div class="dd-toast dd-toast--bad" role="alert" data-dd-dismissible>
    ${i('danger')}
    <div class="dd-toast__body"><p class="dd-toast__title">Couldn’t save</p><p class="dd-toast__text">edge-cache answered 503. Your changes are still here.</p></div>
    ${x}
  </div>
</div>`;

const actions = `
<div class="dd-stack" style="max-width: 400px; margin-inline: auto">
  <div class="dd-toast dd-toast--ok" data-dd-dismissible>
    ${i('success')}
    <div class="dd-toast__body"><p class="dd-toast__title">Post archived</p></div>
    <div class="dd-toast__actions"><button class="dd-toast__action" type="button" data-dd-dismiss data-dd-toast="Post restored" data-dd-toast-intent="neutral" data-dd-toast-duration="3000">Undo</button></div>
    ${x}
  </div>
  <div class="dd-toast dd-toast--neutral" data-dd-dismissible>
    ${i('trash')}
    <div class="dd-toast__body"><p class="dd-toast__title">3 previews deleted</p><p class="dd-toast__text">dockey-ui · pr-41, pr-44, pr-45</p></div>
    <div class="dd-toast__actions"><button class="dd-toast__action" type="button" data-dd-dismiss data-dd-toast="3 previews restored" data-dd-toast-intent="neutral" data-dd-toast-duration="3000">Undo</button></div>
    ${x}
    <span class="dd-toast__progress" aria-hidden="true" style="transform: scaleX(.62)"></span>
  </div>
</div>`;

const live = `
<div class="dd-row">
  <button class="dd-btn dd-btn--primary" type="button" data-dd-toast="Deployed to production" data-dd-toast-description="leetnode v1.4 is live in fra1, sfo3 and sgp1." data-dd-toast-intent="ok">${i('upload')}<span>Deploy</span></button>
  <button class="dd-btn" type="button" data-dd-toast="Invite sent" data-dd-toast-description="mai@cxkw.dev can join ai-focus until Friday." data-dd-toast-intent="info">${i('mail')}<span>Invite</span></button>
  <button class="dd-btn" type="button" data-dd-toast="Running low on build minutes" data-dd-toast-description="312 of 3,000 left this month." data-dd-toast-intent="warn">${i('clock')}<span>Check usage</span></button>
  <button class="dd-btn" type="button" data-dd-toast="Link copied" data-dd-toast-intent="neutral" data-dd-toast-duration="3000">${i('link')}<span>Copy link</span></button>
  <button class="dd-btn" type="button" data-dd-toast="Couldn’t reach billing-worker" data-dd-toast-description="The request timed out after 30s." data-dd-toast-intent="bad" data-dd-toast-duration="0">${i('refresh')}<span>Sync invoices</span></button>
  <button class="dd-btn dd-btn--ghost" type="button" onclick="dd.toast({ title: 'Post archived', intent: 'ok', action: { label: 'Undo', onClick: () => dd.toast({ title: 'Post restored', intent: 'neutral', duration: 3000 }) } })">${i('archive')}<span>Archive post</span></button>
</div>`;

const api = `// Anywhere after dawn-and-dusk.js has loaded:
dd.toast('Saved');                      // title only, info, 5s

const t = dd.toast({
  title: 'Post archived',
  description: 'Moved out of the feed on cxkw.dev.',
  intent: 'ok',                         // info · ok · warn · bad · neutral
  action: { label: 'Undo', onClick: () => restore(post) },
  duration: 8000,                       // ms; 0 stays until dismissed
});

t.dismiss();                            // close it early
dd.toast.clear();                       // close them all`;
---
<Docs title="Toast" group="Feedback & status" lead="A short confirmation that something happened, out of the way at the bottom-right. It leaves on its own, waits while you hover, and offers one action — usually undo.">
  <Example title="Intents" description="Ok for done, info for news, warn for a heads-up, bad for a failure the person should know about. The intent tints the icon and the timer line; the toast itself stays an ink slab in dawn and a raised dark surface in dusk. These sit in the page so you can compare them (× still works); raise live ones under Try it." code={intents} stage="center" />

  <h2 id="actions">Action and undo</h2>
  <p>One action, a verb the person might want right now — almost always <b>Undo</b>. The hairline along the bottom shows the time left before the toast leaves.</p>
  <Example code={actions} stage="center" description="Try it: press Undo — the toast goes and a short confirmation takes its place." />

  <h2 id="live">Try it</h2>
  <p>Toasts stack at the bottom-right, newest nearest the corner, at most four at a time. Hover or focus the stack to pause every timer; swipe one sideways to dismiss it. On small screens the stack spans the width.</p>
  <Example code={live} description="Try it: raise a few (Archive post has an Undo), hover the stack to pause it, swipe one sideways, or Tab to a toast and press Esc. Sync invoices stays until you close it." />

  <h2 id="js">JavaScript</h2>
  <p><code>dd.toast()</code> creates the stack on first use (a polite live region labelled “Notifications”), so there is nothing to put in your HTML. Text is set as text, never as HTML. The stack lives in the top layer, so a toast raised while a modal dialog is open shows above its scrim — and its action still works.</p>
  <Code code={api} lang="js" theme={ddTheme} wrap />

  <h2 id="api">Classes</h2>
  <ClassTable rows={[
    ['.dd-toaster', 'The fixed stack, bottom-right (<code>--dd-z-toast</code>). Created by the JS; add your own to control where it sits.'],
    ['.dd-toast', 'One toast. Ink in dawn, <code>--dd-float-bg</code> + <code>--dd-shadow-float</code> in dusk. Inside a <code>.dd-toaster</code> it slides in and can be swiped away.'],
    ['.dd-toast--{intent}', 'Intent: <code>info</code> · <code>ok</code> · <code>warn</code> · <code>bad</code> · <code>neutral</code>. Tints the icon and the timer line.'],
    ['> .dd-icon', 'Leading icon. The JS picks <code>info</code>, <code>success</code>, <code>alert</code>, <code>danger</code> or <code>bell</code>.'],
    ['.dd-toast__body / __title / __text', 'Title (600) and a muted description.'],
    ['.dd-toast__actions / __action', 'The single dotted text action.'],
    ['.dd-toast__dismiss', 'Close button. Needs an <code>aria-label</code>.'],
    ['.dd-toast__progress', 'Hairline timer along the bottom; animated by the JS, hidden under reduced motion.'],
    ['--dd-toast-bg / -fg / -muted', 'Theme-level colours: ink with page-coloured text in dawn, <code>--dd-float-bg</code> in dusk.'],
  ]} />

  <h2 id="behaviour">Behaviour</h2>
  <ClassTable head={['Attribute / API', 'What it does']} rows={[
    ['dd.toast(options | title)', 'Shows a toast; returns <code>{ el, dismiss() }</code>. Options: <code>title</code>, <code>description</code>, <code>intent</code> (default <code>info</code>), <code>action: { label, onClick }</code> (runs, then closes the toast), <code>duration</code> (ms, default 5000, 0 = sticky), <code>icon</code> (any sprite name), <code>dismissible</code> (<code>false</code> drops the ×).'],
    ['dd.toast.clear()', 'Dismisses every toast.'],
    ['data-dd-toast="Title"', 'Click to show a toast. Add <code>data-dd-toast-description</code>, <code>-intent</code>, <code>-action</code> (a label; the button closes the toast) and <code>-duration</code>.'],
    ['Pause', 'Hovering or focusing the stack, or switching tabs, pauses every timer.'],
    ['Stacking', 'New toasts slide in at the bottom; the ones above glide up to make room. Past four, the oldest leaves.'],
    ['Swipe', 'Drag a toast sideways (touch, pen or mouse) past a third of its width, or flick it, to dismiss it. A short drag springs back.'],
    ['Theme', 'A toast takes the dawn/dusk theme of the element that raised it.'],
    ['Keyboard', 'Tab reaches the action and the close button; focusing them pauses the timer. Esc dismisses the focused toast, and focus moves to the next toast, or back to where it was before the stack.'],
    ['Reduced motion', 'No slide, glide or swipe-out: toasts appear and leave in place, and the timer line is hidden.'],
  ]} />

  <h2 id="guidelines">Guidelines</h2>
  <Guides
    do={['Confirm what just happened in a few words: “Post archived”.', 'Offer undo instead of asking “are you sure?” for reversible actions.', 'Keep errors that need action on screen: <code>duration: 0</code>, or use an alert.']}
    dont={['Don’t put the only copy of important information in a toast — it disappears.', 'Don’t fire a toast for every background event; batch them.', 'Don’t add more than one action.']}
  />
</Docs>
