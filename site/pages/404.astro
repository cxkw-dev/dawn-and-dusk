---
import Docs from '../layouts/Docs.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Docs title="not found" group="404" lead="Nothing lives at this address. It may have moved when the docs were reorganised.">
  <div class="dd-row">
    <a class="dd-btn dd-btn--primary" href={`${base}/`}>Back to the start</a>
    <a class="dd-btn" href={`${base}/components/button`}>Browse components</a>
  </div>
</Docs>
