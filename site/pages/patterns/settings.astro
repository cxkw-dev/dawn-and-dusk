---
import Docs from '../../layouts/Docs.astro';
import Example from '../../components/Example.astro';
import Guides from '../../components/Guides.astro';
import { i } from '../../lib/icon';

const railItem = (icon: string, label: string, current = false) =>
  `<a class="dd-side-nav__item" href="#" data-label="${label}" aria-label="${label}"${current ? ' aria-current="page"' : ''}>${i(icon)}</a>`;

/* ---------- tucked-label fields (from Form field / Text input / Select) ---------- */
const chev = `<span class="dd-select__chevron">${i('chevron-down')}</span>`;
const field = (id: string, label: string, control: string, extra = '', cls = '') => `
                  <div class="dd-field${cls ? ` ${cls}` : ''}">
                    <label class="dd-field__label" for="${id}">${label}</label>
                    ${control}${extra}
                  </div>`;
const input = (id: string, attrs: string, pre = '') =>
  `<div class="dd-input">${pre}<input class="dd-input__control" id="${id}" ${attrs}></div>`;
const select = (id: string, opts: string[], sel = 0) =>
  `<div class="dd-input dd-select"><select class="dd-input__control" id="${id}">${opts.map((o, n) => `<option${n === sel ? ' selected' : ''}>${o}</option>`).join('')}</select>${chev}</div>`;

/* ---------- switches (from Switch) ---------- */
const sw = (label: string, desc: string, on: boolean) => `
                  <label class="dd-switch dd-switch--end">
                    <input class="dd-switch__input" type="checkbox" role="switch"${on ? ' checked' : ''}>
                    <span class="dd-switch__text"><span class="dd-switch__label">${label}</span><span class="dd-switch__desc">${desc}</span></span>
                  </label>`;

/* ---------- API keys (from Table) ---------- */
const keys: [string, string, string, string, string, string][] = [
  ['github-actions', '…3f9a', 'deploy:write', 'ok', 'Active', 'just now'],
  ['dockey-ui · laptop', '…8c21', 'read', 'ok', 'Active', '3 days ago'],
  ['billing-worker', '…77e0', 'invoices:write', 'warn', 'Expiring', '1 h ago'],
];

const glue = `<style>
  /* Page glue only: lays the blocks out. Every visual comes from a component. */
  .dd-pattern-settings { container: dd-pattern-settings / inline-size; }
  .dd-pattern-settings__avatar { display: flex; flex-wrap: wrap; align-items: center; gap: calc(var(--dd-u) * 4); }
  .dd-pattern-settings__avatar > .dd-dropzone { flex: 1 1 16rem; }
  @container dd-pattern-settings (min-width: 640px) {
    .dd-pattern-settings .dd-tabs--vertical > .dd-tabs__list { position: sticky; top: 0; }
  }
</style>`;

const page = `
${glue}
<div class="dd-app-shell">
  <nav class="dd-side-nav" id="settings-nav" aria-label="Main">
    <div class="dd-side-nav__rail">
      <a class="dd-side-nav__logo dd-logo-tile" href="#" aria-label="dawn &amp; dusk — home">d&amp;</a>
      ${railItem('home', 'Overview')}
      ${railItem('server', 'Services')}
      ${railItem('folder', 'Projects')}
      ${railItem('chart', 'Analytics')}
      <span class="dd-side-nav__spacer"></span>
      ${railItem('settings', 'Settings', true)}
    </div>
  </nav>

  <div class="dd-app-shell__main">
    <header class="dd-top-bar">
      <button class="dd-btn dd-btn--ghost dd-btn--icon dd-top-bar__nav-btn" type="button" data-dd-nav-open="#settings-nav" aria-controls="settings-nav" aria-expanded="false" aria-label="Open navigation">${i('menu')}</button>
      <a class="dd-top-bar__brand dd-top-bar__narrow" href="#"><span class="dd-logo dd-logo--sm">dawn &amp; dusk</span></a>
      <div class="dd-top-bar__context">
        <button class="dd-top-bar__switch" type="button"><span class="dd-top-bar__mark">cx</span><span>cxkw</span>${i('sort')}</button>
      </div>
      <button class="dd-top-bar__search" type="button" aria-label="Search">${i('search')}<span>Search settings…</span><kbd class="dd-top-bar__kbd">⌘K</kbd></button>
      <div class="dd-top-bar__actions">
        <details class="dd-top-bar__user" data-dd-autoclose>
          <summary aria-label="Account menu"><span class="dd-top-bar__avatar">AN</span></summary>
          <div class="dd-top-bar__menu">
            <div class="dd-top-bar__menu-head"><b>Andy Nguyen</b><span>andy@cxkw.dev</span></div>
            <div class="dd-top-bar__menu-sep"></div>
            <button class="dd-top-bar__menu-item" type="button" data-dd-theme-toggle>${i('moon')}Toggle dusk</button>
            <a class="dd-top-bar__menu-item" href="#">${i('logout')}Sign out</a>
          </div>
        </details>
      </div>
    </header>

    <main class="dd-app-shell__content">
      <div class="dd-app-shell__page dd-pattern-settings">
        <header class="dd-page-header">
          <div class="dd-page-header__row">
            <div class="dd-page-header__titles">
              <h1 class="dd-page-header__title">settings</h1>
              <p class="dd-page-header__desc">Your profile, how cxkw.dev reaches you, and the keys that act on your behalf.</p>
            </div>
          </div>
        </header>

        <div class="dd-tabs dd-tabs--vertical">
          <nav class="dd-tabs__list" aria-label="Settings">
            <a class="dd-tabs__tab is-active" href="#set-profile" aria-current="true">${i('user')}<span>Profile</span></a>
            <a class="dd-tabs__tab" href="#set-notifications">${i('bell')}<span>Notifications</span></a>
            <a class="dd-tabs__tab" href="#set-keys">${i('key')}<span>API keys</span><span class="dd-tabs__count">3</span></a>
            <a class="dd-tabs__tab" href="#set-danger">${i('danger')}<span>Danger zone</span></a>
          </nav>

          <div class="dd-tabs__panel">
            <div class="dd-form dd-form--divided">
              <form class="dd-form__section" id="set-profile" aria-labelledby="set-profile-title" onsubmit="return false">
                <div class="dd-form__head">
                  <h2 class="dd-form__title" id="set-profile-title">Profile</h2>
                  <p class="dd-form__desc">Shown on deploys, comments and the audit log.</p>
                </div>
                <div class="dd-pattern-settings__avatar">
                  <span class="dd-avatar dd-avatar--xl dd-avatar--set-3" role="img" aria-label="Andy Nguyen">AN</span>
                  <label class="dd-dropzone dd-dropzone--compact" data-dd-dropzone>
                    <input type="file" accept="image/*" aria-label="Upload a new avatar">
                    <span class="dd-dropzone__icon">${i('upload')}</span>
                    <span class="dd-dropzone__text">
                      <span class="dd-dropzone__title">Drop a new avatar or <span class="dd-dropzone__browse">browse</span></span>
                      <span class="dd-dropzone__meta">Square PNG or JPG, at least 256 × 256</span>
                    </span>
                  </label>
                </div>
                <div class="dd-form__grid">${field('set-name', 'Name', input('set-name', 'value="Andy Nguyen" autocomplete="name"'))}${field('set-user', 'Username', input('set-user', 'value="andy" autocomplete="username"', '<span class="dd-input__unit dd-input__prefix">cxkw.dev/</span>'))}${field('set-email', 'Email', input('set-email', 'type="email" value="andy@cxkw.dev" autocomplete="email"'), `
                    <p class="dd-field__hint">Verified · used for sign-in and alerts.</p>`)}${field('set-tz', 'Time zone', select('set-tz', ['Europe/Berlin · UTC+1', 'Europe/London · UTC+0', 'America/New_York · UTC−5', 'Asia/Singapore · UTC+8']))}
                  <div class="dd-field dd-form__span">
                    <label class="dd-field__label" for="set-bio">Bio</label>
                    <div class="dd-input dd-textarea"><textarea class="dd-input__control" id="set-bio" rows="2" maxlength="160">Builds small tools for focused work: dockey-ui, insomnia, ai-focus and leetnode.</textarea></div>
                    <div class="dd-field__foot"><p class="dd-field__hint">Shown on your public profile.</p><span class="dd-field__counter">80 / 160</span></div>
                  </div>
                </div>
                <div class="dd-form__footer">
                  <span class="dd-form__meta">${i('clock')}Last saved Oct 30, 09:41</span>
                  <button class="dd-btn dd-btn--ghost" type="reset">Discard</button>
                  <button class="dd-btn dd-btn--primary" type="submit">Save profile</button>
                </div>
              </form>

              <section class="dd-form__section" id="set-notifications" aria-labelledby="set-notifications-title">
                <div class="dd-form__head">
                  <h2 class="dd-form__title" id="set-notifications-title">Notifications</h2>
                  <p class="dd-form__desc">Changes apply right away. Incidents always reach the on-call owner.</p>
                </div>
                <div class="dd-form__choices dd-form__choices--rows">${sw('Failed deploys', 'Right away, with the build log attached.', true)}${sw('Incidents', 'When a service you own goes degraded or down.', true)}${sw('Spend alerts', 'When billing passes 80% of the monthly budget.', false)}${sw('Weekly digest', 'Sundays: deploys, uptime and spend in one email.', true)}
                </div>
                <fieldset class="dd-checkbox-group dd-checkbox-group--inline">
                  <legend class="dd-checkbox-group__legend">Send to</legend>
                  <label class="dd-checkbox"><input class="dd-checkbox__input" type="checkbox" checked> Email</label>
                  <label class="dd-checkbox"><input class="dd-checkbox__input" type="checkbox" checked> Slack</label>
                  <label class="dd-checkbox"><input class="dd-checkbox__input" type="checkbox"> Webhook</label>
                </fieldset>
              </section>

              <section class="dd-form__section" id="set-keys" aria-labelledby="set-keys-title">
                <div class="dd-form__head">
                  <h2 class="dd-form__title" id="set-keys-title">API keys</h2>
                  <p class="dd-form__desc">For CI and the dd CLI. A key can do anything its scopes allow — keep it out of code.</p>
                </div>
                <div class="dd-code-field">
                  <span class="dd-code-field__label" id="set-newkey-label">New key · github-actions</span>
                  <div class="dd-code-field__box" role="group" aria-labelledby="set-newkey-label">
                    <code class="dd-code-field__value" data-dd-code-secret="dd_live_51Hc7aQ2xK9mV0dRb4Lp8TzY3f9a">dd_live_••••••••••••••••••••3f9a</code>
                    <button class="dd-code-field__btn" type="button" data-dd-code-reveal data-dd-code-reveal-label="Show key|Hide key" aria-pressed="false" aria-label="Show key">${i('eye')}${i('eye-off')}</button>
                    <button class="dd-code-field__btn" type="button" data-dd-copy="dd_live_51Hc7aQ2xK9mV0dRb4Lp8TzY3f9a" aria-label="Copy key">${i('copy')}${i('check')}</button>
                  </div>
                  <p class="dd-code-field__hint">Copy it now — it won’t be shown again. Expires Jan 28, 2027.</p>
                </div>
                <div class="dd-table dd-table--compact">
                  <table>
                    <thead><tr><th>Name</th><th>Key</th><th>Status</th><th class="is-num">Last used</th><th class="is-shrink"><span class="dd-visually-hidden">Actions</span></th></tr></thead>
                    <tbody>${keys.map(([name, key, , s, label, used]) => `
                      <tr><td class="is-strong">${name}</td><td class="is-mono is-muted">${key}</td><td><span class="dd-table__status" data-status="${s}">${label}</span></td><td class="is-num is-muted">${used}</td><td><button class="dd-btn dd-btn--ghost dd-btn--sm" type="button" aria-label="Revoke ${name}">Revoke</button></td></tr>`).join('')}
                    </tbody>
                  </table>
                </div>
                <div class="dd-form__footer dd-form__footer--plain">
                  <button class="dd-btn dd-btn--secondary" type="button">${i('plus')}<span>Create key</span></button>
                </div>
              </section>

              <section class="dd-form__section" id="set-danger" aria-labelledby="set-danger-title">
                <div class="dd-form__head">
                  <h2 class="dd-form__title" id="set-danger-title">Danger zone</h2>
                  <p class="dd-form__desc">These can’t be undone. Export first if you might want your data back.</p>
                </div>
                <div class="dd-form__section dd-form__section--panel">
                  <div class="dd-form__head">
                    <h3 class="dd-form__title">Delete account</h3>
                    <p class="dd-form__desc">Removes your profile, <b>5 projects</b>, <b>1,284 deploys</b> and every API key. Teammates keep their own work.</p>
                  </div>
                  <div class="dd-form__footer dd-form__footer--plain">
                    <button class="dd-btn dd-btn--ghost" type="button">${i('download')}<span>Export data</span></button>
                    <button class="dd-btn dd-btn--danger" type="button" data-dd-dialog-open="#set-delete-dialog">${i('trash')}<span>Delete account</span></button>
                  </div>
                </div>
              </section>
            </div>
          </div>
        </div>

        <dialog class="dd-dialog dd-dialog--sm dd-dialog--danger" id="set-delete-dialog" role="alertdialog" aria-labelledby="set-delete-title" aria-describedby="set-delete-desc">
          <header class="dd-dialog__head">
            <span class="dd-dialog__icon">${i('danger')}</span>
            <div class="dd-dialog__titles">
              <p class="dd-dialog__eyebrow">Danger zone</p>
              <h2 class="dd-dialog__title" id="set-delete-title">Delete your account?</h2>
            </div>
          </header>
          <div class="dd-dialog__body" id="set-delete-desc">
            <p>This permanently removes <strong>5 projects</strong>, <strong>1,284 deploys</strong> and 3 API keys. It can’t be undone.</p>
          </div>
          <footer class="dd-dialog__foot">
            <button class="dd-btn dd-btn--ghost" type="button" data-dd-dialog-close autofocus>Keep my account</button>
            <button class="dd-btn dd-btn--danger" type="button" data-dd-dialog-close="delete">${i('trash')}<span>Delete</span></button>
          </footer>
        </dialog>
      </div>
    </main>
  </div>
</div>`;
---
<Docs title="Settings" group="Patterns" lead="The account settings for cxkw.dev: a profile form, notification switches, API keys and a danger zone — one page, one vertical nav, one primary action." wide>
  <p>Built only from existing components and their documented markup. A vertical tab list jumps between the sections of one page; each section is a <a href="../components/form-layout">form-layout</a> section with a title and a sentence of context. Only the profile needs saving, so it is the only form with a footer and the only primary button; switches apply at once, keys are created and revoked in place, and deleting the account asks first. Layout glue is the <code>&lt;style&gt;</code> at the top of the snippet.</p>

  <Example
    title="Account settings"
    description="Try it: jump between sections from the nav, edit the bio (the counter follows), flip a switch, reveal and copy the new key, or press Delete account to open the confirmation."
    code={page}
    stage="flush"
  />

  <h2 id="anatomy">Anatomy</h2>
  <ol>
    <li><strong>App shell</strong> — the side nav is just its rail here, with Settings current, so the page carries its own vertical nav without a second side nav.</li>
    <li><strong>Page header</strong> — title and one line of description; no actions, because each section owns its own.</li>
    <li><strong>Vertical tabs as navigation</strong> — links with <code>aria-current</code> beside the sections; the list wraps above them on narrow screens.</li>
    <li><strong>Profile</strong> — avatar with a compact dropzone, tucked-label inputs and a select in the two-column grid, a textarea with a counter, and the footer with the page’s one primary button.</li>
    <li><strong>Notifications</strong> — end-aligned switches with descriptions, in hairline rows, then the delivery channels.</li>
    <li><strong>API keys</strong> — the freshly created key in a copyable code field with reveal, the key table with a status column and a ghost Revoke per row, and a secondary Create key.</li>
    <li><strong>Danger zone</strong> — a tonal panel that explains the cost, a ghost escape hatch (Export) and a danger button that opens an alert dialog with the safe choice focused.</li>
  </ol>

  <h2 id="uses">What it uses</h2>
  <ul>
    <li><a href="../components/app-shell">App shell</a>, <a href="../components/side-nav">Side nav</a> (collapsed), <a href="../components/top-bar">Top bar</a>, <a href="../components/page-header">Page header</a></li>
    <li><a href="../components/tabs">Tabs</a> (vertical, as links)</li>
    <li><a href="../components/form-layout">Form layout</a>, <a href="../components/form-field">Form field</a>, <a href="../components/text-input">Text input</a>, <a href="../components/select">Select</a>, <a href="../components/textarea">Textarea</a></li>
    <li><a href="../components/avatar">Avatar</a>, <a href="../components/file-upload">File upload</a> (compact dropzone)</li>
    <li><a href="../components/switch">Switch</a>, <a href="../components/checkbox">Checkbox</a></li>
    <li><a href="../components/code">Code</a> (code field), <a href="../components/table">Table</a></li>
    <li><a href="../components/button">Button</a>, <a href="../components/dialog">Dialog</a> (destructive)</li>
  </ul>

  <h2 id="guidelines">Guidelines</h2>
  <Guides
    do={[
      'Give a section a footer only if it needs saving; switches and in-place actions apply at once.',
      'Keep one primary button on the page. Create key is secondary; Revoke is a ghost button per row.',
      'Show a new secret once, masked, with reveal and copy — and say it won’t come back.',
      'Make destructive actions cost two steps: a danger button, then an alert dialog with the safe choice focused.',
    ]}
    dont={[
      'Don’t put Save at the top and the bottom of the same form.',
      'Don’t colour the danger zone red; the danger button and the dialog carry the warning.',
      'Don’t nest a second side nav in the content — vertical tabs are the in-page nav.',
    ]}
  />
</Docs>
