---
import Docs from '../../layouts/Docs.astro';
import Example from '../../components/Example.astro';
import Guides from '../../components/Guides.astro';
import { i } from '../../lib/icon';

/* ---------- side nav (two-level: icon rail + page panel) ---------- */
const railItem = (icon: string, label: string, o: { section?: string; on?: boolean; extra?: string } = {}) =>
  o.section
    ? `<button class="dd-side-nav__item${o.on ? ' is-active' : ''}" type="button"${o.on ? ' aria-current="true"' : ''} data-dd-nav-section="${o.section}" data-label="${label}" aria-label="${label}">${i(icon)}</button>`
    : `<a class="dd-side-nav__item" href="#" data-label="${label}" aria-label="${label}">${i(icon)}${o.extra ?? ''}</a>`;
const navLink = (label: string, o: { current?: boolean; icon?: string; count?: string; dot?: string; badge?: string } = {}) =>
  `<a class="dd-side-nav__link" href="#"${o.current ? ' aria-current="page"' : ''}>${o.icon ? i(o.icon) : ''}${o.dot ? `<span class="dd-side-nav__dot dd-side-nav__dot--${o.dot}"></span>` : ''}<span class="dd-side-nav__label">${label}</span>${o.count ? `<span class="dd-side-nav__count">${o.count}</span>` : ''}${o.badge ?? ''}</a>`;

/* ---------- stat tiles (from Stat) ---------- */
const spark = (pts: number[]) => {
  const min = Math.min(...pts), max = Math.max(...pts);
  const xy = pts.map((v, k) => [+((k / (pts.length - 1)) * 100).toFixed(1), +(28 - ((v - min) / (max - min || 1)) * 23).toFixed(1)]);
  const line = xy.map(([x, y], k) => `${k ? 'L' : 'M'}${x} ${y}`).join(' ');
  const [ex, ey] = xy[xy.length - 1];
  return `<svg class="dd-stat__spark" viewBox="0 0 100 32" aria-hidden="true"><path class="dd-stat__spark-area" d="${line} L100 32 L0 32 Z"/><path class="dd-stat__spark-line" d="${line}"/><circle class="dd-stat__spark-dot" cx="${ex}" cy="${ey}" r="3"/></svg>`;
};
const DIR: Record<string, [string, string]> = { up: ['arrow-up', 'Up'], down: ['arrow-down', 'Down'], flat: ['minus', 'No change'] };
const delta = (dir: string, tone: string, text: string) =>
  `<span class="dd-stat__delta dd-stat__delta--${tone}">${i(DIR[dir][0])}<span class="dd-visually-hidden">${DIR[dir][1]}</span>${text}</span>`;
const tile = (label: string, value: string, unit: string, pts: number[], d: [string, string, string], compare: string) => `
          <div class="dd-stat">
            <p class="dd-stat__label">${label}</p>
            <div class="dd-stat__main">
              <p class="dd-stat__value">${value}${unit ? `<span class="dd-stat__unit">${unit}</span>` : ''}</p>
              ${spark(pts)}
            </div>
            <div class="dd-stat__foot">${delta(...d)}<span class="dd-stat__compare">${compare}</span></div>
          </div>`;

/* ---------- line chart (from Chart) ---------- */
const r1 = (n: number) => +n.toFixed(1);
const hours = ['22:00', '23:00', '00:00', '01:00', '02:00', '03:00', '04:00', '05:00', '06:00', '07:00', '08:00', '09:00'];
const series: [string, string, number[]][] = [
  ['dd-chart-s1', 'edge-cache', [24.1, 21.8, 18.2, 15.9, 14.7, 15.2, 17.9, 22.4, 28.6, 33.9, 38.2, 41.3]],
  ['dd-chart-s2', 'auth-gateway', [9.8, 8.7, 7.1, 6.2, 5.8, 6.0, 7.4, 9.1, 11.6, 12.9, 13.2, 12.5]],
];
const lineMax = 50;
const xOf = (k: number, n: number) => r1((k / (n - 1)) * 100);
const yOf = (v: number, max: number) => r1(100 - (v / max) * 100);
const path = (vals: number[]) => vals.map((v, k) => `${k ? 'L' : 'M'}${xOf(k, vals.length)} ${yOf(v, lineMax)}`).join(' ');
const hits = hours.map((h, k) => `
                <div class="dd-chart__hit${k >= hours.length * 0.6 ? ' is-flip' : ''}" style="--x:${xOf(k, hours.length)}" tabindex="0" role="img" aria-label="${h}: ${series.map(([, n, v]) => `${n} ${v[k]}K`).join(', ')}">
                  ${series.map(([s, , v]) => `<span class="dd-chart__dot ${s}" style="--y:${yOf(v[k], lineMax)}"></span>`).join('')}
                  <div class="dd-chart__tip" aria-hidden="true"><p class="dd-chart__tip-title">${h}</p>${series.map(([s, n, v]) => `<p class="dd-chart__tip-row ${s}">${n}<b>${v[k]}K</b></p>`).join('')}</div>
                </div>`).join('');
const chart = `
          <figure class="dd-chart">
            <figcaption class="dd-chart__head">
              <div><p class="dd-chart__title">Requests / min</p><p class="dd-chart__sub">Last 12 hours · all regions</p></div>
              <ul class="dd-chart__legend">${series.map(([s, n]) => `<li class="dd-chart__key dd-chart__key--line ${s}">${n}</li>`).join('')}</ul>
            </figcaption>
            <div class="dd-chart__frame">
              <div class="dd-chart__y" aria-hidden="true">${['50K', '40K', '30K', '20K', '10K', '0'].map((t) => `<span>${t}</span>`).join('')}</div>
              <div class="dd-chart__plot" style="--dd-chart-ticks:5" role="group" aria-label="Requests per minute over the last 12 hours">
                <svg class="dd-chart__svg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                  ${series.map(([s, , v]) => `<path class="dd-chart__line ${s}" d="${path(v)}"/>`).join('\n                  ')}
                </svg>
                ${series.map(([s, , v]) => `<span class="dd-chart__marker ${s}" style="--x:100; --y:${yOf(v[v.length - 1], lineMax)}"></span>`).join('')}
                <div class="dd-chart__hits" style="--dd-chart-points:${hours.length}">${hits}
                </div>
              </div>
              <div class="dd-chart__x dd-chart__x--points" aria-hidden="true">${hours.map((h, k) => `<span${k % 3 ? ' class="is-minor"' : ''}>${h}</span>`).join('')}</div>
            </div>
          </figure>`;

/* ---------- activity timeline (from Timeline) ---------- */
const avatar = (initials: string, set: number, name: string) =>
  `<span class="dd-timeline__marker dd-timeline__marker--avatar" style="--dd-color: var(--dd-set-${set})" role="img" aria-label="${name}">${initials}</span>`;
const mark = (name: string, tone: string) => `<span class="dd-timeline__marker dd-timeline__marker--${tone}">${i(name)}</span>`;
const event = (marker: string, text: string, time: string, iso: string) => `
                <li class="dd-timeline__item">
                  ${marker}
                  <div class="dd-timeline__body">
                    <p class="dd-timeline__text">${text}</p>
                    <time class="dd-timeline__time" datetime="${iso}">${time}</time>
                  </div>
                </li>`;
const activity = `
            <div class="dd-timeline">
              <section class="dd-timeline__group">
                <h3 class="dd-timeline__day">Today <time class="dd-timeline__date" datetime="2026-10-30">Oct 30</time></h3>
                <ol class="dd-timeline__list">${[
  event(mark('check', 'ok'), 'Deploy <code>dpl_7Hq2xK9m</code> passed health checks in <b>us-east-1</b>', '09:43', '2026-10-30T09:43'),
  event(avatar('AN', 3, 'Andy'), '<b>Andy</b> deployed <a href="#">auth-gateway</a> to <code>production</code>', '09:41', '2026-10-30T09:41'),
  event(mark('danger', 'bad'), '<b>notify-fanout</b> went down in <b>eu-west-2</b>', '09:39', '2026-10-30T09:39'),
  event(mark('alert', 'warn'), '<b>search-indexer</b> degraded — p95 at <span class="dd-mono">611 ms</span>', '09:22', '2026-10-30T09:22'),
  event(avatar('MK', 6, 'Mira K.'), '<b>Mira K.</b> rotated API key <code>key_live_8f2c41</code>', '08:55', '2026-10-30T08:55'),
].join('')}
                </ol>
              </section>
            </div>`;

/* ---------- services (from Data table) ---------- */
// [name, status, label, region, version, req/min, error %, p95 ms, cpu %, updated]
const services: [string, string, string, string, string, number, number | null, number | null, number, string][] = [
  ['auth-gateway', 'ok', 'Healthy', 'us-east-1', 'v2.14.0', 12480, 0.02, 84, 41, '09:41:07'],
  ['billing-worker', 'ok', 'Healthy', 'us-east-1', 'v1.8.3', 3212, 0.11, 142, 58, '09:41:02'],
  ['search-indexer', 'warn', 'Degraded', 'us-east-1', 'v0.9.12', 8904, 1.84, 611, 87, '09:40:55'],
  ['edge-cache', 'ok', 'Healthy', 'us-east-1', 'v3.2.1', 41337, 0, 12, 33, '09:40:51'],
  ['ledger-sync', 'ok', 'Healthy', 'eu-west-2', 'v1.2.0', 1048, 0.05, 96, 22, '09:40:48'],
  ['notify-fanout', 'bad', 'Down', 'eu-west-2', 'v2.0.0-rc.2', 0, null, null, 0, '09:39:12'],
  ['session-store', 'ok', 'Healthy', 'eu-west-2', 'v5.0.2', 18452, 0.01, 9, 47, '09:40:38'],
  ['image-resizer', 'ok', 'Healthy', 'ap-south-1', 'v1.5.0', 6502, 0.32, 188, 64, '09:40:37'],
  ['metrics-agg', 'warn', 'Degraded', 'ap-south-1', 'v2.3.4', 19220, 0.94, 402, 91, '09:40:33'],
  ['webhook-relay', 'ok', 'Healthy', 'ap-south-1', 'v2.7.1', 4380, 0.21, 117, 38, '09:40:21'],
];
const fmt = (n: number) => n.toLocaleString('en-US');
const menuIcon = (n: string) => `<svg class="dd-icon dd-menu__icon" aria-hidden="true"><use href="#dd-i-${n}"/></svg>`;
const dash = '<span class="is-faint">—</span>';
const sortTh = (label: string, col: string, cls = '') =>
  `<th${cls ? ` class="${cls}"` : ''} data-col="${col}" aria-sort="none"><button class="dd-data-table__sort" type="button">${label}${i('chevron-down')}</button></th>`;
const rows = services.map(([name, s, label, region, ver, req, err, p95, cpu, at]) => `
                <tr>
                  <td class="dd-data-table__select"><input class="dd-data-table__check" type="checkbox" aria-label="Select ${name}"></td>
                  <td class="is-frozen" data-col="service"><a href="#">${name}</a></td>
                  <td data-col="status" data-value="${s}"><span class="dd-data-table__status" data-status="${s}">${label}</span></td>
                  <td data-col="region">${region}</td>
                  <td class="is-mono is-muted" data-col="version">${ver}</td>
                  <td class="is-num">${fmt(req)}</td>
                  ${err === null ? `<td class="is-num">${dash}</td>` : `<td class="is-num${err >= 1 ? ' is-warn' : ''}">${err.toFixed(2)}%</td>`}
                  ${p95 === null ? `<td class="is-num">${dash}</td>` : `<td class="is-num${p95 >= 400 ? ' is-warn' : ''}" data-value="${p95}">${p95}<span class="dd-data-table__unit">ms</span></td>`}
                  <td class="is-num${cpu >= 85 ? ' is-warn' : ''}">${cpu}%</td>
                  <td class="is-num is-muted">${at}</td>
                  <td class="is-actions"><button class="dd-btn dd-btn--ghost dd-btn--sm dd-btn--icon" type="button" aria-label="Actions for ${name}" data-dd-menu="dash-row-menu" data-dd-placement="bottom-end" aria-haspopup="menu" aria-controls="dash-row-menu" aria-expanded="false">${i('more')}</button></td>
                </tr>`).join('');
const table = `
          <div class="dd-data-table" data-dd-data-table>
            <div class="dd-data-table__toolbar">
              <label class="dd-data-table__search">${i('search')}<input type="search" placeholder="Filter services…" aria-label="Filter services" data-dd-data-table-search></label>
              <button class="dd-data-table__chip" type="button" aria-pressed="false" data-dd-data-table-filter="status=warn"><span class="dd-data-table__chip-dot" style="--_c: var(--dd-warn)"></span>Degraded</button>
              <button class="dd-data-table__chip" type="button" aria-pressed="false" data-dd-data-table-filter="status=bad"><span class="dd-data-table__chip-dot" style="--_c: var(--dd-bad)"></span>Down</button>
              <div class="dd-data-table__tools">
                <span class="dd-data-table__count" data-dd-data-table-count="services">${services.length} services</span>
                <button class="dd-btn dd-btn--ghost dd-btn--sm" type="button">${i('download')}<span>Export</span></button>
              </div>
            </div>
            <div class="dd-data-table__bulk" role="region" aria-label="Bulk actions" hidden>
              <span class="dd-data-table__bulk-count"><span data-dd-data-table-selected>0</span> selected</span>
              <button class="dd-btn dd-btn--sm" type="button" data-action="restart">${i('refresh')}<span>Restart</span></button>
              <button class="dd-btn dd-btn--sm" type="button" data-action="pause">${i('pause')}<span>Pause</span></button>
              <button class="dd-btn dd-btn--sm dd-data-table__bulk-end" type="button" data-dd-data-table-clear>Clear</button>
            </div>
            <div class="dd-data-table__scroll" tabindex="0" role="region" aria-label="Services">
              <table class="dd-data-table__table">
                <thead>
                  <tr>
                    <th class="dd-data-table__select"><input class="dd-data-table__check" type="checkbox" aria-label="Select all services"></th>
                    ${sortTh('Service', 'service', 'is-frozen')}
                    ${sortTh('Status', 'status')}
                    ${sortTh('Region', 'region')}
                    <th data-col="version">Version</th>
                    ${sortTh('Req / min', 'req', 'is-num')}
                    ${sortTh('Errors', 'err', 'is-num')}
                    ${sortTh('p95', 'p95', 'is-num')}
                    ${sortTh('CPU', 'cpu', 'is-num')}
                    ${sortTh('Updated', 'at', 'is-num')}
                    <th class="is-actions"><span class="dd-visually-hidden">Actions</span></th>
                  </tr>
                </thead>
                <tbody>${rows}
                <tr class="dd-data-table__empty-row" hidden>
                  <td colspan="11"><div class="dd-data-table__empty">
                    <span class="dd-data-table__empty-icon">${i('search')}</span>
                    <p class="dd-data-table__empty-title">No services match <span data-dd-data-table-query></span></p>
                    <p>Try another name or region, or clear the filters.</p>
                    <div class="dd-row"><button class="dd-btn dd-btn--secondary dd-btn--sm" type="button" data-dd-data-table-reset>Clear filters</button></div>
                  </div></td>
                </tr>
                </tbody>
              </table>
            </div>
            <div class="dd-menu" id="dash-row-menu" role="menu" aria-label="Service actions" hidden>
              <button class="dd-menu__item" role="menuitem" type="button" data-action="logs">${menuIcon('terminal')}<span class="dd-menu__body">View logs</span></button>
              <button class="dd-menu__item" role="menuitem" type="button" data-action="restart">${menuIcon('refresh')}<span class="dd-menu__body">Restart</span></button>
              <button class="dd-menu__item" role="menuitem" type="button" data-action="pause">${menuIcon('pause')}<span class="dd-menu__body">Pause</span></button>
            </div>
          </div>`;

const glue = `<style>
  /* Page glue only: lays the blocks out. Every visual comes from a component. */
  .dd-pattern-dash { container: dd-pattern-dash / inline-size; }
  .dd-pattern-dash__split { display: grid; grid-template-columns: minmax(0, 1fr); gap: calc(var(--dd-u) * 8); align-items: start; }
  .dd-pattern-dash > .dd-stat-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } /* 4 → 2 → 1, never 3 + 1 */
  @container dd-pattern-dash (min-width: 720px) { .dd-pattern-dash > .dd-stat-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @container dd-pattern-dash (max-width: 380px) { .dd-pattern-dash > .dd-stat-grid { grid-template-columns: minmax(0, 1fr); } }
  @container dd-pattern-dash (min-width: 900px) {
    .dd-pattern-dash__split { grid-template-columns: minmax(0, 5fr) minmax(0, 3fr); gap: calc(var(--dd-u) * 6); }
  }
</style>`;

const page = `
${glue}
<div class="dd-app-shell">
  <nav class="dd-side-nav" id="dash-nav" aria-label="Main">
    <div class="dd-side-nav__rail">
      <a class="dd-side-nav__logo dd-logo-tile" href="#" aria-label="dawn &amp; dusk — home">d&amp;</a>
      ${railItem('home', 'Monitor', { section: 'monitor', on: true })}
      ${railItem('folder', 'Projects', { section: 'projects' })}
      ${railItem('database', 'Storage')}
      <span class="dd-side-nav__spacer"></span>
      ${railItem('bell', 'Inbox · 3 new', { extra: '<span class="dd-side-nav__dot"></span>' })}
      ${railItem('settings', 'Settings')}
      <span class="dd-side-nav__sep"></span>
      <button class="dd-side-nav__item dd-side-nav__collapse" type="button" data-dd-nav-toggle aria-controls="dash-nav-panel" aria-expanded="true" aria-label="Collapse navigation" data-label="Collapse">${i('chevron-left')}</button>
    </div>
    <div class="dd-side-nav__panel" id="dash-nav-panel">
      <div class="dd-side-nav__pane" data-dd-nav-pane="monitor">
        <div class="dd-side-nav__head"><span class="dd-side-nav__title">production</span><span class="dd-side-nav__count">3 regions</span></div>
        <p class="dd-side-nav__section">Monitor</p>
        ${navLink('Overview', { icon: 'grid', current: true })}
        ${navLink('Services', { icon: 'server', count: '10' })}
        ${navLink('Deploys', { icon: 'cloud', count: '32' })}
        ${navLink('Logs', { icon: 'terminal' })}
        ${navLink('Alerts', { icon: 'bell', badge: '<span class="dd-side-nav__badge dd-side-nav__badge--solid">2</span>' })}
        <p class="dd-side-nav__section">Regions</p>
        ${navLink('us-east-1', { dot: 'warn', count: '4' })}
        ${navLink('eu-west-2', { dot: 'bad', count: '3' })}
        ${navLink('ap-south-1', { dot: 'warn', count: '3' })}
        <div class="dd-side-nav__foot">
          <div class="dd-side-nav__note"><span><b>Hobby plan</b> · 412k of 1M requests</span><span class="dd-side-nav__meter"><i style="width:41%"></i></span></div>
        </div>
      </div>
      <div class="dd-side-nav__pane" data-dd-nav-pane="projects" hidden>
        <div class="dd-side-nav__head"><span class="dd-side-nav__title">projects</span><span class="dd-side-nav__count">5</span></div>
        <p class="dd-side-nav__section">Pinned</p>
        ${navLink('dawn-and-dusk', { count: '24' })}
        ${navLink('dockey-ui', { count: '9' })}
        <p class="dd-side-nav__section">All</p>
        ${navLink('ai-focus', { count: '31' })}
        ${navLink('insomnia', { count: '6' })}
        ${navLink('leetnode', { count: '41' })}
      </div>
    </div>
  </nav>

  <div class="dd-app-shell__main">
    <header class="dd-top-bar">
      <button class="dd-btn dd-btn--ghost dd-btn--icon dd-top-bar__nav-btn" type="button" data-dd-nav-open="#dash-nav" aria-controls="dash-nav" aria-expanded="false" aria-label="Open navigation">${i('menu')}</button>
      <a class="dd-top-bar__brand dd-top-bar__narrow" href="#"><span class="dd-logo dd-logo--sm">dawn &amp; dusk</span></a>
      <div class="dd-top-bar__context">
        <button class="dd-top-bar__switch" type="button"><span class="dd-top-bar__mark">cx</span><span>cxkw</span></button>
        <span class="dd-faint">/</span>
        <button class="dd-top-bar__switch" type="button"><span>production</span>${i('sort')}</button>
      </div>
      <button class="dd-top-bar__search" type="button" aria-label="Search">${i('search')}<span>Search or jump to…</span><kbd class="dd-top-bar__kbd">⌘K</kbd></button>
      <div class="dd-top-bar__actions">
        <button class="dd-btn dd-btn--ghost dd-btn--icon dd-top-bar__icon-btn" type="button" aria-label="Notifications, 3 new">${i('bell')}<span class="dd-top-bar__dot"></span></button>
        <details class="dd-top-bar__user" data-dd-autoclose>
          <summary aria-label="Account menu"><span class="dd-top-bar__avatar">cx</span></summary>
          <div class="dd-top-bar__menu">
            <div class="dd-top-bar__menu-head"><b>cxkw</b><span>hello@cxkw.dev</span></div>
            <div class="dd-top-bar__menu-sep"></div>
            <a class="dd-top-bar__menu-item" href="#">${i('settings')}Settings</a>
            <button class="dd-top-bar__menu-item" type="button" data-dd-theme-toggle>${i('moon')}Toggle dusk</button>
            <a class="dd-top-bar__menu-item" href="#">${i('logout')}Sign out</a>
          </div>
        </details>
      </div>
    </header>

    <main class="dd-app-shell__content">
      <div class="dd-app-shell__page dd-pattern-dash">
        <header class="dd-page-header">
          <nav class="dd-breadcrumbs dd-breadcrumbs--sm" aria-label="Breadcrumb">
            <ol class="dd-breadcrumbs__list">
              <li class="dd-breadcrumbs__item"><a class="dd-breadcrumbs__link" href="#"><span>cxkw</span></a></li>
              <li class="dd-breadcrumbs__item"><a class="dd-breadcrumbs__link" aria-current="page"><span>production</span></a></li>
            </ol>
          </nav>
          <div class="dd-page-header__row">
            <div class="dd-page-header__titles"><h1 class="dd-page-header__title">overview</h1></div>
            <div class="dd-page-header__actions">
              <button class="dd-btn dd-btn--secondary" type="button">${i('download')}<span>Export</span></button>
              <button class="dd-btn dd-btn--primary" type="button">${i('upload')}<span>New deploy</span></button>
            </div>
          </div>
          <ul class="dd-page-header__meta">
            <li><span class="dd-page-header__status dd-page-header__status--warn"></span>2 degraded · 1 down</li>
            <li>${i('globe')}<b>us-east-1 · eu-west-2 · ap-south-1</b></li>
            <li>${i('clock')}Last deploy <b>4m ago</b></li>
          </ul>
        </header>

        <div class="dd-alert dd-alert--bad">
          ${i('danger')}
          <div class="dd-alert__body">
            <p class="dd-alert__title">notify-fanout is down in eu-west-2</p>
            <p class="dd-alert__text">Health checks have failed since 09:39 with <code>connection refused :8080</code>. Deploy emails are queued, not lost.</p>
          </div>
          <div class="dd-alert__actions">
            <button class="dd-alert__action" type="button">Open incident</button>
            <button class="dd-alert__action dd-alert__action--secondary" type="button">View logs</button>
          </div>
        </div>

        <div class="dd-stat-grid">${tile('Requests / min', '41.3K', '', [28.1, 29.4, 27.9, 31.2, 30.6, 33.8, 32.9, 35.1, 36.7, 35.9, 39.2, 41.3], ['up', 'ok', '12.4%'], 'vs <b>36.7K</b> last week')}${tile('p95 latency', '142', 'ms', [118, 121, 119, 126, 124, 131, 128, 136, 133, 139, 137, 142], ['up', 'bad', '18 ms'], 'vs <b>124 ms</b> yesterday')}${tile('Error rate', '0.42', '%', [0.61, 0.58, 0.6, 0.55, 0.52, 0.54, 0.5, 0.49, 0.47, 0.46, 0.44, 0.42], ['down', 'ok', '0.08 pts'], 'vs <b>0.50%</b> last week')}${tile('Deploys today', '12', '', [9, 11, 8, 12, 10, 14, 12, 9, 13, 11, 12, 12], ['flat', 'flat', '0'], 'same as Tuesday')}
        </div>

        <div class="dd-pattern-dash__split">
          ${chart.trim()}
          <section aria-labelledby="dash-activity">
            <header class="dd-table-header">
              <h2 class="dd-table-header__title" id="dash-activity">activity</h2>
              <a class="dd-table-header__action" href="#">Audit log ${i('arrow-right')}</a>
            </header>${activity}
          </section>
        </div>

        <section aria-labelledby="dash-services">
          <header class="dd-table-header">
            <h2 class="dd-table-header__title" id="dash-services">services</h2>
            <span class="dd-table-header__meta">10 in production</span>
            <a class="dd-table-header__action" href="#">All services ${i('arrow-right')}</a>
          </header>${table}
        </section>
      </div>
    </main>
  </div>
</div>`;
---
<Docs title="Dashboard" group="Patterns" lead="The production overview for cxkw.dev: what is running, how it is doing, and what changed — in the app shell, read top to bottom from the most urgent thing to the most detailed." wide>
  <p>Built only from existing components and their documented markup. The page leads with its title and one primary action, then the incident that needs attention, then four KPIs, a trend with its context, and the full service list. The only extra CSS is a few lines of layout glue (in the <code>&lt;style&gt;</code> at the top of the snippet), written with tokens.</p>

  <Example
    title="Production overview"
    description="Try it: sort or filter the services, select rows for bulk actions, hover the chart, switch the rail to Projects or fold the nav. The shell is the viewport (100dvh), exactly as in the app: the chrome stays put and the content scrolls inside it."
    code={page}
    stage="flush"
  />
  <script is:inline>
    // Docs only: answer the demo's buttons with a toast, as the app would after the request went out.
    (() => {
      const shell = document.querySelector('.ex-stage .dd-app-shell');
      if (!shell) return;
      let rowFor = null; // the service whose row menu is open
      const say = (from, title, description, intent = 'info') => window.dd?.toast?.({ title, description, intent, from });
      const list = (names) => (names.length > 3 ? `${names.slice(0, 3).join(', ')} and ${names.length - 3} more` : names.join(', '));
      const verbs = { restart: ['Restarting', 'Rolling restart, one replica at a time.'], pause: ['Paused', 'Traffic drains to the other regions.'] };
      shell.addEventListener('click', (e) => {
        const more = e.target.closest('[data-dd-menu="dash-row-menu"]');
        if (more) { rowFor = more.closest('tr')?.querySelector('[data-col="service"]')?.textContent.trim() || null; return; }
        const item = e.target.closest('#dash-row-menu [data-action]');
        if (item && rowFor) {
          const a = item.dataset.action;
          if (a === 'logs') say(item, `Opening logs for ${rowFor}`, 'Live tail, last 15 minutes.', 'neutral');
          else say(item, `${verbs[a][0]} ${rowFor}`, verbs[a][1], a === 'pause' ? 'warn' : 'ok');
          return;
        }
        const bulk = e.target.closest('.dd-data-table__bulk [data-action]');
        if (bulk) {
          const names = [...shell.querySelectorAll('tbody tr.is-selected [data-col="service"]')].map((td) => td.textContent.trim());
          const [verb, text] = verbs[bulk.dataset.action];
          say(bulk, `${verb} ${names.length} service${names.length === 1 ? '' : 's'}`, `${list(names)}. ${text}`, bulk.dataset.action === 'pause' ? 'warn' : 'ok');
          return;
        }
        const btn = e.target.closest('.dd-page-header__actions .dd-btn, .dd-data-table__tools .dd-btn, .dd-alert__action');
        if (!btn) return;
        const label = btn.textContent.trim();
        if (label === 'New deploy') say(btn, 'Deploy queued', 'production · main@9f2c41e to 3 regions.', 'ok');
        else if (label === 'Export') say(btn, 'Exported services.csv', '10 services, current filters applied.', 'neutral');
        else if (label === 'Open incident') say(btn, 'Incident INC-212 opened', 'notify-fanout · eu-west-2 — on-call paged.', 'warn');
        else if (label === 'View logs') say(btn, 'Opening logs for notify-fanout', 'Filtered to errors since 09:39.', 'neutral');
      });
    })();
  </script>

  <h2 id="anatomy">Anatomy</h2>
  <ol>
    <li><strong>App shell</strong> — two-level side nav (icon rail for sections, a panel for the section’s pages) and a top bar with the workspace / environment switcher, search and the account menu.</li>
    <li><strong>Page header</strong> — breadcrumbs, a lockup title, one secondary and one primary action, and meta facts with an overall status dot.</li>
    <li><strong>Alert</strong> — only when something needs a person. A dashboard with nothing wrong shows nothing here.</li>
    <li><strong>Stat grid</strong> — four KPIs, each with a delta that names its comparison period and a muted sparkline.</li>
    <li><strong>Chart + activity</strong> — the trend behind the KPIs beside what changed recently. Side by side from 900px of page width, stacked below.</li>
    <li><strong>Services</strong> — the dense data table: status column, sortable figures, selection with a bulk bar.</li>
  </ol>

  <h2 id="uses">What it uses</h2>
  <ul>
    <li><a href="../components/app-shell">App shell</a>, <a href="../components/side-nav">Side nav</a>, <a href="../components/top-bar">Top bar</a></li>
    <li><a href="../components/page-header">Page header</a>, <a href="../components/breadcrumbs">Breadcrumbs</a>, <a href="../components/button">Button</a></li>
    <li><a href="../components/alert">Alert</a></li>
    <li><a href="../components/stat">Stat</a> (grid with sparklines)</li>
    <li><a href="../components/chart">Chart</a> (line, two series, legend)</li>
    <li><a href="../components/timeline">Timeline</a>, <a href="../components/table">Table</a> (its title row)</li>
    <li><a href="../components/data-table">Data table</a></li>
  </ul>

  <h2 id="guidelines">Guidelines</h2>
  <Guides
    do={[
      'Keep one primary action in the page header; table rows get a ghost “more” button.',
      'Order by urgency: incident, KPIs, trend, then the detailed list.',
      'Put figures in mono and right-align them; give every status a word as well as a colour.',
      'Let the chart and activity stack under ~900px of page width; let the table scroll sideways.',
    ]}
    dont={[
      'Don’t show more than four KPIs in the first row — move the rest into the table.',
      'Don’t frame every block in a card: tiles and the chart are surfaces, the table and timeline sit on the page.',
      'Don’t colour whole rows by status; mark the status cell and the figure past its threshold.',
    ]}
  />
</Docs>
