---
import Docs from '../../layouts/Docs.astro';
import Example from '../../components/Example.astro';
import Guides from '../../components/Guides.astro';
import { i } from '../../lib/icon';

/* ---------- side nav: rail + collections tree (folded by default to give the data room) ---------- */
const railItem = (icon: string, label: string, o: { section?: string; on?: boolean } = {}) =>
  o.section
    ? `<button class="dd-side-nav__item${o.on ? ' is-active' : ''}" type="button"${o.on ? ' aria-current="true"' : ''} data-dd-nav-section="${o.section}" data-label="${label}" aria-label="${label}">${i(icon)}</button>`
    : `<a class="dd-side-nav__item" href="#" data-label="${label}" aria-label="${label}">${i(icon)}</a>`;
const sub = (label: string, count: string, current = false) =>
  `<a class="dd-side-nav__link" href="#"${current ? ' aria-current="page"' : ''}><span class="dd-side-nav__label">${label}</span><span class="dd-side-nav__count">${count}</span></a>`;
const db = (name: string, open: boolean, links: string[]) => `
          <details class="dd-side-nav__group"${open ? ' open' : ''}>
            <summary class="dd-side-nav__link">${i('database')}<span class="dd-side-nav__label">${name}</span><span class="dd-side-nav__chev">${i('chevron-down')}</span></summary>
            <div class="dd-side-nav__sub">
              ${links.join('\n              ')}
            </div>
          </details>`;

/* ---------- documents (deploys.deployments) ---------- */
// [_id, service, status, label, region, sha, duration s, created]
const docs: [string, string, string, string, string, string, number | null, string][] = [
  ['dpl_7Hq2xK9m', 'auth-gateway', 'ok', 'Ready', 'us-east-1', '9f2c41e', 16.2, '09:41:07'],
  ['dpl_71be09Qa', 'billing-worker', 'bad', 'Failed', 'us-east-1', '7be03d1', 41.8, '09:12:44'],
  ['dpl_8f3a2cLw', 'edge-cache', 'ok', 'Ready', 'eu-west-2', 'c90e5aa', 8.4, '08:47:19'],
  ['dpl_5c40d1Tz', 'dockey-ui', 'info', 'Building', 'eu-west-2', '1d2b7f0', null, '08:03:52'],
  ['dpl_2e91aaRk', 'search-indexer', 'ok', 'Ready', 'us-east-1', 'e66a4b9', 22.9, '07:55:30'],
  ['dpl_9d04f7Hm', 'auth-gateway', 'muted', 'Superseded', 'us-east-1', 'a41f9c2', 15.7, '07:31:02'],
  ['dpl_44c18bPe', 'ai-focus', 'ok', 'Ready', 'ap-south-1', '3f0d8b1', 12.1, '06:58:13'],
  ['dpl_0b7e52Ns', 'notify-fanout', 'bad', 'Failed', 'eu-west-2', 'b51c7e0', 63.4, '06:20:47'],
  ['dpl_6a3f90Cu', 'leetnode', 'ok', 'Ready', 'ap-south-1', '2c8d1f4', 19.6, '05:42:09'],
  ['dpl_3c71e4Vd', 'insomnia', 'ok', 'Ready', 'us-east-1', 'f17a0c3', 10.3, '04:15:55'],
  ['dpl_1f88d2Jb', 'image-resizer', 'warn', 'Rolled back', 'ap-south-1', '84e2b6d', 31.0, '03:02:38'],
  ['dpl_5e2c07Xo', 'ledger-sync', 'ok', 'Ready', 'eu-west-2', 'd9a35f1', 14.8, '01:47:26'],
];
const sortTh = (label: string, col: string, cls = '') =>
  `<th${cls ? ` class="${cls}"` : ''} data-col="${col}" aria-sort="none"><button class="dd-data-table__sort" type="button">${label}${i('chevron-down')}</button></th>`;
const rows = docs.map(([id, svc, s, label, , , , at], n) => `
                    <tr${n === 0 ? ' class="is-selected"' : ''}>
                      <td class="is-frozen is-mono" data-col="id"><a href="#"${n === 0 ? ' aria-current="true"' : ''}>${id}</a></td>
                      <td data-col="service">${svc}</td>
                      <td data-col="status" data-value="${s}"><span class="dd-data-table__status" data-status="${s}">${label}</span></td>
                      <td class="is-num is-muted">${at}</td>
                    </tr>`).join('');

const doc = {
  _id: 'dpl_7Hq2xK9m',
  service: 'auth-gateway',
  env: 'production',
  region: 'us-east-1',
  status: 'ready',
  commit: { sha: '9f2c41e7b0d3', message: 'Cache JWKS for 10 minutes and retry on 429', author: 'andy@cxkw.dev' },
  timings: { queuedMs: 412, buildMs: 18240, rolloutMs: 16200 },
  replicas: [
    { id: 'auth-gw-1', zone: 'us-east-1a', ready: true, restarts: 0 },
    { id: 'auth-gw-2', zone: 'us-east-1b', ready: true, restarts: 1 },
    { id: 'auth-gw-3', zone: 'us-east-1c', ready: false, restarts: 4 },
  ],
  flags: ['edge-cache', 'rate-limit-v2'],
  rollbackOf: null,
  createdAt: '2026-10-30T09:40:51.008Z',
  finishedAt: '2026-10-30T09:41:07.214Z',
};

/* ---------- description list (from Description list) ---------- */
const copy = (text: string, what: string) =>
  `<button class="dd-description-list__copy" type="button" data-dd-copy="${text}" aria-label="Copy ${what}">${i('copy')}${i('check')}</button>`;
const fact = (term: string, details: string) => `
                    <div class="dd-description-list__item">
                      <dt class="dd-description-list__term">${term}</dt>
                      <dd class="dd-description-list__details">${details}</dd>
                    </div>`;

/* ---------- logs (from Log viewer) ---------- */
type Line = [string, 'debug' | 'info' | 'warn' | 'error', string, string];
const dim = (t: string) => `<span class="dd-log-viewer__dim">${t}</span>`;
const LOGS: Line[] = [
  ['09:40:51.008', 'info', 'mongod', `insert deploys.deployments ${dim('_id=dpl_7Hq2xK9m 2ms')}`],
  ['09:40:52.311', 'debug', 'mongod', `find deploys.deployments ${dim('planSummary: IXSCAN { status: 1, createdAt: -1 } docs=20 4ms')}`],
  ['09:40:55.640', 'warn', 'mongod', `slow query deploys.builds ${dim('planSummary: COLLSCAN docsExamined=12,904 412ms')}`],
  ['09:40:58.302', 'error', 'billing-worker', `update deploys.deployments failed: WriteConflict ${dim('_id=dpl_71be09Qa attempt=1/3')}`],
  ['09:40:58.910', 'info', 'billing-worker', `retry succeeded ${dim('_id=dpl_71be09Qa attempt=2/3 11ms')}`],
  ['09:41:00.447', 'info', 'mongod', `index build finished deploys.deployments ${dim('region_1_createdAt_-1 48,214 keys 1.9s')}`],
  ['09:41:02.733', 'warn', 'mongod', `connection pool near limit ${dim('in use=92 max=100 client=search-indexer')}`],
  ['09:41:04.250', 'debug', 'mongod', `aggregate deploys.deployments ${dim('$match → $group by service 38ms')}`],
  ['09:41:06.740', 'error', 'notify-fanout', `change stream closed: ECONNRESET ${dim('collection=deploys.deployments resumeToken=8263…')}`],
  ['09:41:07.214', 'info', 'mongod', `update deploys.deployments ${dim('_id=dpl_7Hq2xK9m $set status=ready 3ms')}`],
];
const count = (lvl: string) => LOGS.filter((l) => l[1] === lvl).length;
const logLines = LOGS.map(([t, lvl, src, msg]) =>
  `                <li class="dd-log-viewer__line" data-level="${lvl}"><time class="dd-log-viewer__time">${t}</time><span class="dd-log-viewer__level">${lvl}</span><span class="dd-log-viewer__src">${src}</span><span class="dd-log-viewer__msg">${msg}</span></li>`).join('\n');
const levelBtn = (lvl: string) =>
  `<button class="dd-log-viewer__toggle" type="button" data-dd-log-viewer-level="${lvl}" aria-pressed="true">${lvl[0].toUpperCase() + lvl.slice(1)} <span class="dd-log-viewer__n">${count(lvl)}</span></button>`;

/* ---------- indexes (from Table) ---------- */
const indexes = [
  ['_id_', '{ _id: 1 }', 'unique', '1.2 MB', '2,410'],
  ['status_1_createdAt_-1', '{ status: 1, createdAt: -1 }', 'compound', '2.8 MB', '18,902'],
  ['region_1_createdAt_-1', '{ region: 1, createdAt: -1 }', 'compound', '2.6 MB', '6,377'],
  ['commit.sha_1', '{ "commit.sha": 1 }', 'single', '1.9 MB', '41'],
];

const chip = (label: string, on: boolean) =>
  `<button class="dd-chip dd-chip--filter" type="button" aria-pressed="${on}"><span class="dd-chip__check">${i('check')}</span><span>${label}</span></button>`;

const glue = `<style>
  /* Page glue only: lays the blocks out. Every visual comes from a component. */
  .dd-pattern-explorer { container: dd-pattern-explorer / inline-size; }
  .dd-pattern-explorer__query { display: flex; flex-wrap: wrap; align-items: center; gap: calc(var(--dd-u) * 2); }
  .dd-pattern-explorer__query > .dd-input { flex: 1 1 260px; }
  .dd-pattern-explorer__query > .dd-segmented { margin-left: auto; }
  .dd-pattern-explorer__split { display: grid; grid-template-columns: minmax(0, 1fr); gap: calc(var(--dd-u) * 6); align-items: start; }
  .dd-pattern-explorer__detail { display: flex; flex-direction: column; gap: calc(var(--dd-u) * 4); min-width: 0; }
  @container dd-pattern-explorer (min-width: 680px) {
    .dd-pattern-explorer__split { grid-template-columns: minmax(0, 3fr) minmax(280px, 2fr); }
  }
</style>`;

const page = `
${glue}
<div class="dd-app-shell">
  <nav class="dd-side-nav is-collapsed" id="explorer-nav" aria-label="Main">
    <div class="dd-side-nav__rail">
      <a class="dd-side-nav__logo dd-logo-tile" href="#" aria-label="dawn &amp; dusk — home">d&amp;</a>
      ${railItem('database', 'Data', { section: 'data', on: true })}
      ${railItem('terminal', 'Shell')}
      ${railItem('chart', 'Performance')}
      ${railItem('shield', 'Access')}
      <span class="dd-side-nav__spacer"></span>
      ${railItem('settings', 'Settings')}
      <span class="dd-side-nav__sep"></span>
      <button class="dd-side-nav__item dd-side-nav__collapse" type="button" data-dd-nav-toggle aria-controls="explorer-nav-panel" aria-expanded="false" aria-label="Expand navigation" data-label="Expand">${i('chevron-left')}</button>
    </div>
    <div class="dd-side-nav__panel" id="explorer-nav-panel">
      <div class="dd-side-nav__pane" data-dd-nav-pane="data">
        <div class="dd-side-nav__head"><span class="dd-side-nav__title">cxkw-prod</span><span class="dd-side-nav__count">3 dbs</span></div>
        <p class="dd-side-nav__section">Databases</p>${db('deploys', true, [sub('deployments', '48.2K', true), sub('builds', '12.9K'), sub('releases', '1.3K')])}${db('auth', false, [sub('sessions', '210K'), sub('users', '2.4K'), sub('api_keys', '86')])}${db('billing', false, [sub('invoices', '9.1K'), sub('customers', '1.8K')])}
        <p class="dd-side-nav__section">Saved queries</p>
        <a class="dd-side-nav__link" href="#">${i('bookmark')}<span class="dd-side-nav__label">Failed in eu-west-2</span></a>
        <a class="dd-side-nav__link" href="#">${i('bookmark')}<span class="dd-side-nav__label">Builds over 5 min</span></a>
        <div class="dd-side-nav__foot">
          <div class="dd-side-nav__note"><span><b>Storage</b> · 1.8 of 5 GB</span><span class="dd-side-nav__meter"><i style="width:36%"></i></span></div>
        </div>
      </div>
    </div>
  </nav>

  <div class="dd-app-shell__main">
    <header class="dd-top-bar">
      <button class="dd-btn dd-btn--ghost dd-btn--icon dd-top-bar__nav-btn" type="button" data-dd-nav-open="#explorer-nav" aria-controls="explorer-nav" aria-expanded="false" aria-label="Open navigation">${i('menu')}</button>
      <a class="dd-top-bar__brand dd-top-bar__narrow" href="#"><span class="dd-logo dd-logo--sm">dawn &amp; dusk</span></a>
      <div class="dd-top-bar__context">
        <button class="dd-top-bar__switch" type="button"><span class="dd-top-bar__mark">cx</span><span>cxkw</span></button>
        <span class="dd-faint">/</span>
        <button class="dd-top-bar__switch" type="button"><span>cxkw-prod</span>${i('sort')}</button>
      </div>
      <button class="dd-top-bar__search" type="button" aria-label="Search">${i('search')}<span>Jump to a collection…</span><kbd class="dd-top-bar__kbd">⌘K</kbd></button>
      <div class="dd-top-bar__actions">
        <details class="dd-top-bar__user" data-dd-autoclose>
          <summary aria-label="Account menu"><span class="dd-top-bar__avatar">cx</span></summary>
          <div class="dd-top-bar__menu">
            <div class="dd-top-bar__menu-head"><b>cxkw</b><span>hello@cxkw.dev</span></div>
            <div class="dd-top-bar__menu-sep"></div>
            <a class="dd-top-bar__menu-item" href="#">${i('key')}Connection strings</a>
            <button class="dd-top-bar__menu-item" type="button" data-dd-theme-toggle>${i('moon')}Toggle dusk</button>
            <a class="dd-top-bar__menu-item" href="#">${i('logout')}Sign out</a>
          </div>
        </details>
      </div>
    </header>

    <main class="dd-app-shell__content">
      <div class="dd-app-shell__page dd-pattern-explorer" data-dd-tabs>
        <header class="dd-page-header">
          <nav class="dd-breadcrumbs dd-breadcrumbs--sm" aria-label="Breadcrumb">
            <ol class="dd-breadcrumbs__list">
              <li class="dd-breadcrumbs__item"><a class="dd-breadcrumbs__link" href="#"><span>cxkw-prod</span></a></li>
              <li class="dd-breadcrumbs__item"><a class="dd-breadcrumbs__link" href="#"><span>deploys</span></a></li>
              <li class="dd-breadcrumbs__item"><a class="dd-breadcrumbs__link" aria-current="page"><span>deployments</span></a></li>
            </ol>
          </nav>
          <div class="dd-page-header__row">
            <div class="dd-page-header__titles"><h1 class="dd-page-header__title">deployments</h1></div>
            <div class="dd-page-header__actions">
              <button class="dd-btn dd-btn--ghost" type="button">${i('download')}<span>Export</span></button>
              <button class="dd-btn dd-btn--secondary" type="button">${i('plus')}<span>Insert document</span></button>
            </div>
          </div>
          <ul class="dd-page-header__meta">
            <li>${i('file')}<b>48,214</b> documents</li>
            <li>${i('database')}<b>61.2 MB</b> · avg <b>1.3 KB</b></li>
            <li>${i('layers')}<b>4</b> indexes</li>
          </ul>
          <div class="dd-tabs__list" role="tablist" aria-label="Collection">
            <button class="dd-tabs__tab" role="tab" type="button" aria-selected="true" aria-controls="explorer-docs"><span>Documents</span><span class="dd-tabs__count">48.2K</span></button>
            <button class="dd-tabs__tab" role="tab" type="button" aria-controls="explorer-indexes"><span>Indexes</span><span class="dd-tabs__count">4</span></button>
            <button class="dd-tabs__tab" role="tab" type="button" aria-controls="explorer-logs"><span>Logs</span></button>
          </div>
        </header>

        <div class="dd-tabs__panel dd-stack" role="tabpanel" id="explorer-docs" style="--dd-gap: calc(var(--dd-u) * 4)">
          <div class="dd-stack" style="--dd-gap: calc(var(--dd-u) * 3)">
            <div class="dd-pattern-explorer__query">
              <div class="dd-input">
                <span class="dd-input__affix">${i('filter')}</span>
                <input class="dd-input__control dd-mono" type="search" aria-label="Query filter" placeholder="{ field: 'value' }" value='{ env: "production", createdAt: { $gte: ISODate("2026-10-30") } }'>
                <span class="dd-input__affix"><button class="dd-input__btn" type="button" data-dd-clear aria-label="Clear filter">${i('x')}</button></span>
              </div>
              <button class="dd-btn dd-btn--primary" type="button">${i('search')}<span>Find</span></button>
            </div>
            <div class="dd-pattern-explorer__query">
              <div class="dd-chip-group" role="group" aria-label="Status">
                ${chip('Ready', true)}
                ${chip('Building', true)}
                ${chip('Failed', true)}
                ${chip('Superseded', false)}
              </div>
              <div class="dd-segmented dd-segmented--sm" data-dd-segmented role="radiogroup" aria-label="View">
                <button class="dd-segmented__item" role="radio" aria-checked="true">${i('list')}<span>Table</span></button>
                <button class="dd-segmented__item" role="radio" aria-checked="false">${i('grid')}<span>Cards</span></button>
                <button class="dd-segmented__item" role="radio" aria-checked="false">${i('code')}<span>JSON</span></button>
              </div>
            </div>
          </div>

          <div class="dd-pattern-explorer__split">
            <div class="dd-data-table dd-data-table--compact" data-dd-data-table style="--dd-data-table-height: 560px">
              <div class="dd-data-table__scroll" tabindex="0" role="region" aria-label="Documents">
                <table class="dd-data-table__table">
                  <thead>
                    <tr>
                      <th class="is-frozen" data-col="id">_id</th>
                      ${sortTh('service', 'service')}
                      ${sortTh('status', 'status')}
                      ${sortTh('createdAt', 'at', 'is-num')}
                    </tr>
                  </thead>
                  <tbody>${rows}
                  </tbody>
                </table>
              </div>
              <div class="dd-data-table__footer">
                <label class="dd-pagination__size">Per page
                  <span class="dd-pagination__select"><select aria-label="Documents per page"><option selected>20</option><option>50</option><option>100</option></select>${i('chevron-down')}</span>
                </label>
                <nav class="dd-pagination dd-pagination--compact" aria-label="Pagination">
                  <span class="dd-pagination__range"><b>1–20</b> of 48,214</span>
                  <button class="dd-pagination__step" type="button" aria-label="Previous page" disabled>${i('chevron-left')}</button>
                  <button class="dd-pagination__step" type="button" aria-label="Next page">${i('chevron-right')}</button>
                </nav>
              </div>
            </div>

            <aside class="dd-pattern-explorer__detail" aria-labelledby="explorer-doc-title">
              <header class="dd-page-header dd-page-header--sm">
                <div class="dd-page-header__row">
                  <div class="dd-page-header__titles">
                    <p class="dd-page-header__eyebrow">Document · 1 of 48,214</p>
                    <h2 class="dd-page-header__title dd-page-header__title--mono" id="explorer-doc-title">dpl_7Hq2xK9m</h2>
                  </div>
                  <div class="dd-page-header__actions">
                    <button class="dd-btn dd-btn--ghost dd-btn--icon dd-btn--sm" type="button" data-dd-copy="dpl_7Hq2xK9m" data-dd-tooltip="Copy _id" aria-label="Copy _id">${i('copy')}</button>
                    <button class="dd-btn dd-btn--ghost dd-btn--icon dd-btn--sm" type="button" data-dd-tooltip="Edit document" aria-label="Edit document">${i('edit')}</button>
                    <button class="dd-btn dd-btn--ghost dd-btn--icon dd-btn--sm" type="button" data-dd-tooltip="Close" aria-label="Close document">${i('x')}</button>
                  </div>
                </div>
                <ul class="dd-page-header__meta">
                  <li><span class="dd-page-header__status"></span>Ready</li>
                  <li>${i('clock')}Updated <b>09:41:07</b></li>
                  <li>${i('file')}<b>1.4 KB</b></li>
                </ul>
              </header>
              <dl class="dd-description-list dd-description-list--card dd-description-list--compact">${[
  fact('Service', '<b>auth-gateway</b>'),
  fact('Region', 'us-east-1 · production'),
  fact('Commit', `<span class="dd-description-list__mono">9f2c41e</span><span class="dd-description-list__muted">Cache JWKS for 10 minutes</span>${copy('9f2c41e7b0d3', 'commit SHA')}`),
  fact('Duration', '<span class="dd-description-list__mono">16.2 s</span><span class="dd-description-list__muted">build 18.2 s</span>'),
  fact('Replicas', '<span class="dd-description-list__status" data-status="warn">2 of 3 ready</span>'),
].join('')}
              </dl>
              <div class="dd-json-viewer" data-dd-json-viewer data-depth="1" aria-label="Document dpl_7Hq2xK9m" style="--dd-json-viewer-height: 360px">
                <script type="application/json">${JSON.stringify(doc, null, 2)}</script>
              </div>
            </aside>
          </div>
        </div>

        <div class="dd-tabs__panel" role="tabpanel" id="explorer-indexes" hidden>
          <div class="dd-table dd-table--mono">
            <table>
              <thead><tr><th>Name</th><th>Keys</th><th>Type</th><th class="is-num">Size</th><th class="is-num">Ops / day</th></tr></thead>
              <tbody>${indexes.map(([name, keys, type, size, ops]) => `
                <tr><td class="is-mono">${name}</td><td class="is-mono is-muted">${keys}</td><td>${type}</td><td class="is-num">${size}</td><td class="is-num">${ops}</td></tr>`).join('')}
              </tbody>
            </table>
          </div>
        </div>

        <div class="dd-tabs__panel" role="tabpanel" id="explorer-logs" hidden>
          <div class="dd-log-viewer" data-dd-log-viewer style="--dd-log-viewer-height: 420px">
            <div class="dd-log-viewer__bar">
              <span class="dd-log-viewer__live">Live</span>
              <label class="dd-log-viewer__search">${i('search')}<input type="search" placeholder="Search logs" aria-label="Search logs" data-dd-log-viewer-search></label>
              <div class="dd-log-viewer__levels" role="group" aria-label="Levels">
                ${['debug', 'info', 'warn', 'error'].map(levelBtn).join('\n                ')}
              </div>
              <button class="dd-log-viewer__toggle dd-log-viewer__toggle--wrap" type="button" data-dd-log-viewer-wrap aria-pressed="false">${i('menu')}Wrap</button>
              <span class="dd-log-viewer__count" data-dd-log-viewer-count aria-live="polite">${LOGS.length} lines</span>
            </div>
            <div class="dd-log-viewer__scroll" tabindex="0" role="region" aria-label="cxkw-prod logs for deploys.deployments">
              <ol class="dd-log-viewer__lines" role="log">
${logLines}
              </ol>
              <p class="dd-log-viewer__empty" data-dd-log-viewer-empty hidden><b>No lines match <span data-dd-log-viewer-query></span></b>Try another search, or <button class="dd-btn dd-btn--link" type="button" data-dd-log-viewer-clear><span>clear filters</span></button></p>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>`;
---
<Docs title="Data explorer" group="Patterns" lead="A Compass-style explorer for the cxkw-prod cluster: query a collection, scan the results in a dense table, read one document beside it, and tail the logs — without leaving the page." wide>
  <p>Built only from existing components and their documented markup. The query bar sits over a split view: results on the left, the open document on the right as facts plus the raw JSON. Indexes and logs are tabs of the same view. The nav starts folded so the data gets the room; the chevron at the foot of the rail opens the collections tree. Layout glue is the <code>&lt;style&gt;</code> at the top of the snippet.</p>

  <Example
    title="Collection explorer"
    description="Try it: edit the query, toggle the status chips, sort the results, expand nodes in the JSON, switch to Logs and filter by level, or unfold the nav to browse collections."
    code={page}
    stage="flush"
  />

  <h2 id="anatomy">Anatomy</h2>
  <ol>
    <li><strong>App shell</strong> — rail with the collections tree in the panel (databases as <code>__group</code>s, collections as links with document counts). Folded by default on data-heavy views.</li>
    <li><strong>Page header</strong> — breadcrumbs (cluster / database / collection), the collection as the title, size facts in mono, and tabs that switch the view below.</li>
    <li><strong>Query bar</strong> — a mono filter input with the one primary action (Find), status filter chips, and a segmented switch for the result view.</li>
    <li><strong>Split view</strong> — a compact data table with a frozen <code>_id</code> column and pagination; the open document beside it: a small page header, a description list of the facts that matter and a JSON viewer for the rest. The two sit side by side from 680px of page width and stack below.</li>
    <li><strong>Indexes / Logs</strong> — a quiet table of indexes and a live log viewer, as tab panels.</li>
  </ol>

  <h2 id="uses">What it uses</h2>
  <ul>
    <li><a href="../components/app-shell">App shell</a>, <a href="../components/side-nav">Side nav</a> (collapsed, with groups), <a href="../components/top-bar">Top bar</a></li>
    <li><a href="../components/page-header">Page header</a>, <a href="../components/breadcrumbs">Breadcrumbs</a>, <a href="../components/tabs">Tabs</a></li>
    <li><a href="../components/text-input">Text input</a>, <a href="../components/button">Button</a>, <a href="../components/chip">Chip</a> (filter), <a href="../components/segmented-control">Segmented control</a></li>
    <li><a href="../components/data-table">Data table</a>, <a href="../components/pagination">Pagination</a></li>
    <li><a href="../components/description-list">Description list</a>, <a href="../components/json-viewer">JSON viewer</a>, <a href="../components/tooltip">Tooltip</a></li>
    <li><a href="../components/table">Table</a>, <a href="../components/log-viewer">Log viewer</a></li>
  </ul>

  <h2 id="guidelines">Guidelines</h2>
  <Guides
    do={[
      'Make Find the one primary action; header actions stay secondary or ghost.',
      'Show IDs, queries, sizes and timestamps in mono; right-align durations and counts.',
      'Mark the open row (<code>.is-selected</code>) so the table and the detail panel read as one.',
      'Lead the detail with the five or six facts people look for, then the raw JSON.',
    ]}
    dont={[
      'Don’t open the document in a modal; the table is the context, keep it in view.',
      'Don’t put the JSON viewer or description list on another surface — they bring their own.',
      'Don’t paginate without saying the range and the total.',
    ]}
  />
</Docs>
