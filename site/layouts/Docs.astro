---
// Docs page shell, built on the system's own app shell in page-scroll mode (the document scrolls; the side nav and the
// top bar stick): the side nav (icon rail + page panel) runs the full height on the left, the top bar and the page share
// the rest, and under 900px the nav goes off-canvas. Every page uses the design system itself.
import '../../ds/dawn-and-dusk.css';
import '../styles/docs.css';
import DocsNav from '../components/DocsNav.astro';
import { i } from '../lib/icon';
import { base, hrefOf, locate, sections } from '../lib/nav';
import { dawn, dusk } from '../lib/tokens';
import { version } from '../lib/distribution';
import sprite from '../../ds/icons/icons.svg?raw';

interface Props {
  title: string;
  /** The eyebrow above the title. */
  group?: string;
  /** The intro paragraph; also the page's description for search and social cards. */
  lead?: string;
  /** A wider content column, for pages built around big examples. */
  wide?: boolean;
}
const { title, group, lead, wide = false } = Astro.props;
const here = Astro.url.pathname.replace(/\/$/, '');
const isHome = here === base;
const isNotFound = /^\/404(\.html)?$/.test(here.slice(base.length));

// Where the page sits in the nav: the rail section it opens on, and its breadcrumb.
const { section, item } = locate(here);
const active = (section ?? sections[0]).key;
const sectionHome = section ? hrefOf(section.groups[0].items[0].href) || `${base}/` : null;
const pageTitle = item?.title ?? title;

// Head: title, description, and the social card (Open Graph / Twitter) with absolute URLs built from `site` + base.
const docTitle = isHome ? 'dawn & dusk — the cxkw.dev design system' : `${title} · dawn & dusk`;
const description = lead ?? 'Warm greige neutrals, golden-hour colour and a heavy lowercase voice, in a light dawn and a dark dusk. Plain CSS, a little JavaScript, and an agent skill so AI builds it right.';
const absolute = (path: string) => new URL(path, Astro.site ?? Astro.url).href;
const canonical = absolute(`${here}/`);
const ogImage = absolute(`${base}/og.png`);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{docTitle}</title>
    <meta name="description" content={description} />
    {isNotFound ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <meta name="theme-color" content={dawn.bg} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={dusk.bg} media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="dawn & dusk" />
    <meta property="og:title" content={docTitle} />
    <meta property="og:description" content={description} />
    {!isNotFound && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="dawn & dusk — a design system split diagonally between a light dawn and a dark dusk" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Apply the stored (or ?theme=) choice before paint to avoid a flash.
      (() => {
        const valid = (v) => v === 'dawn' || v === 'dusk';
        const q = new URLSearchParams(location.search).get('theme');
        let t = valid(q) ? q : null;
        if (!t) { try { t = localStorage.getItem('dd-theme'); } catch { t = null; } }
        if (valid(t)) document.documentElement.dataset.theme = t;
        // a valid ?theme= link is a choice too: store it so the theme script doesn't swap back to an older one
        if (valid(q)) { try { localStorage.setItem('dd-theme', q); } catch { /* storage unavailable */ } }
      })();
    </script>
  </head>
  <body>
    <Fragment set:html={sprite} />
    <a class="doc-skip" href="#content">Skip to content</a>
    <div class="dd-app-shell dd-app-shell--page dd-app-shell--offcanvas-md doc-app">
      <DocsNav active={active} here={here} />
      <script is:inline>
        // Before paint: the side nav's own state, so nothing jumps or animates on load. (Under 900px the shell puts it
        // off-canvas by itself: dd-app-shell--offcanvas-md.)
        // - The fold is remembered by side-nav.js under "dd-side-nav:doc-nav"; apply it now rather than after the scripts.
        // - The panel keeps its scroll position per section between pages (saved by site/scripts/docs.js under
        //   "dd-docs-nav"), and the current page is always in view.
        (() => {
          const nav = document.getElementById('doc-nav');
          const list = document.getElementById('doc-nav-list');
          nav.classList.add('is-restoring');
          let folded = null;
          try { folded = localStorage.getItem('dd-side-nav:doc-nav'); } catch { /* storage unavailable */ }
          if (folded === 'collapsed') {
            nav.classList.add('is-collapsed');
            const t = nav.querySelector('[data-dd-nav-toggle]');
            t.setAttribute('aria-expanded', 'false'); t.setAttribute('aria-label', 'Expand navigation'); t.setAttribute('data-label', 'Expand');
          }
          requestAnimationFrame(() => requestAnimationFrame(() => nav.classList.remove('is-restoring')));
          const pane = nav.querySelector('.dd-side-nav__pane:not([hidden])');
          let memo = {};
          try { memo = JSON.parse(sessionStorage.getItem('dd-docs-nav') || '{}') || {}; } catch { memo = {}; }
          if (pane && typeof memo[pane.dataset.ddNavPane] === 'number') list.scrollTop = memo[pane.dataset.ddNavPane];
          const cur = pane && pane.querySelector('[aria-current="page"]');
          if (cur) {
            const s = list.getBoundingClientRect(), c = cur.getBoundingClientRect();
            if (c.top < s.top + 40 || c.bottom > s.bottom - 60) list.scrollTop += c.top - s.top - s.height / 3;
          }
        })();
      </script>
      <div class="dd-app-shell__main">
        <header class="dd-top-bar doc-bar">
          <button class="dd-btn dd-btn--ghost dd-btn--icon dd-top-bar__nav-btn" type="button" data-dd-nav-open="#doc-nav" aria-controls="doc-nav" aria-expanded="false" aria-label="Open navigation"><Fragment set:html={i('menu')} /></button>
          <a class="dd-top-bar__brand dd-top-bar__narrow" href={`${base}/`}><span class="dd-logo dd-logo--sm">dawn &amp; dusk</span></a>
          <div class="dd-top-bar__context">
            <nav class="dd-breadcrumbs dd-breadcrumbs--sm" aria-label="Breadcrumb">
              <ol class="dd-breadcrumbs__list">
                {section && sectionHome && (
                  <li class="dd-breadcrumbs__item"><a class="dd-breadcrumbs__link" href={sectionHome}><span>{section.label}</span></a></li>
                )}
                <li class="dd-breadcrumbs__item"><a class="dd-breadcrumbs__link" aria-current="page"><span>{pageTitle}</span></a></li>
              </ol>
            </nav>
          </div>
          <div class="dd-top-bar__actions">
            <span class="doc-ver dd-mono dd-top-bar__wide">v{version}</span>
            <a class="dd-btn dd-btn--ghost dd-btn--icon" href="https://github.com/cxkw-dev/dawn-and-dusk" aria-label="GitHub"><Fragment set:html={i('code')} /></a>
            <button class="dd-btn dd-btn--secondary dd-btn--sm doc-theme" type="button" data-dd-theme-toggle aria-label="Toggle dawn / dusk">
              <svg class="dd-icon doc-theme-dawn" aria-hidden="true"><use href="#dd-i-sun" /></svg><svg class="dd-icon doc-theme-dusk" aria-hidden="true"><use href="#dd-i-moon" /></svg><span class="doc-theme-dawn">dawn</span><span class="doc-theme-dusk">dusk</span>
            </button>
          </div>
        </header>
        <main id="content" class="dd-app-shell__content doc-content">
          <div class:list={['doc-body has-toc', { 'is-wide': wide }]}>
            <article class="doc-main">
              <header class="doc-head">
                {group && <p class="dd-eyebrow">{group}</p>}
                <h1 class="dd-h1">{title}</h1>
                {lead && <p class="dd-lead">{lead}</p>}
              </header>
              <slot />
            </article>
            <nav class="doc-toc dd-scroll" aria-label="On this page" hidden><p class="doc-toc-h">On this page</p><ul></ul></nav>
          </div>
        </main>
      </div>
    </div>
    <script>
      import '../../ds/dawn-and-dusk.js';
      import '../scripts/docs.js';
    </script>
  </body>
</html>
